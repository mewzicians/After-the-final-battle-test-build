    goblinSwordsman: { name: "a goblin swordsman", symbol: "s", hp: 28, attackDamage: 5, enemyTickGain: 3, loot: { scrapIronPieces: 2, gold: 3 }, descriptions: { idle: "a goblin swordsman draws a chipped blade.", low: "the swordsman tests the edge.", mid: "the blade pulls back.", high: "the point comes forward.", attack: "the swordsman thrusts.", parried: "the old sword turns the point.", dodged: "the thrust cuts cold air.", hit: "the chipped blade bites." } },
    goblinChief: { name: "the goblin chief", symbol: "G", hp: 50, attackDamage: 7, enemyTickGain: 3, loot: { goblinChiefSpear: 1, gold: 8 }, descriptions: { idle: "the goblin chief rises behind a table made from stolen doors.", low: "the chief plants one foot.", mid: "the spear draws back.", high: "the spear is about to move.", attack: "the chief drives the spear forward.", parried: "the old sword catches the spearhead.", dodged: "the spear tears through a chair.", hit: "the spear lands." } }
  };

  Object.assign(setup.enemies, {
    wanderingDemon: { name: "a wandering demon", symbol: "D", hp: 38, attackDamage: 6, enemyTickGain: 3, loot: { medicine: 1, gold: 5 }, descriptions: { idle: "a demon walks out of the snow as if it has somewhere to be.", low: "the demon watches your hands.", mid: "black fire gathers around one arm.", high: "the fire leans toward you.", attack: "the demon strikes.", parried: "the old sword breaks the fire apart.", dodged: "the fire burns a hole in the snow.", hit: "the fire finds you." } },
