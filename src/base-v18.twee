    demonHound: { name: "a demon hound", symbol: "H", hp: 34, attackDamage: 6, enemyTickGain: 4, loot: { medicine: 1, gold: 4 }, descriptions: { idle: "a demon hound crawls out of the dark.", low: "the hound sniffs the air.", mid: "its shoulders bunch.", high: "it is about to pounce.", attack: "the hound pounces.", parried: "the old sword holds it back.", dodged: "the hound tears through empty air.", hit: "claws rake across you." } },
    academyEcho: { name: "an academy echo", symbol: "E", hp: 40, attackDamage: 6, enemyTickGain: 3, loot: { moonCharms: 1, gold: 5 }, descriptions: { idle: "an academy echo stands where a student should be.", low: "it takes a training stance.", mid: "it repeats a lesson nobody finished.", high: "the lesson becomes a strike.", attack: "the echo attacks.", parried: "you remember this one.", dodged: "the lesson misses.", hit: "old training still hurts." } },
