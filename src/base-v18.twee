    frostBear: { name: "the hollow white bear", symbol: "B", hp: 70, attackDamage: 8, enemyTickGain: 2, loot: { frostBearClaw: 1, gold: 10 }, descriptions: { idle: "the hollow white bear rises.", low: "it breathes cold.", mid: "it stands taller than it should.", high: "it is about to crush you.", attack: "the bear crushes down.", parried: "the old sword barely holds.", dodged: "the floor cracks instead.", hit: "the weight lands." } },
    goblinArcher: { name: "a goblin archer", symbol: "a", hp: 20, attackDamage: 3, enemyTickGain: 3, loot: { scrapIronPieces: 1, gold: 2 }, descriptions: { idle: "a goblin archer steps between the tents.", low: "the archer reaches for an arrow.", mid: "the bow bends.", high: "the string is about to loose.", attack: "the archer fires.", parried: "the old sword knocks the arrow aside.", dodged: "the arrow finds dirt.", hit: "the arrow finds you." } },
