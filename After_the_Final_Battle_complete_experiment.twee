      name: "medium attack",
      chargeRequired: 10,
      damageMultiplier: 1,
      weight: 1
    },
    heavy: {
      key: "heavy",
      name: "heavy attack",
      chargeRequired: 20,
      damageMultiplier: 2,
      weight: 1
    }
  };

