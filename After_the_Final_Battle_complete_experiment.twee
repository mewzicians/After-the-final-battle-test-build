      stats: "Weapon. Cannot replace the Old Sword."
    },
    oldSword: {
      name: "old sword",
      kind: "weapon",
      action: "equip",
      description: "Rust crawls along the blade, and the leather around the handle is almost gone. It has survived longer than most people, which does not make it good.",
      stats: "Locked weapon. Base damage 3."
    }
  };

  function inventoryEntries() {
    ensureState();

    var v = State.variables;
    var entries = [];

    Object.keys(setup.resourceCatalog).forEach(function (key) {
      var def = setup.resourceCatalog[key];
      entries.push({
        key: key,
        name: def.name,
        description: def.description,
        count: v.inventory[key] || 0,
        action: null,
        stats: ""
      });
    });

    Object.keys(setup.inventoryCatalog).forEach(function (key) {
      var def = setup.inventoryCatalog[key];
      var count = v.inventory[key] || 0;
      if (count > 0) {
        entries.push({
          key: key,
          name: def.name,
          description: def.description,
          count: count,
          action: def.action || null,
          stats: def.stats || ""
        });
      }
    });

    return entries;
  }

  function equipmentEntries() {
    return inventoryEntries().filter(function (entry) {
      var def = setup.inventoryCatalog[entry.key];
      return def && (def.kind === "armor" || def.kind === "weapon");
    });
  }

  function selectedInventoryEntry(entries) {
    for (var i = 0; i < entries.length; i += 1) {
      if (entries[i].key === setup.selectedInventoryKey) return entries[i];
    }
    return entries[0] || null;
  }

  setup.closeInventory = function () {
    var backdrop = document.querySelector("#inventory-backdrop");
    var toggle = document.querySelector("#inventory-toggle");
    if (backdrop) {
      backdrop.classList.remove("open");
      backdrop.setAttribute("aria-hidden", "true");
    }
    if (toggle) toggle.setAttribute("aria-expanded", "false");
  };

  setup.showInventoryTab = function (tabName) {
    setup.inventoryTab = tabName === "equipment" ? "equipment" : "inventory";
    var inventoryTab = document.querySelector("#inventory-tab");
    var equipmentTab = document.querySelector("#equipment-tab");
    var inventoryView = document.querySelector("#inventory-view");
    var equipmentView = document.querySelector("#equipment-view");
    if (inventoryTab) inventoryTab.classList.toggle("active", setup.inventoryTab === "inventory");
    if (equipmentTab) equipmentTab.classList.toggle("active", setup.inventoryTab === "equipment");
    if (inventoryView) inventoryView.classList.toggle("active", setup.inventoryTab === "inventory");
    if (equipmentView) equipmentView.classList.toggle("active", setup.inventoryTab === "equipment");
    setup.updateInventory();
  };

  setup.toggleInventory = function () {
    createInterface();
    var backdrop = document.querySelector("#inventory-backdrop");
    var toggle = document.querySelector("#inventory-toggle");
    if (!backdrop) return;

    var opening = !backdrop.classList.contains("open");
    if (opening) {
      backdrop.classList.add("open");
      backdrop.setAttribute("aria-hidden", "false");
      if (toggle) toggle.setAttribute("aria-expanded", "true");
      setup.showInventoryTab(setup.inventoryTab || "inventory");
      setup.updateInventory();
    } else {
      setup.closeInventory();
    }
  };

  setup.selectInventoryItem = function (key) {
    setup.selectedInventoryKey = key;
    setup.updateInventory();
  };

  setup.selectEquipmentItem = function (key) {
    setup.selectedEquipmentKey = key;
    setup.updateInventory();
  };

  setup.consumeSupply = function (key, options) {
    ensureState();
    options = options || {};
    var v = State.variables;
    var def = setup.inventoryCatalog[key];
    if (!def || def.kind !== "supply" || v.inventory[key] <= 0) return false;

    v.inventory[key] -= 1;
    v.inventory[def.resource] += def.value;
    v.resourceWarnings[def.resource + "AcknowledgedAt"] = null;
    notify(
      "consumed " + def.name + ". " + def.value + " " + def.resource.replace("Iron", " iron") + " gained",
      { duration: ITEM_NOTIFICATION_MS }
    );
    setup.updateInventory();
    if (options.closeModal) {
      var modal = document.querySelector("#resource-warning-modal");
      if (modal) modal.remove();
    }
    return true;
  };

  setup.useInventoryItem = function (key) {
    ensureState();

    var v = State.variables;
    var def = setup.inventoryCatalog[key];
    if (def && def.kind === "supply") return setup.consumeSupply(key);
    if (key !== "medicine" || v.inventory.medicine <= 0) return false;

    if (v.player.hp >= v.player.maxHp) {
      notify("you are already at full health");
      return false;
    }

    var healed = Math.min(10, v.player.maxHp - v.player.hp);
    v.inventory.medicine -= 1;
    v.player.hp += healed;
    notify("medicine used. " + healed + " health restored", { duration: ITEM_NOTIFICATION_MS });
    setup.updateInventory();
    return true;
  };

  setup.activateInventoryItem = function (key) {
    var def = setup.inventoryCatalog[key];
    if (!def) return false;
    if (def.action === "use") return setup.useInventoryItem(key);
    if (def.action === "equip") return setup.equipInventoryItem(key);
    return false;
  };

  setup.syncEquipmentStats = function () {
    if (!State || !State.variables) return;
    var v = State.variables;
    if (!v.equipment) return;
    var body = setup.inventoryCatalog && setup.inventoryCatalog[v.equipment.body];
    v.armor = body
      ? { name: body.name, resistance: body.resistance || body.defense || 0 }
      : { name: "none", resistance: 0 };
    if (v.hasSword || v.equipment.oldSword === "oldSword") {
      v.hasSword = true;
      v.equipment.oldSword = "oldSword";
      v.weapon = { name: "old sword", level: (v.weapon && v.weapon.level) || 0, baseDamage: 3 };
    }
  };

  setup.shakeGame = function () {
    if (!setup.getPreferences().screenShake) return;
    var target = document.querySelector("#story") || document.body;
    target.classList.remove("lore-shake");
    void target.offsetWidth;
    target.classList.add("lore-shake");
    setTimeout(function () {
      target.classList.remove("lore-shake");
    }, 420);
  };

  setup.equipInventoryItem = function (key) {
    ensureState();
    var v = State.variables;
    var def = setup.inventoryCatalog[key];
    if (!def || v.inventory[key] <= 0) return false;

    if (def.kind === "weapon") {
      setup.shakeGame();
      notify(WEAPON_REJECTION, { duration: ITEM_NOTIFICATION_MS });
      return false;
    }

    if (def.kind !== "armor" || !def.slot) return false;
    var oldKey = v.equipment[def.slot];
    if (oldKey === key) return true;
    v.inventory[key] -= 1;
    if (oldKey) v.inventory[oldKey] = (v.inventory[oldKey] || 0) + 1;
    v.equipment[def.slot] = key;
    setup.syncEquipmentStats();
    notify(def.name + " equipped");
    setup.updateInventory();
    return true;
  };

  setup.updateInventory = function () {
    ensureState();
    createInterface();

    var list = document.querySelector("#inventory-list");
    if (!list) return;

    var entries = inventoryEntries();
    var selected = selectedInventoryEntry(entries);
    setup.selectedInventoryKey = selected ? selected.key : null;
    list.innerHTML = "";

    entries.forEach(function (entry) {
      var button = document.createElement("button");
      button.type = "button";
      button.className = "inventory-item";
      if (selected && entry.key === selected.key) button.classList.add("selected");
      button.textContent = entry.name + (entry.count === null ? "" : "  " + entry.count);
      button.addEventListener("click", function () {
        setup.selectInventoryItem(entry.key);
      });
      list.appendChild(button);
    });

    var resources = document.querySelector("#inventory-resources");
    var name = document.querySelector("#inventory-detail-name");
    var description = document.querySelector("#inventory-detail-description");
    var stats = document.querySelector("#inventory-detail-stats");
    var quantity = document.querySelector("#inventory-detail-quantity");
    var useButton = document.querySelector("#inventory-use");

    if (resources) {
      resources.textContent =
        "gold: " + State.variables.inventory.gold +
        " | food: " + State.variables.inventory.food +
        " | water: " + State.variables.inventory.water;
    }

    setup.renderCharacterStats();

    if (!selected) {
      if (name) name.textContent = "nothing";
      if (description) description.textContent = "There is nothing here.";
      if (stats) stats.textContent = "";
      if (quantity) quantity.textContent = "";
      if (useButton) useButton.style.display = "none";
      return;
    }

    if (name) name.textContent = selected.name;
    if (description) description.textContent = selected.description;
    if (stats) stats.textContent = selected.stats || "";
    if (quantity) {
      quantity.textContent = selected.count === null ? "" : "quantity: " + selected.count;
    }
    if (useButton) {
      useButton.style.display = selected.action ? "inline-flex" : "none";
      useButton.textContent = selected.action === "equip" ? "Equip" : "Use";
    }

    var equipList = document.querySelector("#equipment-list");
    if (equipList) {
      var equipEntries = equipmentEntries();
      var equipSelected = selectedInventoryEntry.call(null, equipEntries);
      if (
        !setup.selectedEquipmentKey ||
        !equipEntries.some(function (entry) { return entry.key === setup.selectedEquipmentKey; })
      ) {
        setup.selectedEquipmentKey = equipEntries.length ? equipEntries[0].key : null;
      }
      equipSelected = equipEntries.find(function (entry) {
        return entry.key === setup.selectedEquipmentKey;
      }) || null;
      equipList.innerHTML = "";
      equipEntries.forEach(function (entry) {
        var equipButton = document.createElement("button");
        equipButton.type = "button";
        equipButton.className = "inventory-item";
        if (equipSelected && equipSelected.key === entry.key) equipButton.classList.add("selected");
        equipButton.textContent = entry.name + "  " + entry.count;
        equipButton.addEventListener("click", function () {
          setup.selectEquipmentItem(entry.key);
        });
        equipList.appendChild(equipButton);
      });

      var equipName = document.querySelector("#equipment-detail-name");
      var equipDescription = document.querySelector("#equipment-detail-description");
      var equipStats = document.querySelector("#equipment-detail-stats");
      var equipAction = document.querySelector("#equipment-action");
      if (equipName) equipName.textContent = equipSelected ? equipSelected.name : "nothing";
      if (equipDescription) {
        equipDescription.textContent = equipSelected ? equipSelected.description : "No equipment items carried.";
      }
      if (equipStats) equipStats.textContent = equipSelected ? equipSelected.stats : "";
      if (equipAction) {
        equipAction.style.display = equipSelected ? "inline-flex" : "none";
        equipAction.textContent = "Equip";
      }
    }

    setup.renderEquipmentSlots();
  };

  setup.renderEquipmentSlots = function () {
    var root = document.querySelector("#equipment-slots");
    if (!root) return;
    var v = State.variables;
    var slots = [
      ["head", "Head"],
      ["body", "Body"],
      ["feet", "Feet"],
      ["ring", "Ring"],
      ["oldSword", "Old Sword"]
    ];
    root.innerHTML = "";
    slots.forEach(function (pair) {
      var key = v.equipment[pair[0]];
      var def = key ? setup.inventoryCatalog[key] : null;
      var row = document.createElement("div");
      row.className = "equipment-slot";
      if (pair[0] === "oldSword") row.classList.add("locked");
      row.innerHTML =
        '<span class="equipment-slot-label">' + pair[1] + '</span>' +
        '<span class="equipment-slot-value">' +
        escapeHtml(def ? def.name : "Empty") +
        (pair[0] === "oldSword" ? " · Locked" : "") +
        "</span>";
      root.appendChild(row);
    });
  };

  setup.renderCharacterStats = function () {
    var root = document.querySelector("#character-stats");
    if (!root) return;
    ensureState();
    var v = State.variables;
    var definitions = [
      { key: "strength", label: "Strength", effect: function () {
        return "+" + Math.max(0, v.stats.strength.level - 1) + " attack damage | " +
          (attackCooldownMs() / 1000).toFixed(2) + "s Attack";
      } },
      { key: "agility", label: "Agility", effect: function () {
        return (dodgeCooldownMs() / 1000).toFixed(2) + "s Dodge";
      } },
      { key: "defense", label: "Defense", effect: function () {
        return (parryCooldownMs() / 1000).toFixed(2) + "s Parry";
      } },
      { key: "resistance", label: "Resistance", effect: function () {
        var reduction = Math.floor(Math.max(0, v.stats.resistance.level - 1) / 3);
        return reduction ? "-" + reduction + " incoming damage" : "0 damage reduction";
      } }
    ];
    root.innerHTML = definitions.map(function (definition) {
      var stat = v.stats[definition.key];
      var progress = stat.level >= STAT_LEVEL_CAP
        ? "MAX"
        : stat.exp + " / " + stat.next + " story EXP";
      return '<div class="character-stat">' +
        '<div class="character-stat-name"><span>' + definition.label + '</span><span>Lv ' + stat.level + '</span></div>' +
        '<div class="character-stat-progress">' + progress + '</div>' +
        '<div class="character-stat-effect">' + definition.effect() + '</div>' +
        '</div>';
    }).join("");
  };

  setup.updateInterfaceAvailability = function () {
    var controls = document.querySelector("#bottom-controls");
    var saveButton = document.querySelector("#save-toggle");
    var onWelcome = State.passage === "Welcome";
    if (controls) controls.style.display = onWelcome ? "none" : "flex";
    if (saveButton) saveButton.disabled = !setup.canSave();
    document.body.classList.toggle("welcome-screen", onWelcome);
  };

  setup.items = {
    staleBread: { name: "stale bread", catalogKey: "staleBread" },
    sealedFoodTin: { name: "sealed food tin", catalogKey: "sealedFoodTin" },
    winterRoot: { name: "winter root", catalogKey: "winterRoot" },
    settlementBread: { name: "settlement bread", catalogKey: "settlementBread" },
    waterskin: { name: "old waterskin", catalogKey: "waterskin" },
    snowmeltFlask: { name: "snowmelt flask", catalogKey: "snowmeltFlask" },
    riverJar: { name: "river jar", catalogKey: "riverJar" },
    scrapIron: { name: "scrap iron piece", catalogKey: "scrapIronPieces" },
    bentArrowheads: { name: "bent arrowheads", catalogKey: "bentArrowheads" },
    crackedMoonCharm: { name: "cracked Moon charm", resource: "moonCharms", value: 1 },
    charm: { name: "cracked Moon charm", resource: "moonCharms", value: 1 },
    moonCharm: { name: "cracked Moon charm", resource: "moonCharms", value: 1 },
    medicinePouch: { name: "medicine pouch", catalogKey: "medicine" },
    tulip: { name: "tulip", catalogKey: "tulip" },
    silentBell: { name: "silent bell", catalogKey: "silentBell" },
    whiteAntler: { name: "white antler", catalogKey: "whiteAntler" },
    frostBearClaw: { name: "frost bear claw", catalogKey: "frostBearClaw" },
    goblinChiefSpear: { name: "Goblin Chief's Spear", catalogKey: "goblinChiefSpear" },
    northernFieldWrap: { name: "northern field wrap", catalogKey: "northernFieldWrap" },
    watchmanCoat: { name: "watchman's coat", catalogKey: "watchmanCoat" },
    oldMail: { name: "old mail shirt", catalogKey: "oldMail" },
    hunterKnife: { name: "hunter's knife", catalogKey: "hunterKnife" },
    gateSword: { name: "academy practice blade", catalogKey: "gateSword" }
  };

  function applyItem(itemKey) {
    ensureState();

    var v = State.variables;
    var item = setup.items[itemKey];
    if (!item) return false;

    if (item.resource) {
      v.inventory[item.resource] += item.value || 1;
    } else {
      var field = item.catalogKey || itemKey;
      if (typeof v.inventory[field] !== "number") v.inventory[field] = 0;
      v.inventory[field] += item.value || 1;
    }

    return true;
  }

  setup.takeItem = function (itemKey, options) {
    ensureState();

    if (typeof options === "string") {
      options = { flag: options };
    }

    options = options || {};
    var flag = options.flag || null;
    var item = setup.items[itemKey];

    if (!item) {
      notify("missing item: " + itemKey);
      return false;
    }

    if (flag && State.variables.taken[flag]) {
      if (options.returnPassage) play(options.returnPassage);
      return false;
    }

    applyItem(itemKey);
    if (flag) State.variables.taken[flag] = true;

    setup.updateInventory();
    if (options.message !== false) {
      notify(options.message || item.name + " taken", { duration: ITEM_NOTIFICATION_MS });
    }
    if (options.returnPassage) play(options.returnPassage);

    return true;
  };

  setup.take = setup.takeItem;
  setup.takeInventoryItem = setup.takeItem;

  setup.receiveLoot = function (loot, options) {
    ensureState();

    options = options || {};
    if (!loot) return false;

    if (typeof loot === "string") {
      setup.takeItem(loot, { message: options.message });
      return true;
    }

    if (Array.isArray(loot)) {
      loot.forEach(function (entry) {
        setup.receiveLoot(entry, { message: false });
      });
      setup.updateInventory();
      if (options.message !== false) {
        notify(options.message || "loot taken", { duration: ITEM_NOTIFICATION_MS });
      }
      return true;
    }

    Object.keys(loot).forEach(function (key) {
      if (setup.items[key]) {
        var amount = loot[key];
        for (var i = 0; i < amount; i++) applyItem(key);
      } else {
        if (typeof State.variables.inventory[key] !== "number") State.variables.inventory[key] = 0;
        State.variables.inventory[key] += loot[key];
      }
    });

    setup.updateInventory();
    if (options.message !== false) {
      notify(options.message || "loot taken", { duration: ITEM_NOTIFICATION_MS });
    }
    return true;
  };

  function normalizedLoot(loot) {
    var totals = {};
    if (!loot) return [];
    if (typeof loot === "string") {
      totals[loot] = 1;
    } else if (Array.isArray(loot)) {
      loot.forEach(function (entry) {
        normalizedLoot(entry).forEach(function (part) {
          totals[part.key] = (totals[part.key] || 0) + part.amount;
        });
      });
    } else {
      Object.keys(loot).forEach(function (key) {
        totals[key] = (totals[key] || 0) + Math.max(0, Number(loot[key]) || 0);
      });
    }
    return Object.keys(totals).filter(function (key) {
      return totals[key] > 0;
    }).map(function (key) {
      return { key: key, amount: totals[key] };
    });
  }

  function lootDefinition(key) {
    if (setup.resourceCatalog[key]) return setup.resourceCatalog[key];
    if (setup.inventoryCatalog[key]) return setup.inventoryCatalog[key];
    var item = setup.items[key];
    if (item) {
      if (item.catalogKey && setup.inventoryCatalog[item.catalogKey]) {
        return setup.inventoryCatalog[item.catalogKey];
      }
      if (item.resource && setup.resourceCatalog[item.resource]) {
        return setup.resourceCatalog[item.resource];
      }
      return item;
    }
    return { name: key, description: "You do not know exactly what it is for yet. Useful will have to be enough." };
  }

  function lootRowsHtml(loot) {
    return normalizedLoot(loot).map(function (entry, index) {
      var def = lootDefinition(entry.key);
      return '<button type="button" class="reward-loot-row" data-loot-index="' + index + '">' +
        '<span>' + escapeHtml(def.name || entry.key) + '</span><span>×' + entry.amount + "</span></button>";
    }).join("");
  }

  function wireLootDetails(root, loot, detailSelector) {
    var entries = normalizedLoot(loot);
    var detail = root.querySelector(detailSelector);
    Array.from(root.querySelectorAll(".reward-loot-row")).forEach(function (row) {
      var show = function () {
        var entry = entries[Number(row.getAttribute("data-loot-index")) || 0];
        var def = lootDefinition(entry.key);
        if (detail) {
          detail.textContent = (def.description || "") + (def.stats ? " " + def.stats : "");
        }
      };
      row.addEventListener("mouseenter", show);
      row.addEventListener("focus", show);
      row.addEventListener("click", show);
    });
  }

  setup.openLootPopup = function (options) {
    ensureState();
    options = options || {};
    var loot = options.loot || {};
    State.variables.pendingReward = {
      kind: "loot",
      title: options.title || "Found",
      flavor: options.flavor || "It is still useful, which is enough reason to carry it.",
      loot: clone(loot),
      action: options.action || null
    };
    setup.closeInventory();

    var old = document.querySelector("#reward-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "reward-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box reward-box" role="dialog" aria-modal="true" aria-label="Loot found">
        <div class="modal-title">${escapeHtml(State.variables.pendingReward.title)}</div>
        <div class="modal-text reward-flavor">${escapeHtml(State.variables.pendingReward.flavor)}</div>
        <div class="reward-loot-list">${lootRowsHtml(loot)}</div>
        <div class="reward-detail" aria-live="polite">Hover over or tap an item to inspect it.</div>
        <div class="modal-actions"><button class="modal-button" id="reward-take">Take</button></div>
      </div>
    `;
    document.body.appendChild(backdrop);
    wireLootDetails(backdrop, loot, ".reward-detail");
    document.querySelector("#reward-take").addEventListener("click", function () {
      var pending = State.variables.pendingReward;
      if (!pending || pending.kind !== "loot") return;
      var take = document.querySelector("#reward-take");
      if (take) take.disabled = true;
      setup.receiveLoot(pending.loot, { message: "loot taken" });
      var action = pending.action;
      State.variables.pendingReward = null;
      backdrop.remove();
      if (action && action.type === "dungeonItem") {
        var room = currentDungeonRoom();
        if (room) room.itemTaken = true;
        setup.renderDungeon();
      } else if (action && action.type === "dungeonChest") {
        if (State.variables.dungeon) State.variables.dungeon.chestLooted = true;
        setup.renderDungeon();
      } else if (action && action.type === "search") {
        State.variables.taken[action.flag] = true;
        if (action.returnPassage) play(action.returnPassage);
      } else if (action && action.type === "settlementSearch") {
        State.variables.generatedSettlementVisits[action.flag] = true;
        setup.renderGeneratedSettlement();
      }
    });
    return true;
  };

  setup.searchLoot = function (flag, loot, flavor, returnPassage) {
    ensureState();
    if (State.variables.taken[flag]) {
      notify("nothing else there");
      if (returnPassage) play(returnPassage);
      return false;
    }
    return setup.openLootPopup({
      title: "Found",
      flavor: flavor,
      loot: loot,
      action: { type: "search", flag: flag, returnPassage: returnPassage || State.passage }
    });
  };

  setup.spendGold = function (amount) {
    ensureState();

    amount = Math.max(0, Math.floor(Number(amount) || 0));
    if (State.variables.inventory.gold < amount) {
      notify("not enough gold");
      return false;
    }

    State.variables.inventory.gold -= amount;
    setup.updateInventory();
    return true;
  };

  setup.bribeLordsRestGuard = function () {
    ensureState();

    if (!setup.spendGold(20)) return false;

    State.variables.lordsRest.accessGranted = true;
    State.variables.lordsRest.accessMethod = "bribe";
    play("Lord's Rest - Gate");
    return true;
  };

  setup.pleadWithLordsRestGuard = function () {
    ensureState();
    State.variables.lordsRest.pleaded = true;
    play("Lord's Rest - Guard Plea");
    return true;
  };

  setup.grantLoot = setup.receiveLoot;

  setup.takeSword = function () {
    ensureState();

    var v = State.variables;
    if (v.hasSword || v.taken.oldSword) {
      play("Shelter");
      return false;
    }

    v.hasSword = true;
    v.weapon = { name: "old sword", level: v.weapon.level || 0, baseDamage: 3 };
    v.inventory.oldSword = Math.max(1, v.inventory.oldSword);
    v.equipment.oldSword = "oldSword";
    v.taken.oldSword = true;

    setup.updateInventory();
    notify("old sword taken", { duration: ITEM_NOTIFICATION_MS });
    play("Shelter");
    return true;
  };

  setup.takeStaleBread = function () {
    ensureState();

    var v = State.variables;
    if (v.tookStaleBread || v.taken.staleBreadAndWaterskin) {
      play("Shelter");
      return false;
    }

    v.inventory.staleBread += 1;
    v.inventory.waterskin += 1;
    v.tookStaleBread = true;
    v.taken.staleBreadAndWaterskin = true;

    setup.updateInventory();
    notify("stale bread and old waterskin packed", { duration: ITEM_NOTIFICATION_MS });
    play("Shelter");
    return true;
  };

  setup.takeCharm = function () {
    return setup.takeItem("crackedMoonCharm");
  };

  function replaceTakeLinkWithAction(action) {
    var passage = passageEl();
    if (!passage) return;

    var links = Array.from(passage.querySelectorAll("a"));
    var takeLink = links.find(function (link) {
      return link.textContent.trim().toLowerCase() === "take";
    });

    if (!takeLink) return;

    var cloneLink = takeLink.cloneNode(true);
    cloneLink.href = "javascript:void(0)";
    cloneLink.removeAttribute("data-passage");
    cloneLink.removeAttribute("data-setter");
    cloneLink.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      action();
    });

    takeLink.replaceWith(cloneLink);
  }

  function patchKnownTakeLinks() {
    if (State.passage === "Sword") replaceTakeLinkWithAction(setup.takeSword);
    if (State.passage === "Stale Bread" || State.passage === "StaleBread" || State.passage === "Stale bread") {
      replaceTakeLinkWithAction(setup.takeStaleBread);
    }
  }

  function getDirectChildOfPassage(node, passage) {
    var current = node;
    while (current && current.parentElement !== passage) current = current.parentElement;
    return current || node;
  }

  setup.layoutChoices = function () {
    var passage = passageEl();
    if (!passage || passage.querySelector(".choice-grid:not(.manual)")) return;

    var links = Array.from(passage.querySelectorAll("a.link-internal")).filter(function (link) {
      return !link.classList.contains("no-choice-layout");
    });

    if (links.length === 0) return;

    var grid = document.createElement("div");
    grid.className = "choice-grid";
    grid.classList.add(links.length <= 4 ? "choice-count-" + links.length : "choice-count-many");

    passage.insertBefore(grid, getDirectChildOfPassage(links[0], passage));

    links.forEach(function (link) {
      var oldParent = link.parentElement;
      grid.appendChild(link);
      if (oldParent && oldParent !== passage && oldParent.textContent.trim() === "") oldParent.remove();
    });
  };

  function checkpointState() {
    ensureState();
    var snapshot = clone(State.variables);
    delete snapshot.checkpoints;
    delete snapshot.pendingDefeat;
    return snapshot;
  }

  function restoreCheckpoint(snapshot) {
    if (!snapshot) return false;
    var tutorialSeen = Boolean(State.variables.combatTutorialSeen);
    var permanentStats = clone(State.variables.stats || {});
    var permanentStatEvents = clone(State.variables.storyStatEvents || {});
    Object.keys(State.variables).forEach(function (key) {
      delete State.variables[key];
    });
    var restored = clone(snapshot);
    restored.combatTutorialSeen = tutorialSeen || Boolean(restored.combatTutorialSeen);
    restored.stats = permanentStats;
    restored.storyStatEvents = permanentStatEvents;
    Object.keys(restored).forEach(function (key) {
      State.variables[key] = restored[key];
    });
    ensureState();
    return true;
  }

  setup.beginExpedition = function () {
    ensureState();
    State.variables.checkpoints.expedition = checkpointState();
    State.variables.checkpoints.dungeon = null;
    State.variables.resourceWarnings.foodAcknowledgedAt = null;
    State.variables.resourceWarnings.waterAcknowledgedAt = null;
    State.variables.resourceWarnings.queuedWater = false;
    return true;
  };

  setup.beginDungeonCheckpoint = function () {
    ensureState();
    State.variables.checkpoints.dungeon = checkpointState();
    return true;
  };

  setup.commitTownProgress = function () {
    ensureState();
    State.variables.checkpoints.expedition = null;
    State.variables.checkpoints.dungeon = null;
    State.variables.resourceWarnings.foodAcknowledgedAt = null;
    State.variables.resourceWarnings.waterAcknowledgedAt = null;
    State.variables.resourceWarnings.queuedWater = false;
  };

  setup.closeTransientModals = function () {
    [
      "#resource-warning-modal",
      "#supply-chooser-modal",
      "#defeat-modal",
      "#reward-modal",
      "#map-event-modal",
      "#trader-modal",
      "#settlement-modal"
    ].forEach(function (selector) {
      var modal = document.querySelector(selector);
      if (modal) modal.remove();
    });
    setup.closeSettings();
  };

  setup.requestDefeat = function (checkpointType) {
    ensureState();
    var v = State.variables;
    if (v.pendingDefeat) return false;

    checkpointType = checkpointType === "dungeon" ? "dungeon" : "expedition";
    v.pendingDefeat = { checkpointType: checkpointType };
    setup.closeInventory();
    if (setup.combat) endCombat();

    var old = document.querySelector("#defeat-modal");
    if (old) old.remove();

    var backdrop = document.createElement("div");
    backdrop.id = "defeat-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box defeat-box" role="alertdialog" aria-modal="true" aria-label="Defeated">
        <div class="modal-text">Not looking good..</div>
        <div class="modal-actions">
          <button class="modal-button" id="defeat-run">Run</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);

    var run = document.querySelector("#defeat-run");
    run.addEventListener("click", function () {
      run.disabled = true;
      setup.resolveDefeat();
    });
    return true;
  };

  setup.resolveDefeat = function () {
    ensureState();
    var pending = State.variables.pendingDefeat;
    if (!pending) return false;

    var checkpointType = pending.checkpointType;
    var checkpoint = State.variables.checkpoints[checkpointType];
    if (!checkpoint && checkpointType === "dungeon") {
      checkpoint = State.variables.checkpoints.expedition;
    }
    var hasSavedCheckpoint = Boolean(checkpoint);
    if (!checkpoint) checkpoint = checkpointState();

    restoreCheckpoint(checkpoint);
    var v = State.variables;
    var town = lastTownPlace();
    v.pendingDefeat = null;
    v.dungeon = null;
    v.combatContext = null;
    v.pendingReward = null;
    v.activeMapEvent = null;
    v.checkpoints.expedition = null;
    v.checkpoints.dungeon = null;
    v.currentPlaceKey = town.code;
    v.lastTownKey = town.code;
    v.map.x = town.coord[0];
    v.map.y = town.coord[1];
    if (!hasSavedCheckpoint) {
      v.player.hp = Math.max(1, Math.floor(v.player.maxHp / 2));
    }
    v.pendingTownWakeMessage = DEFEAT_MESSAGE;
    setup.closeTransientModals();
    play(town.respawnPassage || town.passage);
    return true;
  };

  setup.canSave = function () {
    ensureState();
    var browserSlots = typeof Save !== "undefined" && Save.browser && Save.browser.slot;
    var legacySlots = typeof Save !== "undefined" && Save.slots;
    return Boolean(
      (browserSlots || legacySlots) &&
      State.passage !== "Welcome" &&
      !setup.combat &&
      !State.variables.pendingDefeat &&
      !State.variables.pendingReward &&
      !State.variables.activeMapEvent &&
      !document.querySelector("#resource-warning-modal") &&
      !document.querySelector("#supply-chooser-modal") &&
      !document.querySelector("#settings-backdrop.open")
    );
  };

  function liveSaveMetadata() {
    return {
      atfbBuild: setup.__afterFinalBattleBuild,
      atfbPassage: State.passage,
      atfbLiveVariables: JSON.parse(JSON.stringify(State.variables))
    };
  }

  function restoreLiveSave(descriptor) {
    var snapshot = descriptor && descriptor.metadata && descriptor.metadata.atfbLiveVariables;
    if (!snapshot || typeof snapshot !== "object") return false;

    var variables = State.variables;
    Object.keys(variables).forEach(function (key) {
      delete variables[key];
    });
    Object.keys(snapshot).forEach(function (key) {
      variables[key] = snapshot[key];
    });
    ensureState();
    return true;
  }

  setup.saveGame = function () {
    if (!setup.canSave()) {
      notify("cannot save right now");
      return false;
    }

    setup.closeInventory();
    try {
      var metadata = liveSaveMetadata();
      var result = Save.browser && Save.browser.slot
        ? Save.browser.slot.save(0, "After the Final Battle", metadata)
        : Save.slots.save(0, "After the Final Battle", metadata);
      if (result && typeof result.then === "function") {
        result.then(function () {
          notify("game saved");
        }).catch(function () {
          notify("save failed");
        });
      } else {
        notify("game saved");
      }
      return true;
    } catch (error) {
      console.error(error);
      notify("save failed");
      return false;
    }
  };

  setup.hasSave = function () {
    try {
      if (typeof Save === "undefined") return false;
      if (Save.browser && Save.browser.slot) return Boolean(Save.browser.slot.has(0));
      return Boolean(Save.slots && Save.slots.has(0));
    } catch (error) {
      return false;
    }
  };

  setup.continueGame = function () {
    if (!setup.hasSave()) return setup.newGame();
    try {
      var modernSlots = Save.browser && Save.browser.slot;
      var descriptor = modernSlots ? modernSlots.get(0) : Save.slots.get(0);
      var result = modernSlots ? modernSlots.load(0) : Save.slots.load(0);
      var finishLoad = function () {
        restoreLiveSave(descriptor);
        if (typeof Engine !== "undefined" && typeof Engine.show === "function") Engine.show();
      };
      if (result && typeof result.then === "function") {
        result.then(finishLoad).catch(function () {
          setup.newGame();
        });
      } else {
        finishLoad();
      }
      return true;
    } catch (error) {
      console.error(error);
      return setup.newGame();
    }
  };

  setup.newGame = function () {
    if (setup.combat) endCombat();
    setup.closeTransientModals();
    setup.closeInventory();
    setup.initializeNewGame();
    play("Shelter");
    return true;
  };

  function supplyKeys(resource) {
    ensureState();
    return Object.keys(setup.inventoryCatalog).filter(function (key) {
      var def = setup.inventoryCatalog[key];
      return def.kind === "supply" && def.resource === resource && State.variables.inventory[key] > 0;
    });
  }

  setup.openSupplyChooser = function (resource) {
    var oldWarning = document.querySelector("#resource-warning-modal");
    if (oldWarning) oldWarning.remove();
    var oldChooser = document.querySelector("#supply-chooser-modal");
    if (oldChooser) oldChooser.remove();

    var keys = supplyKeys(resource);
    if (keys.length === 0) {
      notify(resource === "food" ? "nothing to eat" : "nothing to drink");
      return false;
    }

    if (keys.length === 1) {
      return setup.consumeSupply(keys[0], { closeModal: true });
    }

    var backdrop = document.createElement("div");
    backdrop.id = "supply-chooser-modal";
    backdrop.className = "modal-backdrop";
    var buttons = keys.map(function (key) {
      var def = setup.inventoryCatalog[key];
      return '<button class="modal-button supply-choice" data-item="' +
        escapeHtml(key) + '">' + escapeHtml(def.name) + " · +" + def.value + "</button>";
    }).join("");
    backdrop.innerHTML = `
      <div class="modal-box" role="dialog" aria-modal="true" aria-label="Choose supplies">
        <div class="modal-title">${resource === "food" ? "Eat what?" : "Drink what?"}</div>
        <div class="modal-actions supply-actions">${buttons}</div>
        <div class="modal-actions">
          <button class="modal-button" id="supply-back">Pass</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);

    Array.from(document.querySelectorAll(".supply-choice")).forEach(function (button) {
      button.addEventListener("click", function () {
        setup.consumeSupply(button.getAttribute("data-item"));
        backdrop.remove();
      });
    });
    document.querySelector("#supply-back").addEventListener("click", function () {
      backdrop.remove();
    });
    return true;
  };

  setup.openResourceWarning = function (resource) {
    ensureState();
    var old = document.querySelector("#resource-warning-modal");
    if (old) old.remove();

    var isFood = resource === "food";
    var backdrop = document.createElement("div");
    backdrop.id = "resource-warning-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box resource-warning-box" role="alertdialog" aria-modal="true">
        <div class="modal-text">${isFood ? "Need to eat." : "Throat is dry."}</div>
        <div class="modal-actions">
          <button class="modal-button" id="resource-consume">${isFood ? "Eat" : "Drink"}</button>
          <button class="modal-button" id="resource-pass">Pass</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);

    document.querySelector("#resource-consume").addEventListener("click", function () {
      setup.openSupplyChooser(resource);
    });
    document.querySelector("#resource-pass").addEventListener("click", function () {
      State.variables.resourceWarnings[resource + "AcknowledgedAt"] = State.variables.inventory[resource];
      backdrop.remove();
    });
    return true;
  };

  setup.checkLowResources = function () {
    ensureState();
    var v = State.variables;
    var warnings = v.resourceWarnings;

    if (v.inventory.food <= 0 || v.inventory.water <= 0) {
      setup.requestDefeat("expedition");
      return "defeat";
    }

    var foodNeedsWarning =
      v.inventory.food < 2 &&
      warnings.foodAcknowledgedAt !== v.inventory.food;
    var waterNeedsWarning =
      v.inventory.water < 2 &&
      warnings.waterAcknowledgedAt !== v.inventory.water;

    if (foodNeedsWarning) {
      if (waterNeedsWarning) warnings.queuedWater = true;
      setup.openResourceWarning("food");
      return "food";
    }

    if (warnings.queuedWater && waterNeedsWarning) {
      warnings.queuedWater = false;
      setup.openResourceWarning("water");
      return "water";
    }

    if (waterNeedsWarning) {
      setup.openResourceWarning("water");
      return "water";
    }

    return null;
  };

  setup.completeLordsRestCampQuest = function () {
    ensureState();
    var v = State.variables;
    v.lordsRest.accessGranted = true;
    v.lordsRest.accessMethod = "camp";
    v.lordsRest.guardReunionSeen = true;
    v.inventory.goblinChiefSpear = 0;
    setup.updateInventory();
    return true;
  };

  setup.places = {
    A: { code: "A", name: "Stalwart", coord: [5, 3], passage: "Stalwart - Main Square", respawnPassage: "Stalwart - Main Square", modifiers: ["Town"], dungeon: "stalwartAcademy", exitLine: "Stalwart sits behind you. The road has seen people leave before." },
    B: { code: "B", name: "Byron's Estate", coord: [6, 7], passage: "Place - Byron's Estate", dungeon: "byronsEstate", exitLine: "The estate gate hangs open behind you." },
    C: { code: "C", name: "Forest of Silence", coord: [11, 4], passage: "Place - Forest of Silence", dungeon: "forestSilence", exitLine: "The forest's quiet follows you for a while before the wind takes over." },
    D: { code: "D", name: "Respite", coord: [12, 9], passage: "Place - Respite", dungeon: "respite", exitLine: "Respite is behind you. The place did what it could with the name." },
    E: { code: "E", name: "Frontier", coord: [18, 6], passage: "Place - Frontier", dungeon: "frontier", exitLine: "The frontier road breaks under the snow." },
    F: { code: "F", name: "Forest of Whispers", coord: [22, 3], passage: "Place - Forest of Whispers", dungeon: "forestWhispers", exitLine: "The whispers fade when you leave, though one or two follow you to the road." },
    G: { code: "G", name: "Lord's Rest", coord: [22, 9], passage: "Lord's Rest - Main Road", respawnPassage: "Lord's Rest - Main Road", modifiers: ["Town"], dungeon: "lordsRestGoblinCamp", exitLine: "Smoke rises behind the walls of Lord's Rest." },
    H: { code: "H", name: "Safety", coord: [28, 4], passage: "Place - Safety", dungeon: "safety", exitLine: "Safety is behind you. The name has not aged well." },
    I: { code: "I", name: "Crossroads", coord: [29, 8], passage: "Place - Crossroads", dungeon: "crossroads", exitLine: "The roads split again." },
    J: { code: "J", name: "Forest of Screams", coord: [34, 3], passage: "Place - Forest of Screams", dungeon: "forestScreams", exitLine: "The screams fade into the wind. You are willing to count that as an improvement." },
    K: { code: "K", name: "Outpost 1", coord: [8, 15], passage: "Place - Outpost 1", dungeon: "outpost1", exitLine: "The first outpost watches the snow." },
    L: { code: "L", name: "Outpost 2", coord: [25, 13], passage: "Place - Outpost 2", dungeon: "outpost2", exitLine: "The second outpost falls behind you." },
    M: { code: "M", name: "The Confederation (North)", coord: [17, 11], passage: "Place - The Confederation (North)", dungeon: "confederationNorth", exitLine: "Old banners move without wind." },
    O: { code: "O", name: "Outpost 3", coord: [33, 10], passage: "Outpost 3 - Gate", respawnPassage: "Outpost 3 - Square", modifiers: ["Town"], dungeon: "outpost3", exitLine: "Voices carry from the third outpost long after its walls disappear behind you." },
    P: { code: "P", name: "Serenity", coord: [36, 7], passage: "Place - Serenity", dungeon: "serenity", exitLine: "Serenity is quiet, which is not the same thing as peaceful." }
  };

  setup.northernPlaces = setup.places;

  function getPlace(key) {
    ensureState();
    return setup.places[key] || setup.places[State.variables.currentPlaceKey] || setup.places.A;
  }

  function placeHasModifier(place, modifier) {
    return Boolean(
      place &&
      Array.isArray(place.modifiers) &&
      place.modifiers.indexOf(modifier) !== -1
    );
  }

  function lastTownPlace() {
    ensureState();

    var place = setup.places[State.variables.lastTownKey];
    if (!placeHasModifier(place, "Town")) {
      State.variables.lastTownKey = "A";
      place = setup.places.A;
    }
    return place;
  }

  function placeAt(x, y) {
    var keys = Object.keys(setup.places);
    for (var i = 0; i < keys.length; i++) {
      var place = setup.places[keys[i]];
      if (place.coord[0] === x && place.coord[1] === y) return place;
    }
    return null;
  }

  function setThought(text) {
    ensureState();
    State.variables.map.lastThought = text;
  }

  setup.enterMap = function (key) {
    ensureState();

    var place = getPlace(key);
    var map = State.variables.map;

    if (placeHasModifier(place, "Town")) {
      setup.beginExpedition();
    }

    State.variables.currentPlaceKey = place.code;
    map.x = place.coord[0];
    map.y = place.coord[1];
    map.lastPromptTile = place.code;
    map.discovered[place.code] = true;
    map.lastThought = place.exitLine || "The road opens again.";

    play("Northern Map");
  };

  setup.enterPlace = function (key) {
    ensureState();

    var place = setup.places[key];
    if (!place) {
      notify("missing place: " + key);
      return;
    }

    State.variables.currentPlaceKey = place.code;
    if (placeHasModifier(place, "Town")) {
      State.variables.lastTownKey = place.code;
      setup.commitTownProgress();
    }
    play(place.passage);
  };

  setup.enterCurrentPlace = function () {
    ensureState();
    var map = State.variables.map;
    var place = placeAt(map.x, map.y);
    if (place) setup.enterPlace(place.code);
  };

  setup.openPlacePrompt = function (place) {
    var old = document.querySelector(".modal-backdrop");
    if (old) old.remove();

    var backdrop = document.createElement("div");
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">${escapeHtml(place.name)}</div>
        <div class="modal-text">Enter ${escapeHtml(place.name)}?</div>
        <div class="modal-actions">
          <button class="modal-button" id="place-enter">Yes</button>
          <button class="modal-button" id="place-cancel">No</button>
        </div>
      </div>
    `;

    document.body.appendChild(backdrop);

    document.querySelector("#place-enter").addEventListener("click", function () {
      backdrop.remove();
      setup.enterPlace(place.code);
    });

    document.querySelector("#place-cancel").addEventListener("click", function () {
      backdrop.remove();
    });
  };

  setup.regionEvents = {
    north: {
      weights: { ambient: 40, combat: 30, trader: 15, settlement: 15 },
      ambient: ["winterRoot", "snowmelt", "scrap", "strayDog", "wanderer"],
      combat: [
        { type: "single", enemy: "starvingWolf" },
        { type: "single", enemy: "wanderingDemon" },
        { type: "single", enemy: "corruptedWolf" },
        { type: "mini", key: "banditCamp" },
        { type: "mini", key: "goblinCave" },
        { type: "mini", key: "demonHorde" },
        { type: "mini", key: "corruptedSite" }
      ]
    }
  };

  setup.itemPrices = {
    staleBread: 3, sealedFoodTin: 8, winterRoot: 2, settlementBread: 6,
    waterskin: 8, snowmeltFlask: 5, riverJar: 6, medicine: 12,
    scrapIronPieces: 4, bentArrowheads: 4, northernFieldWrap: 18,
    watchmanCoat: 28, oldMail: 42, hunterKnife: 16, gateSword: 22
  };

  function randomFrom(list) {
    return list[Math.floor(Math.random() * list.length)];
  }

  function createTraderStock() {
    var stock = {};
    stock[randomFrom(["staleBread", "winterRoot", "settlementBread"])] = 1 + Math.floor(Math.random() * 4);
    stock[randomFrom(["waterskin", "snowmeltFlask", "riverJar"])] = 1 + Math.floor(Math.random() * 4);
    stock.medicine = 1 + Math.floor(Math.random() * 3);
    stock[randomFrom(["scrapIronPieces", "bentArrowheads"])] = 1 + Math.floor(Math.random() * 4);
    return stock;
  }

  setup.openTraderEvent = function () {
    ensureState();
    var lines = [
      "\"Good day, sir. I do not see many people walking this road on purpose.\"",
      "\"Do not worry about me. People in my profession learn to take care of themselves, or they change professions quickly.\"",
      "\"You again. Good. I found a few things worth selling, and several things I can make sound worth selling.\""
    ];
    State.variables.activeMapEvent = {
      kind: "trader",
      line: randomFrom(lines),
      stock: createTraderStock(),
      tab: "buy"
    };
    var old = document.querySelector("#map-event-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "map-event-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">Wandering Trader</div>
        <div class="modal-text dialogue-text">${escapeHtml(State.variables.activeMapEvent.line)}</div>
        <div class="modal-actions">
          <button class="modal-button" id="trader-open">Trade</button>
          <button class="modal-button" id="trader-leave">Leave</button>
        </div>
      </div>`;
    document.body.appendChild(backdrop);
    setup.typeDynamicNarrative(backdrop.querySelector(".dialogue-text"));
    document.querySelector("#trader-open").addEventListener("click", function () {
      backdrop.remove();
      setup.openTraderWindow(false);
    });
    document.querySelector("#trader-leave").addEventListener("click", function () {
      State.variables.activeMapEvent = null;
      backdrop.remove();
      setup.renderMap();
    });
  };

  function sellableKeys() {
    return Object.keys(setup.itemPrices).filter(function (key) {
      return key !== "oldSword" &&
        key !== "goblinChiefSpear" &&
        (State.variables.inventory[key] || 0) > 0;
    });
  }

  setup.openTraderWindow = function (fromSettlement) {
    ensureState();
    var event = State.variables.activeMapEvent;
    var settlement = event && event.settlement;
    if (!event) return false;
    if (fromSettlement) {
      if (!settlement.stock) settlement.stock = createTraderStock();
      event.stock = settlement.stock;
    }
    var old = document.querySelector("#trader-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "trader-modal";
    backdrop.className = "modal-backdrop";
    document.body.appendChild(backdrop);

    function render() {
      var tab = event.tab === "sell" ? "sell" : "buy";
      var keys = tab === "buy"
        ? Object.keys(event.stock).filter(function (key) { return event.stock[key] > 0; })
        : sellableKeys();
      var rows = keys.map(function (key) {
        var def = lootDefinition(key);
        var price = tab === "buy"
          ? setup.itemPrices[key]
          : Math.max(1, Math.floor(setup.itemPrices[key] / 2));
        var amount = tab === "buy" ? event.stock[key] : State.variables.inventory[key];
        return '<div class="trade-row"><button type="button" class="trade-info" data-trade-info="' +
          escapeHtml(key) + '"><span>' + escapeHtml(def.name) + " ×" + amount + '</span><span>' +
          price + ' gold</span></button><button type="button" class="trade-action" data-trade-key="' +
          escapeHtml(key) + '">' + (tab === "buy" ? "Buy" : "Sell") + "</button></div>";
      }).join("");
      backdrop.innerHTML = `
        <div class="modal-box trade-box" role="dialog" aria-modal="true" aria-label="Trading">
          <div class="modal-title">Trade</div>
          <div class="trade-balance">Gold: ${State.variables.inventory.gold}</div>
          <div class="trade-tabs">
            <button type="button" id="trade-buy" class="${tab === "buy" ? "active" : ""}">Buy</button>
            <button type="button" id="trade-sell" class="${tab === "sell" ? "active" : ""}">Sell</button>
          </div>
          <div class="trade-list">${rows || '<div class="reward-empty">Nothing left on this side of the table.</div>'}</div>
          <div class="reward-detail" id="trade-detail">Hover over or tap an item to inspect it.</div>
          <div class="modal-actions"><button class="modal-button" id="trade-exit">Exit</button></div>
        </div>`;
      document.querySelector("#trade-buy").addEventListener("click", function () { event.tab = "buy"; render(); });
      document.querySelector("#trade-sell").addEventListener("click", function () { event.tab = "sell"; render(); });
      Array.from(backdrop.querySelectorAll(".trade-info")).forEach(function (button) {
        var show = function () {
          var def = lootDefinition(button.getAttribute("data-trade-info"));
          document.querySelector("#trade-detail").textContent = (def.description || "") + (def.stats ? " " + def.stats : "");
        };
        button.addEventListener("mouseenter", show);
        button.addEventListener("focus", show);
        button.addEventListener("click", show);
      });
      Array.from(backdrop.querySelectorAll(".trade-action")).forEach(function (button) {
        button.addEventListener("click", function () {
          var key = button.getAttribute("data-trade-key");
          var price = setup.itemPrices[key];
          if (event.tab === "buy") {
            if (State.variables.inventory.gold < price) {
              notify("not enough gold");
              return;
            }
            State.variables.inventory.gold -= price;
            State.variables.inventory[key] = (State.variables.inventory[key] || 0) + 1;
            event.stock[key] -= 1;
          } else {
            if ((State.variables.inventory[key] || 0) < 1) return;
            State.variables.inventory[key] -= 1;
            State.variables.inventory.gold += Math.max(1, Math.floor(price / 2));
          }
          setup.updateInventory();
          render();
        });
      });
      document.querySelector("#trade-exit").addEventListener("click", function () {
        backdrop.remove();
        if (fromSettlement) setup.renderGeneratedSettlement();
        else {
          State.variables.activeMapEvent = null;
          setup.renderMap();
        }
      });
    }
    render();
    return true;
  };

  setup.generatedSettlementScenes = {
    ruined: {
      townSquare: [
        "A roof collapses while you watch. The crack rolls through the empty streets. For a moment, you wait for the swearing to start.",
        "The square is buried to the knees in snow. A dry fountain points at nothing.",
        "Market stalls lean together like they are sharing the last bad news. There is plenty to go around.",
        "A war memorial stands in the center. Every name has been scratched away. Somebody wanted the stone, but apparently not badly enough."
      ],
      residential: [
        "Ash stains the snow around the outer homes despite all the years that have passed.",
        "New boards once covered the old holes. Now both have rotted through, and the weather has the house to itself.",
        "Doors hang open along the street. You still knock before entering one. No reason to become rude now.",
        "A child's wooden horse is frozen beneath a window. One wheel is missing. So is everyone else."
      ],
      schoolyard: [
        "Small desks have been dragged into the yard for firewood. Most of them never made it into the fire.",
        "A lesson is still written on a slate beneath the snow. The answer was spring.",
        "The school bell lies cracked beside the gate. Class ended years ago, though nobody bothered to take it inside.",
        "Children once wore a path across this yard. Snow has spent years erasing it."
      ],
      marketplace: [
        "Wet canvas sags over empty stalls. Nobody complains about prices. It is worse this way.",
        "Coins lie fused together beneath a burned counter. Riches, assuming you can find a merchant who accepts one large coin-shaped lump.",
