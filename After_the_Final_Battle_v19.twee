    goblinChief: { name: "the goblin chief", symbol: "G", hp: 50, attackDamage: 7, enemyTickGain: 3, loot: { goblinChiefSpear: 1, gold: 8 }, descriptions: { idle: "the goblin chief rises behind a table made from stolen doors.", low: "the chief plants one foot.", mid: "the spear draws back.", high: "the spear is about to move.", attack: "the chief drives the spear forward.", parried: "the old sword catches the spearhead.", dodged: "the spear tears through a chair.", hit: "the spear lands." } }
  };

  Object.assign(setup.enemies, {
    wanderingDemon: { name: "a wandering demon", symbol: "D", hp: 38, attackDamage: 6, enemyTickGain: 3, loot: { medicine: 1, gold: 5 }, descriptions: { idle: "a demon walks out of the snow as if it has somewhere to be.", low: "the demon watches your hands.", mid: "black fire gathers around one arm.", high: "the fire leans toward you.", attack: "the demon strikes.", parried: "the old sword breaks the fire apart.", dodged: "the fire burns a hole in the snow.", hit: "the fire finds you." } },
    corruptedWolf: { name: "a corrupted wolf", symbol: "c", hp: 28, attackDamage: 5, enemyTickGain: 4, loot: { winterRoot: 1, gold: 3 }, descriptions: { idle: "a wolf limps into view. Purple light moves beneath its skin.", low: "the wolf circles on shaking legs.", mid: "its jaw opens too far.", high: "it throws itself forward.", attack: "the wolf lunges.", parried: "the old sword catches bone and teeth.", dodged: "the wolf tears through empty snow.", hit: "corrupted teeth sink in." } },
    banditRaider: { name: "a northern bandit", symbol: "b", hp: 24, attackDamage: 4, enemyTickGain: 3, loot: { gold: 2 }, descriptions: { idle: "a bandit raises a weapon that has changed owners more than once.", low: "the bandit measures the distance.", mid: "their blade comes up.", high: "they commit to the swing.", attack: "the bandit attacks.", parried: "the old sword sends the blade aside.", dodged: "the swing finds cold air.", hit: "the blade lands." } },
    banditCaptain: { name: "the bandit captain", symbol: "B", hp: 44, attackDamage: 7, enemyTickGain: 3, loot: { sealedFoodTin: 1, scrapIronPieces: 2, gold: 8 }, descriptions: { idle: "the captain steps over the campfire. Nobody else volunteers.", low: "the captain settles into a practiced stance.", mid: "the sword draws back.", high: "the captain moves.", attack: "the captain cuts forward.", parried: "the old sword holds.", dodged: "the cut passes close enough.", hit: "the captain's blade finds you." } },
    demonHerald: { name: "a demon herald", symbol: "R", hp: 62, attackDamage: 8, enemyTickGain: 3, loot: { moonCharms: 2, medicine: 1, gold: 12 }, descriptions: { idle: "the herald unfolds from the dark. The rooms behind you suddenly feel very far away.", low: "the herald lifts one hand.", mid: "the air turns purple around it.", high: "the room bends toward the strike.", attack: "the herald tears at the air.", parried: "the old sword remembers what it was made for.", dodged: "stone turns black where you stood.", hit: "the world goes bright and painful." } },
    corruptedGuardian: { name: "a corrupted guardian", symbol: "C", hp: 52, attackDamage: 7, enemyTickGain: 3, loot: { northernFieldWrap: 1, scrapIronPieces: 2, gold: 9 }, descriptions: { idle: "something large stands between you and the way out.", low: "purple veins brighten beneath ruined armor.", mid: "the guardian leans forward.", high: "metal and corruption come at you together.", attack: "the guardian charges.", parried: "the old sword stops the worst of it.", dodged: "the charge breaks stone.", hit: "the guardian drives through you." } }
  });

  /* Seconds. Every attack rolls a fresh duration inside its enemy-specific range. */
  var enemyTimingRanges = {
    starvingWolf:      { light: [3.4, 4.2], medium: [4.6, 5.6], heavy: [6.2, 7.2] },
    goblinScout:       { light: [3.2, 4.0], medium: [4.4, 5.4], heavy: [6.0, 7.0] },
