    orcRaider: { name: "an orc raider", symbol: "O", hp: 30, attackDamage: 5, enemyTickGain: 2, loot: { scrapIronPieces: 2, gold: 3 }, descriptions: { idle: "an orc raider blocks the way.", low: "the orc adjusts its grip.", mid: "the axe rises.", high: "the axe is coming down.", attack: "the orc swings.", parried: "the old sword catches the haft.", dodged: "the axe splits stone.", hit: "the axe lands." } },
