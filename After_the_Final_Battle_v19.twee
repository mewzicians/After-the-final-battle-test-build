:: StoryTitle
After the Final Battle

:: StoryData
{
  "ifid": "2D862DAD-73FF-419B-A581-E2E507932D46",
  "format": "SugarCube",
  "format-version": "2.36.1",
  "start": "Welcome",
  "zoom": 1
}

:: Story Stylesheet [stylesheet]
#ui-bar { display: none; }
:root {
  --page-top-space: clamp(18px, 4dvh, 42px);
  --hud-bottom-space: 94px;
  --page-inline-space: 32px;
}
#story {
  height: 100vh;
  height: 100dvh;
  margin-left: 0;
  overflow: hidden;
}
html, body {
  margin: 0;
  height: 100%;
  min-height: 100%;
  min-height: 100dvh;
  overflow: hidden;
}
body {
  background: #272823;
  color: #eeeeee;
  font-family: "Courier New", Courier, monospace;
  font-size: clamp(15px, 0.45vw + 13.5px, 18px);
  line-height: 1.45;
}
button,
input,
select,
textarea {
  font-family: inherit;
}
#passages {
  width: min(820px, calc(100% - 32px));
  max-width: 820px;
  height: calc(100vh - var(--page-top-space) - var(--hud-bottom-space));
  height: calc(100dvh - var(--page-top-space) - var(--hud-bottom-space));
  box-sizing: border-box;
  margin: var(--page-top-space) auto 0;
  padding: 0 clamp(8px, 2.5vw, 24px);
  overflow: hidden;
}
.passage {
  width: 100%;
  max-height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  text-align: left;
  overflow-wrap: anywhere;
}
.welcome-screen #passages {
  display: flex;
  height: calc(100dvh - 40px);
  min-height: 0;
  align-items: center;
  justify-content: center;
  margin-top: 20px;
}
.welcome-screen .passage {
  text-align: center;
}
.welcome-title {
  margin-bottom: 58px;
  color: #ffffff;
  font-size: clamp(34px, 6vw, 64px);
  line-height: 1.08;
  letter-spacing: 0.02em;
}
.passage p {
  margin: 0 0 18px 0;
  text-align: left;
}
.passage ul,
.passage ol {
  display: inline-block;
  text-align: left;
}
.passage pre,
.passage code {
  text-align: left;
}
.place-card,
.dungeon-card {
  text-align: left;
}
a, a:visited { color: inherit; text-decoration: none; }

.choice-grid {
  display: grid;
  justify-content: center;
  justify-items: center;
  align-items: center;
  gap: 22px 28px;
  width: 100%;
  margin: 70px auto 0 auto;
}
.choice-grid.choice-count-1 { grid-template-columns: 160px; }
.choice-grid.choice-count-2 { grid-template-columns: repeat(2, 160px); }
.choice-grid.choice-count-3 { grid-template-columns: repeat(3, 160px); }
.choice-grid.choice-count-4 { grid-template-columns: repeat(2, 160px); }
.choice-grid.choice-count-many { grid-template-columns: repeat(3, 160px); }
.choice-grid.manual { margin-top: 34px; grid-template-columns: repeat(2, 220px); }
.choice-grid a.link-internal,
.choice-grid button,
.single-button,
#inventory-toggle,
#save-toggle,
#journal-toggle,
#settings-toggle,
.inventory-tab,
#equipment-action,
.modal-button {
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  border: 1px solid #eeeeee;
  background: transparent;
  color: #eeeeee;
  font-family: "Courier New", Courier, monospace;
  font-size: 16px;
  text-align: center;
  padding: 7px 12px;
  min-height: 38px;
  border-radius: 7px;
  cursor: pointer;
  transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}
.choice-grid a.link-internal { width: 160px; }
.choice-grid button { width: 220px; }
.choice-grid a.link-internal:hover,
.choice-grid button:hover,
.single-button:hover,
#inventory-toggle:hover,
#save-toggle:hover,
#journal-toggle:hover,
#settings-toggle:hover,
#text-speed-cycle:hover,
#text-instant-toggle:hover,
.inventory-tab:hover,
#equipment-action:hover,
.modal-button:hover { text-decoration: underline; }

.single-button { margin: 12px auto 18px auto; }

#bottom-controls {
  position: fixed;
  left: 50%;
  bottom: max(18px, env(safe-area-inset-bottom));
  transform: translateX(-50%);
  z-index: 2100;
  display: flex;
  gap: 10px;
  padding: 8px;
  border: 1px solid rgba(238,238,238,0.42);
  border-radius: 12px;
  background: rgba(39,40,35,0.96);
  box-shadow: 0 8px 30px rgba(0,0,0,0.28);
}
#inventory-toggle,
#save-toggle,
#journal-toggle,
#settings-toggle {
  width: 132px;
  min-height: 42px;
  background: #272823;
}
#save-toggle:disabled,
#journal-toggle:disabled { opacity: 0.42; cursor: default; }

#text-speed-controls {
  position: fixed;
  right: max(18px, env(safe-area-inset-right));
  bottom: max(18px, env(safe-area-inset-bottom));
  z-index: 2100;
  display: flex;
  gap: 8px;
  padding: 8px;
  border: 1px solid rgba(238,238,238,0.42);
  border-radius: 12px;
  background: rgba(39,40,35,0.96);
  box-shadow: 0 8px 30px rgba(0,0,0,0.28);
}

#text-speed-cycle,
#text-instant-toggle {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  min-height: 42px;
  padding: 7px 12px;
  border: 1px solid #eeeeee;
  border-radius: 7px;
  background: #272823;
  color: #eeeeee;
  cursor: pointer;
  font: 16px "Courier New", Courier, monospace;
  transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

#text-speed-cycle {
  min-width: 58px;
}

#text-instant-toggle {
  min-width: 88px;
}

#text-instant-toggle.active {
  border-color: #f0d590;
  background: #6a5536;
  color: #fff5d8;
  box-shadow: 0 0 0 2px rgba(240, 213, 144, 0.2);
}

body.viewport-stack-controls { --hud-bottom-space: 164px; }
body.viewport-stack-controls #text-speed-controls {
  bottom: calc(max(18px, env(safe-area-inset-bottom)) + 68px);
}

body.viewport-compact .passage {
  font-size: 14px;
  line-height: 1.34;
}

body.viewport-compact .passage p { margin-bottom: 12px; }
body.viewport-compact .choice-grid,
body.viewport-compact .choice-grid.manual { gap: 10px 14px; margin-top: 24px; }
body.viewport-compact .world-shell { margin-top: 0; }
body.viewport-compact .world-card,
body.viewport-compact .world-evidence { margin: 10px 0; padding: 13px; }
body.viewport-compact .world-actions { margin: 12px 0; gap: 8px; }
body.viewport-compact .journal-chapters { margin-top: 12px; }
body.viewport-compact .journal-page { min-height: 230px; padding-top: 18px; padding-bottom: 18px; }

body.viewport-tight .passage {
  font-size: 13px;
  line-height: 1.26;
}

body.viewport-tight .passage p { margin-bottom: 8px; }
body.viewport-tight .choice-grid,
body.viewport-tight .choice-grid.manual { gap: 7px 10px; margin-top: 14px; }
body.viewport-tight .choice-grid a.link-internal,
body.viewport-tight .choice-grid button { min-height: 40px; padding: 5px 9px; font-size: 13px; }
body.viewport-tight .world-title { margin: 3px 0 5px; font-size: clamp(21px, 5vw, 30px); }
body.viewport-tight .world-card,
body.viewport-tight .world-evidence { margin: 7px 0; padding: 10px 12px; }
body.viewport-tight .world-card p,
body.viewport-tight .world-evidence p { margin-bottom: 0; line-height: 1.34; }
body.viewport-tight .world-actions { margin: 8px 0; gap: 6px; }
body.viewport-tight .world-actions button,
body.viewport-tight .world-link-button { min-height: 38px; padding: 6px 10px; }
body.viewport-tight .journal-book { padding: 9px; }
body.viewport-tight .journal-region-nav,
body.viewport-tight .journal-picker { margin-bottom: 9px; }
body.viewport-tight .journal-page { min-height: 190px; padding: 14px 16px; }

.viewport-page-host {
  display: flex;
  flex-direction: column;
  min-height: 0;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  overflow: hidden;
}

.viewport-page-stage {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.viewport-content-page {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.viewport-content-page[hidden] { display: none !important; }

.viewport-page-nav {
  display: grid;
  grid-template-columns: minmax(108px, auto) 1fr minmax(108px, auto);
  align-items: center;
  gap: 10px;
  flex: 0 0 46px;
  min-height: 46px;
  box-sizing: border-box;
  margin-top: 6px;
  border-top: 1px solid rgba(238,238,238,0.3);
}

.viewport-page-nav button {
  min-height: 38px;
  border: 1px solid rgba(238,238,238,0.64);
  border-radius: 7px;
  background: #272823;
  color: #eeeeee;
  cursor: pointer;
  font: inherit;
}

.viewport-page-nav button:disabled { opacity: 0.35; cursor: default; }
.viewport-page-label { color: #aaa395; text-align: center; font-size: 12px; }
#inventory-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2200;
  display: none;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  padding: 28px;
  background: rgba(0, 0, 0, 0.72);
}
#inventory-backdrop.open { display: flex; }
#inventory-panel {
  width: min(920px, calc(100vw - 56px));
  height: min(650px, calc(100dvh - 56px));
  max-height: calc(100dvh - 56px);
  box-sizing: border-box;
  border: 1px solid #eeeeee;
  border-radius: 14px;
  background: #272823;
  color: #eeeeee;
  padding: 22px;
  overflow: hidden;
}
#inventory-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(238,238,238,0.45);
}
#inventory-tabs {
  display: flex;
  gap: 8px;
}
.inventory-tab {
  min-width: 128px;
  min-height: 40px;
}
.inventory-tab.active {
  background: rgba(238,238,238,0.12);
  border-color: #ffffff;
}
#inventory-resources {
  color: #d9ca82;
  text-align: right;
  font-size: 0.94em;
}
.inventory-view {
  display: none;
  min-height: 0;
  flex: 1;
}
.inventory-view.active { display: flex; }
#inventory-body {
  display: grid;
  grid-template-columns: minmax(220px, 0.9fr) minmax(280px, 1.1fr);
  height: 100%;
  min-height: 0;
  max-height: none;
}
#inventory-list {
  display: grid;
  grid-auto-rows: minmax(42px, max-content);
  align-content: start;
  gap: 8px;
  padding: 18px 18px 18px 0;
  overflow-y: auto;
}
.inventory-item {
  width: 100%;
  min-height: 42px;
  box-sizing: border-box;
  border: 1px solid rgba(238,238,238,0.55);
  background: transparent;
  color: #eeeeee;
  font-family: "Courier New", Courier, monospace;
  font-size: 16px;
  text-align: left;
  padding: 8px 12px;
  border-radius: 7px;
  cursor: pointer;
}
.inventory-item:hover,
.inventory-item.selected {
  border-color: #eeeeee;
  background: rgba(238,238,238,0.08);
}
#inventory-detail {
  display: flex;
  flex-direction: column;
  min-height: 280px;
  padding: 18px 0 0 22px;
  border-left: 1px solid rgba(238,238,238,0.35);
  text-align: left;
}
#inventory-detail-name {
  margin-bottom: 18px;
  font-size: 22px;
}
#inventory-detail-description {
  min-height: 90px;
  line-height: 1.5;
}
#inventory-detail-stats,
#equipment-detail-stats {
  margin-top: 14px;
  color: #d9ca82;
}
#inventory-detail-quantity {
  margin-top: 16px;
  color: #cfcfcf;
}
#inventory-detail-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: auto;
  padding-top: 24px;
}
#inventory-use,
#inventory-close,
#equipment-action {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-width: 110px;
  min-height: 38px;
  box-sizing: border-box;
  border: 1px solid #eeeeee;
  background: transparent;
  color: #eeeeee;
  font-family: "Courier New", Courier, monospace;
  font-size: 16px;
  border-radius: 7px;
  cursor: pointer;
}
#inventory-use:hover,
#inventory-close:hover,
#equipment-action:hover { text-decoration: underline; }

#inventory-panel {
  display: flex;
  flex-direction: column;
}
#inventory-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 14px;
  border-top: 1px solid rgba(238,238,238,0.35);
}
#equipment-body {
  display: grid;
  grid-template-columns: minmax(300px, 1fr) minmax(300px, 1fr);
  height: 100%;
  min-height: 0;
}
#equipment-mobile-pages { display: none; }
#equipment-browser {
  display: grid;
  grid-template-rows: minmax(150px, 1fr) minmax(170px, 1fr);
  min-height: 0;
  padding-right: 20px;
  border-right: 1px solid rgba(238,238,238,0.35);
}
#equipment-list {
  display: grid;
  grid-auto-rows: minmax(42px, max-content);
  align-content: start;
  gap: 8px;
  min-height: 0;
  padding: 18px 0;
  overflow-y: auto;
}
#equipment-detail {
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 18px 0;
  border-top: 1px solid rgba(238,238,238,0.35);
  text-align: left;
  overflow-y: auto;
}
#equipment-detail-name {
  margin-bottom: 14px;
  font-size: 22px;
}
#equipment-detail-description { line-height: 1.5; }
#equipment-action {
  align-self: flex-end;
  margin-top: auto;
}
#equipment-overview {
  min-height: 0;
  padding: 18px 0 18px 22px;
  overflow-y: auto;
}
#character-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 18px;
}
.character-stat {
  padding: 12px 14px;
  border: 1px solid rgba(217,202,130,0.62);
  border-radius: 9px;
  background: rgba(217,202,130,0.06);
  text-align: left;
}
.character-stat-name {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: #ffffff;
}
.character-stat-progress {
  margin-top: 5px;
  color: #cfcfcf;
  font-size: 13px;
}
.character-stat-effect {
  margin-top: 3px;
  color: #d9ca82;
  font-size: 12px;
}
#equipment-slots {
  display: grid;
  grid-auto-rows: minmax(64px, max-content);
  align-content: start;
  gap: 12px;
  min-height: 0;
  padding: 0;
}
.equipment-slot {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 16px;
  align-items: center;
  min-height: 64px;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid rgba(238,238,238,0.48);
  border-radius: 9px;
  background: rgba(0,0,0,0.1);
  text-align: left;
}
.equipment-slot.locked {
  border-color: rgba(217,202,130,0.72);
}
.equipment-slot-label { color: #cfcfcf; }
.equipment-slot-value { color: #ffffff; }

@media (max-width: 650px) {
  #inventory-backdrop { padding: 16px; }
  #inventory-panel {
    width: calc(100vw - 32px);
    height: calc(100dvh - 32px);
    max-height: calc(100dvh - 32px);
    padding: 18px;
  }
  #inventory-body {
    grid-template-columns: 1fr;
    grid-template-rows: minmax(108px, 32%) minmax(0, 1fr);
    max-height: none;
    overflow: hidden;
  }
  #inventory-list {
    min-height: 0;
    max-height: none;
    padding-right: 0;
  }
  #inventory-detail {
    min-height: 0;
    padding: 12px 0 0 0;
    border-top: 1px solid rgba(238,238,238,0.35);
    border-left: 0;
    overflow-y: auto;
  }
  #inventory-detail-name { margin-bottom: 8px; font-size: 18px; }
  #inventory-detail-description { min-height: 0; line-height: 1.35; }
  #inventory-detail-stats,
  #inventory-detail-quantity { margin-top: 8px; }
  #inventory-detail-actions {
    position: sticky;
    bottom: 0;
    padding-top: 10px;
    background: #272823;
  }
  #inventory-header {
    align-items: stretch;
    flex-direction: column;
    gap: 10px;
  }
  #inventory-resources { text-align: left; }
  #inventory-tabs { width: 100%; }
  .inventory-tab { flex: 1; min-width: 0; }
  #equipment-body {
    grid-template-columns: 1fr;
    min-height: 0;
    overflow: hidden;
  }
  #equipment-mobile-pages {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
    padding: 10px 0 0;
  }
  #equipment-mobile-pages button {
    flex: 1;
    min-height: 36px;
    border: 1px solid rgba(238,238,238,0.55);
    border-radius: 7px;
    background: transparent;
    color: #eeeeee;
    font: inherit;
  }
  #equipment-mobile-pages button.active { border-color: #ffffff; background: rgba(238,238,238,0.12); }
  #equipment-browser {
    min-height: 0;
    padding-right: 0;
    border-right: 0;
  }
  #equipment-list { min-height: 0; max-height: none; }
  #equipment-overview {
    display: none;
    padding: 12px 0 0 0;
    border-top: 1px solid rgba(238,238,238,0.35);
    overflow-y: auto;
  }
  #equipment-body.mobile-overview #equipment-browser { display: none; }
  #equipment-body.mobile-overview #equipment-overview { display: block; }
  #character-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .character-stat { padding: 8px 9px; }
  #equipment-slots { gap: 7px; }
  .equipment-slot { min-height: 50px; padding: 8px 10px; }
  #bottom-controls {
    width: calc(100vw - 32px);
    box-sizing: border-box;
  }
  #inventory-toggle,
  #save-toggle,
  #journal-toggle,
  #settings-toggle { flex: 1; width: auto; min-height: 46px; }
}

@media (max-width: 980px) {
  :root {
    --page-top-space: 64px;
    --hud-bottom-space: 164px;
  }
  #text-speed-controls {
    right: max(16px, env(safe-area-inset-right));
    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 68px);
  }
}

#notification-log {
  position: fixed;
  left: calc(50% - 590px);
  top: 70px;
  width: 210px;
  height: 620px;
  overflow: hidden;
  color: #eeeeee;
  opacity: 0.85;
  pointer-events: none;
}
.notification { margin-bottom: 10px; opacity: 1; transition: opacity 0.4s ease; }
.notification.fade-out { opacity: 0; }

.place-card, .dungeon-card {
  border: 1px solid rgba(238,238,238,0.35);
  padding: 24px;
  background: rgba(0,0,0,0.09);
  border-radius: 11px;
}
.place-title, .dungeon-title, .map-title {
  font-size: 22px;
  margin-bottom: 18px;
}
.map-subtitle { color: #cfcfcf; margin-bottom: 14px; }

.map-direction-pad {
  display: grid;
  grid-template-columns: repeat(3, minmax(72px, 140px));
  grid-template-rows: repeat(3, 40px);
  justify-content: center;
  gap: 7px;
  width: 100%;
  margin: 7px auto;
}

.north-map-shell {
  display: grid;
  grid-template-columns: max-content 260px;
  gap: 28px;
  align-items: start;
  justify-content: center;
}
.map-grid {
  display: grid;
  grid-template-columns: repeat(11, 32px);
  grid-template-rows: repeat(11, 32px);
  gap: 2px;
  background: #151515;
  border: 1px solid #eeeeee;
  padding: 8px;
  border-radius: 10px;
}
.map-cell {
  width: 32px;
  height: 32px;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  background: #24251f;
  color: #aaaaaa;
  font-family: "Courier New", monospace;
  font-size: 13px;
  overflow: hidden;
}
.map-cell.fog { background: #050505; color: #050505; }
.map-cell.poi { color: #ff6a6a; font-weight: bold; }
.map-cell.settlement { color: #8ad8ff; font-weight: bold; }
.map-cell.player-cell { color: #eeeeee; border: 1px solid #eeeeee; }
.poi-under {
  position: absolute;
  opacity: 0.25;
  color: #ff6a6a;
  font-weight: bold;
  font-size: 18px;
}
.player-icon {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-weight: bold;
  font-size: 14px;
}
.map-controls {
  display: grid;
  grid-template-columns: repeat(3, 110px);
  gap: 8px;
  margin-top: 18px;
  justify-content: center;
}
.map-controls button {
  border: 1px solid #eeeeee;
  background: transparent;
  color: #eeeeee;
  font-family: "Courier New", Courier, monospace;
  min-height: 34px;
  border-radius: 7px;
  cursor: pointer;
}
.map-controls button:first-child { grid-column: 2; }
.map-controls button:nth-child(2) { grid-column: 1; }
.map-controls button:nth-child(3) { grid-column: 3; }
.map-controls button:nth-child(4) { grid-column: 2; }
.map-bottom-bar {
  margin-top: 14px;
  border: 1px solid rgba(238,238,238,0.35);
  padding: 10px;
  text-align: center;
  border-radius: 8px;
}
.thought-box {
  border: 1px solid rgba(238,238,238,0.45);
  min-height: 220px;
  padding: 16px;
  background: rgba(0,0,0,0.12);
  border-radius: 10px;
}
.thought-title { font-size: 18px; margin-bottom: 14px; }
.thought-body { color: #eeeeee; }
.thought-here { margin-top: 18px; color: #8ad8ff; }

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 3000;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
  background: rgba(0, 0, 0, 0.72);
  overflow: hidden;
}
.modal-box {
  width: min(560px, calc(100vw - 48px));
  box-sizing: border-box;
  border: 1px solid #eeeeee;
  border-radius: 13px;
  background: #272823;
  color: #eeeeee;
  padding: 24px;
  text-align: center;
  max-height: calc(100vh - 24px);
  max-height: calc(100dvh - 24px);
  overflow-y: auto;
  overflow-x: hidden;
  overscroll-behavior: contain;
  overflow-wrap: anywhere;
}
.modal-title { margin-bottom: 18px; font-size: 20px; }
.modal-text { margin-bottom: 24px; line-height: 1.45; }
.modal-actions { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; }
.modal-button { min-width: 140px; }

.modal-page-stack { flex: 1 1 auto; min-height: 0; overflow: hidden; }
.modal-page { display: none; height: 100%; box-sizing: border-box; overflow: hidden; }
.modal-page.active { display: block; }
.modal-page-nav {
  display: grid;
  grid-template-columns: minmax(92px, auto) 1fr minmax(92px, auto);
  align-items: center;
  gap: 10px;
  flex: 0 0 44px;
  margin-top: 10px;
  border-top: 1px solid rgba(238,238,238,0.28);
}
.modal-page-nav button {
  min-height: 36px;
  border: 1px solid rgba(238,238,238,0.6);
  border-radius: 7px;
  background: transparent;
  color: #eeeeee;
  cursor: pointer;
  font: inherit;
}
.modal-page-nav button:disabled { opacity: 0.35; cursor: default; }
.modal-page-label { color: #aaa; font-size: 12px; }

#combat-overlay {
  position: fixed;
  inset: 0;
  z-index: 2500;
  box-sizing: border-box;
  background: #272823;
  color: #ffffff;
  font-family: "Courier New", monospace;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: clamp(28px, 8vh, 90px) 20px max(24px, env(safe-area-inset-bottom));
  overflow: hidden;
}
#combat-panel {
  width: min(820px, calc(100vw - 40px));
  max-width: 100%;
  max-height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  text-align: center;
}
#combat-enemy-name { font-size: 28px; margin-bottom: 18px; }
#combat-log {
  height: 156px;
  box-sizing: border-box;
  margin: 0 auto 30px;
  padding: 12px 14px;
  border: 1px solid rgba(255,255,255,0.62);
  border-radius: 9px;
  background: #20211d;
  overflow-y: auto;
  overscroll-behavior: contain;
  text-align: left;
  font-size: 16px;
  line-height: 1.4;
  scrollbar-color: #eeeeee #20211d;
}
.combat-log-entry { margin-bottom: 7px; color: #dddddd; }
.combat-log-entry:last-child { margin-bottom: 0; }
.combat-log-entry.counter { color: #8ad8ff; font-weight: bold; }
.combat-log-entry.success { color: #9fe09f; }
.combat-log-entry.danger { color: #ff9f9f; }
.combat-log-entry.clash { color: #f3d978; font-weight: bold; }
#combat-fighters { display: flex; justify-content: space-between; align-items: flex-start; margin: 0 auto 38px auto; max-width: 620px; }
.combat-fighter { width: 180px; }
.combat-symbol { color: #ffffff; font-size: 42px; font-weight: bold; line-height: 1; margin-bottom: 10px; }
.combat-hp { font-size: 28px; font-weight: bold; }
#enemy-action-wrap { width: 180px; margin-top: 14px; }
#enemy-action-bar { height: 10px; border: 1px solid #ffffff; border-radius: 6px; background: transparent; overflow: hidden; }
#enemy-action-fill { height: 100%; width: 0%; background: #ffffff; transition: width 0.08s linear, background 0.12s ease; }
#enemy-action-wrap.counter-window #enemy-action-bar { border-color: #f3d978; box-shadow: 0 0 12px rgba(243,217,120,0.46); }
#enemy-action-wrap.counter-window #enemy-action-fill { background: #f3d978; }
#enemy-attack-name { margin-top: 12px; font-size: 16px; text-transform: uppercase; }
#enemy-attack-charge { margin-top: 5px; font-size: 13px; }
#combat-actions { display: grid; grid-template-columns: repeat(2, 260px); justify-content: center; gap: 8px; }
.combat-action { min-height: 58px; border: 1px solid #ffffff; border-radius: 9px; background: #20211d; color: #ffffff; font-family: "Courier New", monospace; font-size: 22px; cursor: pointer; }
.combat-action:hover:not(:disabled) { background: #373832; }
.combat-action:disabled { opacity: 0.45; cursor: default; }
.combat-small { display: block; margin-top: 4px; font-size: 13px; }

#combat-tutorial {
  position: fixed;
  inset: 0;
  z-index: 5000;
  pointer-events: none;
}
.combat-tutorial-shade {
  position: fixed;
  z-index: 5000;
  background: rgba(17,18,16,0.88);
  pointer-events: auto;
}
.combat-tutorial-focus {
  position: relative !important;
  pointer-events: none !important;
  box-shadow: 0 0 0 3px #ffffff, 0 0 28px rgba(255,255,255,0.62) !important;
  filter: none !important;
}
#combat-tutorial-card {
  position: fixed;
  z-index: 5002;
  left: 50%;
  bottom: max(24px, env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: min(560px, calc(100vw - 36px));
  box-sizing: border-box;
  border: 1px solid #ffffff;
  border-radius: 12px;
  background: #272823;
  padding: 20px;
  color: #ffffff;
  text-align: left;
  box-shadow: 0 12px 42px rgba(0,0,0,0.72);
  pointer-events: auto;
}
#combat-tutorial-title { margin-bottom: 10px; font-size: 20px; font-weight: bold; }
#combat-tutorial-text { min-height: 54px; line-height: 1.45; }
#combat-tutorial-progress { margin-top: 10px; color: #aaaaaa; font-size: 13px; }
#combat-tutorial-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; }
#combat-tutorial-actions button { min-width: 110px; min-height: 40px; border: 1px solid #ffffff; border-radius: 7px; background: transparent; color: #ffffff; font-family: inherit; cursor: pointer; }


/* v15 map/dungeon support */
#map-wrap.map-screen { width: 100%; height: 100%; box-sizing: border-box; margin: 0 auto; text-align: center; overflow: hidden; }
#north-map-root { width: 100%; height: 100%; min-height: 0; }
#world-map { display: inline-block; max-width: 100%; box-sizing: border-box; margin: 8px auto; padding: clamp(6px, 1.4vw, 12px) clamp(7px, 2vw, 16px); border: 1px solid #eeeeee; border-radius: 10px; background: #20211d; color: #eeeeee; font-family: "Courier New", monospace; font-size: clamp(9px, 1.8vw, 16px); line-height: 1.12; letter-spacing: clamp(0px, 0.08vw, 1px); white-space: pre; text-align: left; overflow: hidden; }
.map-thought-box { position: static; width: min(520px, 100%); box-sizing: border-box; margin: 0 auto 8px auto; border: 1px solid #eeeeee; border-radius: 10px; padding: 9px 13px; background: #272823; color: #eeeeee; text-align: center; }
.map-thought-title { font-weight: bold; margin-bottom: 8px; }
.map-thought-text { line-height: 1.35; text-align: left; }
.map-direction-pad button, .map-button { min-width: 0; min-height: 42px; border: 1px solid #eeeeee; border-radius: 7px; background: transparent; color: #eeeeee; font-family: "Courier New", Courier, monospace; font-size: 16px; cursor: pointer; text-align: center; }
.map-direction-pad button:hover, .map-button:hover { text-decoration: underline; }
.map-screen .choice-grid.manual { margin: 7px auto !important; }
.map-hud { position: static; width: min(520px, 100%); box-sizing: border-box; margin: 7px auto 0; border: 1px solid #eeeeee; border-radius: 9px; background: #272823; color: #eeeeee; padding: 6px 10px; text-align: center; font-family: "Courier New", Courier, monospace; }

.lore-shake {
  animation: lore-shake 0.4s ease-in-out;
}
@keyframes lore-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-6px); }
  40% { transform: translateX(5px); }
  60% { transform: translateX(-3px); }
  80% { transform: translateX(2px); }
}

@media (max-width: 760px) {
  .choice-grid,
  .choice-grid.manual {
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 12px;
    margin-top: 42px;
  }
  .choice-grid a.link-internal,
  .choice-grid button {
    width: min(100%, 280px);
    min-height: 46px;
  }
  .map-direction-pad {
    grid-template-columns: repeat(3, minmax(72px, 1fr)) !important;
    width: min(100%, 420px);
  }
  #combat-fighters { margin-bottom: 38px; }
  #combat-actions {
    grid-template-columns: repeat(2, minmax(130px, 1fr));
    width: 100%;
  }
  .combat-action { font-size: 18px; }
}

@media (max-width: 430px), (max-height: 560px) {
  :root {
    --page-top-space: 54px;
    --hud-bottom-space: 152px;
  }
  #combat-overlay { padding-top: 20px; }
  #combat-enemy-name { margin-bottom: 16px; font-size: 22px; }
  #combat-log { height: 90px; margin-bottom: 10px; padding: 8px 10px; font-size: 13px; }
  #combat-fighters { margin-bottom: 10px; }
  .combat-fighter { width: 130px; }
  .combat-symbol { font-size: 32px; }
  .combat-hp { font-size: 21px; }
  #combat-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .combat-action { min-height: 44px; }
  #combat-tutorial-card { bottom: 12px; padding: 16px; }
  .map-thought-box { margin-bottom: 4px; padding: 5px 8px; }
  .map-thought-title { margin-bottom: 3px; }
  #world-map { margin: 4px auto; padding: 4px 6px; line-height: 1.04; }
  .map-direction-pad {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    grid-template-rows: 38px;
    gap: 5px;
    margin: 4px auto;
  }
  .map-direction-pad button {
    grid-column: auto !important;
    grid-row: auto !important;
    min-height: 38px;
    font-size: 13px;
  }
  .map-screen .choice-grid.manual { margin: 4px auto !important; }
  .map-hud { margin-top: 4px; padding: 4px 7px; font-size: 12px; }
}

@media (max-width: 1180px) {
  #notification-log {
    left: 50%;
    right: auto;
    top: max(8px, env(safe-area-inset-top));
    width: min(620px, calc(100vw - 24px));
    height: 44px;
    transform: translateX(-50%);
    text-align: center;
  }
  .notification { margin-bottom: 4px; }
}

@media (min-width: 981px) and (max-width: 1180px) {
  :root { --page-top-space: 64px; }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* v18 regional update: settings, rewards, traders, and generated settlements */
#settings-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2200;
  display: none;
  justify-content: center;
  align-items: center;
  padding: 24px;
  box-sizing: border-box;
  background: rgba(0,0,0,0.72);
}
#settings-backdrop.open { display: flex; }
#settings-panel {
  width: min(620px, calc(100vw - 40px));
  max-height: calc(100dvh - 32px);
  overflow-y: auto;
  box-sizing: border-box;
  padding: clamp(20px, 4vw, 32px);
  border: 1px solid #eeeeee;
  border-radius: 16px;
  background: #272823;
}
.settings-title { margin-bottom: 24px; font-size: 26px; text-align: center; }
.settings-row {
  display: grid;
  grid-template-columns: minmax(150px, 1fr) minmax(240px, 1.4fr);
  align-items: center;
  gap: 18px;
  padding: 17px 0;
  border-top: 1px solid rgba(238,238,238,0.25);
}
.settings-control { display: flex; justify-content: flex-end; gap: 8px; }
.settings-control button,
#settings-close,
.trade-tabs button,
.trade-action,
.trade-info,
.settlement-area-button,
.reward-stat-row,
.reward-loot-row {
  border: 1px solid rgba(238,238,238,0.55);
  border-radius: 9px;
  background: transparent;
  color: #eeeeee;
  font-family: inherit;
  cursor: pointer;
}
.settings-control button { min-width: 72px; min-height: 38px; }
.settings-control button.active,
.trade-tabs button.active,
.settlement-area-button.active {
  border-color: #ffffff;
  background: rgba(238,238,238,0.13);
}
.settings-footer { display: flex; justify-content: flex-end; padding-top: 22px; }
.settings-footer,
.modal-box > .modal-actions:last-child {
  position: sticky;
  bottom: 0;
  z-index: 2;
  background: #272823;
}
#settings-close { min-width: 110px; min-height: 40px; }

.reward-box { width: min(680px, calc(100vw - 32px)); max-height: calc(100dvh - 40px); overflow-y: auto; }
.after-battle-box { display: flex; flex-direction: column; width: min(760px, calc(100vw - 32px)); height: min(720px, calc(100dvh - 32px)); overflow: hidden; }
.after-battle-box .modal-title { flex: 0 0 auto; }
.after-battle-box .modal-page.active { display: flex; flex-direction: column; min-height: 0; }
.after-battle-box .reward-flavor { margin-bottom: 12px; }
.after-battle-box .reward-detail { min-height: 42px; margin-bottom: 10px; }
.after-battle-box .reward-section-title { margin-top: 8px; }
.after-battle-box .reward-loot-list { min-height: 0; overflow-y: auto; }
.after-battle-box .modal-actions { margin-top: auto; padding-top: 10px; }
.reward-flavor { margin: 0 auto 20px; line-height: 1.45; text-align: left; }
.reward-player-exp { margin-bottom: 14px; color: #d9ca82; }
.reward-stats { display: grid; gap: 9px; margin-bottom: 12px; }
.reward-stat-row {
  display: grid;
  grid-template-columns: minmax(110px, 0.8fr) minmax(150px, 2fr) 54px;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 52px;
  padding: 8px 12px;
  text-align: left;
}
.reward-stat-label { display: flex; flex-direction: column; }
.reward-stat-label small { color: #bbb; }
.reward-exp-wrap { height: 12px; overflow: hidden; border: 1px solid #eee; border-radius: 8px; }
.reward-exp-fill { display: block; height: 100%; background: #d9ca82; }
.reward-stat-gain { color: #d9ca82; text-align: right; }
.combat-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}
.combat-summary-row {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  min-height: 42px;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid rgba(238,238,238,0.36);
  border-radius: 8px;
  text-align: left;
}
.combat-summary-row strong { color: #d9ca82; }
.reward-section-title { margin: 20px 0 10px; font-size: 18px; }
.reward-loot-list { display: grid; gap: 8px; }
.reward-loot-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  min-height: 42px;
  padding: 8px 12px;
}
.reward-detail {
  min-height: 54px;
  margin: 10px 0 18px;
  padding: 10px 12px;
  border-radius: 9px;
  background: rgba(0,0,0,0.16);
  color: #d7d7d7;
  text-align: left;
  line-height: 1.35;
}
.reward-empty { padding: 10px; color: #aaa; }

.trade-box { width: min(720px, calc(100vw - 32px)); max-height: calc(100dvh - 40px); overflow-y: auto; }
.trade-balance { margin-bottom: 14px; color: #d9ca82; }
.trade-tabs { display: flex; justify-content: center; gap: 8px; margin-bottom: 14px; }
.trade-tabs button { min-width: 110px; min-height: 38px; }
.trade-list { display: grid; gap: 8px; }
.trade-row { display: grid; grid-template-columns: 1fr 90px; gap: 8px; }
.trade-info {
  display: flex;
  justify-content: space-between;
  min-height: 44px;
  padding: 8px 12px;
  text-align: left;
}
.trade-action { min-height: 44px; }

.settlement-box { width: min(900px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; }
.settlement-layout { display: grid; grid-template-columns: minmax(180px, 0.65fr) minmax(320px, 1.35fr); gap: 18px; margin-bottom: 22px; }
.settlement-area-list { display: grid; align-content: start; gap: 8px; max-height: 52dvh; overflow-y: auto; }
.settlement-area-button { min-height: 42px; padding: 8px 10px; }
.settlement-scene {
  min-height: 270px;
  padding: 20px;
  border: 1px solid rgba(238,238,238,0.38);
  border-radius: 13px;
  background: rgba(0,0,0,0.1);
}
.settlement-area-title { margin-bottom: 18px; font-size: 21px; }
.dialogue-text,
.settlement-story-text { min-height: 110px; line-height: 1.5; text-align: left; }

.place-panel,
.dungeon-panel {
  padding: clamp(18px, 4vw, 30px);
  border: 1px solid rgba(238,238,238,0.35);
  border-radius: 14px;
  background: rgba(0,0,0,0.09);
}
.place-panel > p,
.dungeon-panel > p {
  text-align: left;
}

@media (max-width: 700px) {
  #bottom-controls { gap: 6px; }
  #settings-toggle, #inventory-toggle, #journal-toggle, #save-toggle { padding: 6px; font-size: 14px; }
  .settings-row { grid-template-columns: 1fr; gap: 10px; }
  .settings-control { justify-content: flex-start; flex-wrap: wrap; }
  .settlement-layout { grid-template-columns: 1fr; }
  .settlement-area-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-height: 190px;
  }
  .combat-summary-grid { grid-template-columns: 1fr; }
  .after-battle-box .combat-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .after-battle-box .combat-summary-row { min-height: 48px; padding: 7px 8px; gap: 8px; font-size: 12px; }
  .after-battle-box { padding: 16px; }
  .reward-stat-row { grid-template-columns: 94px 1fr 40px; gap: 7px; padding: 8px; }
}

@media (max-width: 390px) {
  #bottom-controls { width: calc(100vw - 16px); }
  #settings-toggle, #inventory-toggle, #journal-toggle, #save-toggle { font-size: 12px; min-height: 42px; }
  #text-speed-controls { right: max(8px, env(safe-area-inset-right)); padding: 6px; }
  #text-speed-cycle, #text-instant-toggle { min-height: 40px; padding: 6px 10px; font-size: 13px; }
  #text-speed-cycle { min-width: 50px; }
  #text-instant-toggle { min-width: 72px; }
  .modal-box { width: calc(100vw - 20px); padding: 18px; }
  .trade-row { grid-template-columns: 1fr 72px; }
  .settlement-area-list { grid-template-columns: 1fr; }
}

/* Room, journal, and world-location styles. */

.world-shell {
  width: min(100%, 980px);
  max-height: 100%;
  margin: 0 auto;
  overflow: hidden;
}

.world-kicker {
  color: #b99f6b;
  font-size: 0.76rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.world-title {
  margin: 7px 0 9px;
  color: #eee2c3;
  font-family: Georgia, serif;
  font-size: clamp(1.75rem, 5vw, 3rem);
  font-weight: normal;
}

.world-deck {
  max-width: 760px;
  color: #c4bcae;
  font-size: 1.02rem;
  line-height: 1.7;
}

.world-card,
.world-evidence {
  margin: 16px 0;
  padding: 18px;
  border: 1px solid rgba(174, 154, 111, 0.35);
  background: linear-gradient(145deg, rgba(31, 29, 27, 0.96), rgba(16, 17, 18, 0.97));
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.2);
}

.world-card h3,
.world-evidence h3 {
  margin: 0 0 8px;
  color: #e0d0aa;
  font-family: Georgia, serif;
  font-weight: normal;
}

.world-card p,
.world-evidence p {
  color: #bbb3a6;
  line-height: 1.58;
}

.world-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 19px 0;
}

.world-actions button,
.world-link-button {
  min-height: 42px;
  padding: 9px 15px;
  border: 1px solid rgba(207, 183, 125, 0.65);
  background: rgba(43, 38, 31, 0.98);
  color: #eee2c3;
  cursor: pointer;
  font: inherit;
}

.world-actions button:hover,
.world-link-button:hover {
  background: #5a4931;
}

.world-actions button:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.world-meta {
  color: #918877;
  font-size: 0.83rem;
  line-height: 1.5;
}

.world-cat {
  border-left: 3px solid #92794e;
  color: #c9c0b2;
  font-style: italic;
}

.world-map-region {
  margin: 12px auto 2px;
  color: #cdb782;
  font-size: 0.8rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.world-ending-choice {
  border-left: 4px solid #ad9360;
}

.world-journal-shell {
  max-width: 880px;
}

.journal-chapters,
.journal-region-nav,
.journal-pagination {
  display: flex;
  align-items: center;
  gap: 10px;
}

.journal-chapters {
  margin: 20px 0 12px;
}

.journal-chapters button,
.journal-region-nav button,
.journal-pagination button {
  min-height: 42px;
  padding: 9px 15px;
  border: 1px solid rgba(207, 183, 125, 0.65);
  background: rgba(43, 38, 31, 0.98);
  color: #eee2c3;
  cursor: pointer;
  font: inherit;
}

.journal-chapters button:hover,
.journal-region-nav button:hover,
.journal-pagination button:hover {
  background: #5a4931;
}

.journal-chapters button.is-active,
.journal-region-nav button.is-active {
  border-color: #e3c982;
  background: #6a5536;
  color: #fff5d8;
}

.journal-pagination button:disabled {
  cursor: default;
  opacity: 0.34;
}

.journal-book {
  position: relative;
  overflow: hidden;
  padding: 18px;
  border: 1px solid rgba(183, 157, 100, 0.58);
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.24), transparent 8%, transparent 92%, rgba(0, 0, 0, 0.22)),
    #24211c;
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.34);
}

.journal-region-nav {
  overflow-x: auto;
  margin: 0 0 14px;
  padding: 0 0 5px;
  scrollbar-width: thin;
}

.journal-region-nav button {
  flex: 0 0 auto;
}

.journal-picker {
  display: grid;
  grid-template-columns: minmax(110px, auto) minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.journal-picker label {
  color: #bcae92;
  font-size: 0.84rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.journal-picker select {
  width: 100%;
  min-height: 44px;
  padding: 8px 36px 8px 12px;
  border: 1px solid rgba(207, 183, 125, 0.65);
  border-radius: 0;
  background: #302b23;
  color: #f0e5ca;
  font: inherit;
}

.journal-page {
  min-height: 310px;
  padding: 28px clamp(20px, 5vw, 46px);
  border: 1px solid rgba(173, 151, 105, 0.4);
  background:
    repeating-linear-gradient(0deg, rgba(206, 183, 132, 0.025) 0, rgba(206, 183, 132, 0.025) 1px, transparent 1px, transparent 28px),
    linear-gradient(145deg, #29251f, #1d1c19);
  box-shadow: inset 16px 0 30px rgba(0, 0, 0, 0.18);
}

.journal-page h2 {
  margin: 4px 0 18px;
  color: #e5d5ae;
  font-family: Georgia, serif;
  font-weight: normal;
}

.journal-page > p,
.journal-page-section p {
  color: #c5bcad;
  line-height: 1.68;
}

.journal-page-section {
  padding: 15px 0 3px;
  border-top: 1px solid rgba(183, 157, 100, 0.25);
}

.journal-page-section:first-of-type {
  border-top: 0;
}

.journal-page-section h3 {
  margin: 0 0 7px;
  color: #d8c79f;
  font-family: Georgia, serif;
  font-weight: normal;
}

.journal-pagination {
  justify-content: space-between;
  margin-top: 16px;
}

.journal-pagination button:last-child {
  margin-left: auto;
}

@media (max-width: 620px) {
  .world-shell { width: min(94vw, 980px); }
  .journal-chapters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .journal-chapters button { padding: 8px 6px; }
  .journal-book { padding: 12px; }
  .journal-picker { grid-template-columns: 1fr; gap: 7px; }
  .journal-page { min-height: 280px; padding: 22px 18px; }
  .journal-pagination button { min-width: 48px; padding: 9px 12px; }
}

:: Story JavaScript [script]
(function () {
  "use strict";

  if (typeof setup === "undefined") {
    throw new Error("SugarCube setup object is unavailable. Confirm the story format is SugarCube 2.");
  }

  setup.__afterFinalBattleBuild = "v19-discovery-world";

  var MAP_MIN = 1;
  var MAP_MAX = 51;
  var VISION_RADIUS = 5;
  var MAP_EVENT_CHANCE = 0.25;
  var MAP_EVENT_COOLDOWN_TILES = 5;
  var WATER_STEP_COST = 20;
  var FOOD_STEP_COST = 40;
  var HEALTH_REGEN_STEPS = 4;
  var PLAYER_ACTION_CHARGE = 10;
  var COMBAT_INTERVAL_MS = 100;
  var BASE_ATTACK_COOLDOWN_MS = 3000;
  var BASE_DODGE_COOLDOWN_MS = 3000;
  var BASE_PARRY_COOLDOWN_MS = 4000;
  var ATTACK_COOLDOWN_REDUCTION_PER_LEVEL = 0.025;
  var DODGE_COOLDOWN_REDUCTION_PER_LEVEL = 0.04;
  var PARRY_COOLDOWN_REDUCTION_PER_LEVEL = 0.04;
  var MAX_ATTACK_COOLDOWN_REDUCTION = 0.30;
  var MAX_DEFENSIVE_COOLDOWN_REDUCTION = 0.40;
  var STAT_LEVEL_CAP = 10;
  var COUNTER_WINDOW_RATIO = 0.8;
  var DEFAULT_NOTIFICATION_MS = 2000;
  var ITEM_NOTIFICATION_MS = 2500;
  var DEFEAT_MESSAGE = "Won't be so lucky next time.";
  var WEAPON_REJECTION = "The old sword does not leave your hand. The other weapon grows heavier until you put it back.";

  function play(passage) {
    if (passage && typeof Engine !== "undefined" && typeof Engine.play === "function") {
      Engine.play(passage);
    }
  }

  function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
  }

  function clone(value) {
    return JSON.parse(JSON.stringify(value));
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function passageEl() {
    return document.querySelector("#passages .passage");
  }

  function makeButton(label, onClick) {
    var button = document.createElement("button");
    button.type = "button";
    button.textContent = label;
    button.addEventListener("click", onClick);
    return button;
  }

  function statXpNeeded(level) {
    level = clamp(Math.floor(Number(level) || 1), 1, STAT_LEVEL_CAP);
    return level >= STAT_LEVEL_CAP ? 0 : 3 + (level - 1) * 2;
  }
  setup.statLevelCap = STAT_LEVEL_CAP;
  setup.statXpNeeded = statXpNeeded;

  function freshState() {
    return {
      lookedSword: false,
      lookedCracks: false,
      lookedStaleBread: false,
      tookStaleBread: false,
      shelterBeat: 0,
      shelterTexts: [
        "A cold air marches in through the crack in the wall. You feel it crawl across your skin, underneath your shirt, down to your feet. A quiet companion. Unkind, but welcome. That's how you know that you're alive.",
        "The city is quiet. The heart is loud.",
        "The room feels smaller now. Once, it felt too large.",
        "There is nothing left here but the door."
      ],
      inventory: {
        food: 10,
        water: 10,
        gold: 0,
        scrapIron: 0,
        moonCharms: 0,
        medicine: 0,
        staleBread: 0,
        sealedFoodTin: 0,
        winterRoot: 0,
        settlementBread: 0,
        waterskin: 0,
        snowmeltFlask: 0,
        riverJar: 0,
        scrapIronPieces: 0,
        bentArrowheads: 0,
        tulip: 0,
        silentBell: 0,
        whiteAntler: 0,
        frostBearClaw: 0,
        goblinChiefSpear: 0,
        northernFieldWrap: 0,
        watchmanCoat: 0,
        oldMail: 0,
        hunterKnife: 0,
        gateSword: 0,
        oldSword: 0
      },
      hasSword: false,
      weapon: { name: "none", level: 0, baseDamage: 2 },
      armor: { name: "none", resistance: 0 },
      equipment: {
        head: null,
        body: null,
        feet: null,
        ring: null,
        oldSword: null
      },
      player: { hp: 25, maxHp: 25, level: 1, exp: 0, nextExp: 100 },
      stats: {
        strength: { level: 1, exp: 0, next: 3 },
        defense: { level: 1, exp: 0, next: 3 },
        resistance: { level: 1, exp: 0, next: 3 },
        agility: { level: 1, exp: 0, next: 3 }
      },
      storyStatEvents: {},
      hiddenStats: { kindness: 0 },
      combatTutorialSeen: false,
      taken: {},
      clearedDungeons: {},
      dungeonRooms: {},
      dungeon: null,
      combatContext: null,
      pendingReward: null,
      activeMapEvent: null,
      generatedSettlementVisits: {},
      miniDungeonCounter: 0,
      lastClearedDungeonLine: "Nothing is waiting for you in there anymore.",
      lastTownKey: "A",
      currentPlaceKey: "A",
      pendingTownWakeMessage: "",
      pendingDefeat: null,
      checkpoints: { expedition: null, dungeon: null },
      resourceWarnings: {
        foodAcknowledgedAt: null,
        waterAcknowledgedAt: null,
        queuedWater: false
      },
      lordsRest: {
        pleaded: false,
        accessGranted: false,
        accessMethod: "",
        daughterRescued: false,
        guardReunionSeen: false
      },
      map: {
        region: "north",
        x: 5,
        y: 3,
        moves: 0,
        tilesSinceWater: 0,
        tilesSinceFood: 0,
        tilesSinceHealth: 0,
        eventCooldown: 0,
        niceDemonFound: false,
        lastPromptTile: "A",
        lastThought: "Stalwart sits behind you. The road has seen people leave before.",
        discovered: {}
      }
    };
  }

  setup.initializeNewGame = function () {
    var state = freshState();
    Object.keys(State.variables).forEach(function (key) {
      delete State.variables[key];
    });
    Object.keys(state).forEach(function (key) {
      State.variables[key] = state[key];
    });
    setup.selectedInventoryKey = null;
    setup.selectedEquipmentKey = null;
    setup.inventoryTab = "inventory";
    return true;
  };

  function ensureState() {
    var v = State.variables;

    if (!v.inventory) v.inventory = {};

    var invDefaults = {
      food: 0,
      water: 0,
      gold: 0,
      scrapIron: 0,
      tulip: 0,
      moonCharms: 0,
      medicine: 0,
      staleBread: 0,
      sealedFoodTin: 0,
      winterRoot: 0,
      settlementBread: 0,
      waterskin: 0,
      snowmeltFlask: 0,
      riverJar: 0,
      scrapIronPieces: 0,
      bentArrowheads: 0,
      silentBell: 0,
      whiteAntler: 0,
      frostBearClaw: 0,
      goblinChiefSpear: 0,
      northernFieldWrap: 0,
      watchmanCoat: 0,
      oldMail: 0,
      hunterKnife: 0,
      gateSword: 0,
      oldSword: 0
    };

    Object.keys(invDefaults).forEach(function (key) {
      if (typeof v.inventory[key] !== "number") v.inventory[key] = invDefaults[key];
    });

    if (!v.taken) v.taken = {};
    if (!v.clearedDungeons) v.clearedDungeons = {};
    if (!v.dungeonRooms) v.dungeonRooms = {};

    if (!v.player) v.player = { hp: 25, maxHp: 25, level: 1, exp: 0, nextExp: 100 };
    if (typeof v.player.hp !== "number") v.player.hp = 25;
    if (typeof v.player.maxHp !== "number") v.player.maxHp = 25;
    if (typeof v.player.level !== "number") v.player.level = 1;
    if (typeof v.player.exp !== "number") v.player.exp = 0;
    if (typeof v.player.nextExp !== "number") v.player.nextExp = Math.max(100, 100 + (v.player.level - 1) * 50);

    if (!v.weapon) v.weapon = { name: "none", level: 0, baseDamage: 2 };
    if (!v.weapon.name) v.weapon.name = "none";
    if (typeof v.weapon.level !== "number") v.weapon.level = 0;
    if (typeof v.weapon.baseDamage !== "number") v.weapon.baseDamage = 2;

    if (!v.armor) v.armor = { name: "none", resistance: 0 };
    if (!v.armor.name) v.armor.name = "none";
    if (typeof v.armor.resistance !== "number") {
      v.armor.resistance = typeof v.armor.defense === "number" ? v.armor.defense : 0;
    }

    if (!v.equipment) {
      v.equipment = { head: null, body: null, feet: null, ring: null, oldSword: null };
    }
    ["head", "body", "feet", "ring", "oldSword"].forEach(function (slot) {
      if (typeof v.equipment[slot] === "undefined") v.equipment[slot] = null;
    });

    if (!v.stats) v.stats = {};
    if (!v.stats.strength) {
      v.stats.strength = v.stats.attack
        ? { level: Math.max(1, v.stats.attack.level || 0), exp: 0, next: 3 }
        : { level: 1, exp: 0, next: 3 };
    }
    if (!v.stats.defense) v.stats.defense = { level: 1, exp: 0, next: 3 };
    if (!v.stats.resistance) v.stats.resistance = { level: 1, exp: 0, next: 3 };
    if (!v.stats.agility) v.stats.agility = { level: 1, exp: 0, next: 3 };

    ["strength", "defense", "resistance", "agility"].forEach(function (name) {
      if (typeof v.stats[name].level !== "number") v.stats[name].level = 1;
      if (typeof v.stats[name].exp !== "number") v.stats[name].exp = 0;
      if (typeof v.stats[name].next !== "number") v.stats[name].next = statXpNeeded(v.stats[name].level);
    });
    if (!v.storyStatEvents) v.storyStatEvents = {};

    if (!v.hiddenStats) v.hiddenStats = { kindness: 0 };
    if (typeof v.hiddenStats.kindness !== "number") v.hiddenStats.kindness = 0;
    if (typeof v.combatTutorialSeen !== "boolean") v.combatTutorialSeen = false;

    if (typeof v.hasSword !== "boolean") v.hasSword = false;
    if (typeof v.tookStaleBread !== "boolean") v.tookStaleBread = false;
    if (typeof v.lastTownKey !== "string") v.lastTownKey = "A";
    if (typeof v.pendingTownWakeMessage !== "string") v.pendingTownWakeMessage = "";
    if (typeof v.pendingDefeat === "undefined") v.pendingDefeat = null;
    if (typeof v.pendingReward === "undefined") v.pendingReward = null;
    if (typeof v.activeMapEvent === "undefined") v.activeMapEvent = null;
    if (!v.generatedSettlementVisits) v.generatedSettlementVisits = {};
    if (typeof v.miniDungeonCounter !== "number") v.miniDungeonCounter = 0;
    if (!v.checkpoints) v.checkpoints = { expedition: null, dungeon: null };
    if (typeof v.checkpoints.expedition === "undefined") v.checkpoints.expedition = null;
    if (typeof v.checkpoints.dungeon === "undefined") v.checkpoints.dungeon = null;
    if (!v.resourceWarnings) {
      v.resourceWarnings = {
        foodAcknowledgedAt: null,
        waterAcknowledgedAt: null,
        queuedWater: false
      };
    }
    if (typeof v.resourceWarnings.queuedWater !== "boolean") {
      v.resourceWarnings.queuedWater = false;
    }

    if (!v.lordsRest) {
      v.lordsRest = {
        pleaded: false,
        accessGranted: false,
        accessMethod: "",
        daughterRescued: false,
        guardReunionSeen: false
      };
    }
    if (typeof v.lordsRest.pleaded !== "boolean") v.lordsRest.pleaded = false;
    if (typeof v.lordsRest.accessGranted !== "boolean") v.lordsRest.accessGranted = false;
    if (typeof v.lordsRest.accessMethod !== "string") v.lordsRest.accessMethod = "";
    if (typeof v.lordsRest.daughterRescued !== "boolean") v.lordsRest.daughterRescued = false;
    if (typeof v.lordsRest.guardReunionSeen !== "boolean") v.lordsRest.guardReunionSeen = false;

    if (v.dungeon && v.dungeon.key === "lordsRest") {
      v.dungeon.key = "lordsRestGoblinCamp";
      v.dungeon.name = "Goblin Camp";
      v.dungeon.rooms = 10;
      v.dungeon.room = clamp(v.dungeon.room || 1, 1, 10);
      v.dungeon.returnPassage = "Lord's Rest - Gate";
    }

    if (!v.map) {
      v.map = {
        x: 5,
        y: 3,
        moves: 0,
        tilesSinceWater: 0,
        tilesSinceFood: 0,
        eventCooldown: 0,
        niceDemonFound: false,
        lastPromptTile: null,
        lastThought: "Stalwart sits behind you. The road has seen people leave before.",
        discovered: {}
      };
    }

    if (typeof v.map.x !== "number") v.map.x = 5;
    if (typeof v.map.y !== "number") v.map.y = 3;
    if (typeof v.map.moves !== "number") v.map.moves = 0;
    if (typeof v.map.tilesSinceWater !== "number") v.map.tilesSinceWater = 0;
    if (typeof v.map.tilesSinceFood !== "number") v.map.tilesSinceFood = 0;
    if (typeof v.map.tilesSinceHealth !== "number") v.map.tilesSinceHealth = 0;
    if (typeof v.map.eventCooldown !== "number") v.map.eventCooldown = 0;
    if (typeof v.map.niceDemonFound !== "boolean") v.map.niceDemonFound = false;
    if (typeof v.map.region !== "string") v.map.region = "north";
    if (!v.map.discovered) v.map.discovered = {};

    if (v.northMap && !v.__migratedNorthMap) {
      v.map.x = typeof v.northMap.x === "number" ? v.northMap.x : v.map.x;
      v.map.y = typeof v.northMap.y === "number" ? v.northMap.y : v.map.y;
      v.map.lastThought = v.northMap.lastThought || v.map.lastThought;
      v.map.discovered = v.northMap.discovered || v.map.discovered;
      v.__migratedNorthMap = true;
    }

    if (!v.__v18ExpandedMigrated) {
      var armorNameToKey = {
        "northern field wrap": "northernFieldWrap",
        "watchman's coat": "watchmanCoat",
        "old mail shirt": "oldMail"
      };
      var weaponNameToKey = {
        "hunter's knife": "hunterKnife",
        "academy practice blade": "gateSword"
      };

      if (v.armor && armorNameToKey[v.armor.name]) {
        v.equipment.body = armorNameToKey[v.armor.name];
      }

      if (v.weapon && weaponNameToKey[v.weapon.name]) {
        v.inventory[weaponNameToKey[v.weapon.name]] += 1;
      }

      if (v.hasSword || (v.taken && v.taken.oldSword)) {
        v.hasSword = true;
        v.inventory.oldSword = Math.max(1, v.inventory.oldSword);
        v.equipment.oldSword = "oldSword";
        v.weapon = { name: "old sword", level: v.weapon.level || 0, baseDamage: 3 };
      }

      if (
        v.clearedDungeons &&
        v.clearedDungeons.lordsRestGoblinCamp &&
        v.lordsRest &&
        v.lordsRest.accessGranted &&
        v.lordsRest.accessMethod === "camp"
      ) {
        v.inventory.goblinChiefSpear = 0;
      }

      v.__v18ExpandedMigrated = true;
    }

    if (!v.__v18ProgressionMigrated) {
      ["strength", "defense", "resistance"].forEach(function (name) {
        v.stats[name].level = Math.max(1, v.stats[name].level || 0);
        v.stats[name].next = Math.max(100, v.stats[name].next || 0);
      });
      v.player.level = Math.max(1, v.player.level || 0);
      v.player.nextExp = Math.max(100, v.player.nextExp || 0);
      v.__v18ProgressionMigrated = true;
    }

    if (!v.__storyStatsV1Migrated) {
      ["strength", "defense", "resistance", "agility"].forEach(function (name) {
        var stat = v.stats[name];
        stat.level = clamp(Math.max(1, Math.floor(stat.level || 1)), 1, STAT_LEVEL_CAP);
        /* Keep levels earned by older saves, but retire combat-earned partial EXP. */
        stat.exp = 0;
        stat.next = statXpNeeded(stat.level);
      });
      v.__storyStatsV1Migrated = true;
    }

    setup.syncEquipmentStats();
  }

  setup.notify = function (message, options) {
    options = options || {};
    var duration = Math.max(400, Number(options.duration) || DEFAULT_NOTIFICATION_MS);
    var log = document.querySelector("#notification-log");
    if (!log) {
      console.log(message);
      return;
    }

    var line = document.createElement("div");
    line.className = "notification";
    line.textContent = message;
    log.prepend(line);

    setTimeout(function () {
      line.classList.add("fade-out");
    }, Math.max(0, duration - 400));

    setTimeout(function () {
      line.remove();
    }, duration);
  };

  function notify(message, options) {
    setup.notify(message, options);
  }

  var DEFAULT_PREFERENCES = { sound: 10, textSpeed: 1, instantText: false, screenShake: true };
  var TEXT_SPEED_MULTIPLIERS = [1, 2, 4];
  var BASE_TEXT_WPM = 400;
  var SENTENCE_PAUSE_MS = 500;

  setup.getPreferences = function () {
    var saved = null;
    try {
      if (State && State.metadata && typeof State.metadata.get === "function") {
        saved = State.metadata.get("atfbPreferences");
      }
    } catch (error) {
      saved = null;
    }
    var preferences = Object.assign({}, DEFAULT_PREFERENCES, saved || setup.__preferences || {});
    preferences.sound = clamp(Math.round(Number(preferences.sound) || 10), 1, 10);
    if (preferences.textSpeed === "fast") preferences.textSpeed = 2;
    if (["normal", "medium", "slow"].indexOf(preferences.textSpeed) !== -1) preferences.textSpeed = 1;
    preferences.textSpeed = Number(String(preferences.textSpeed).replace(/[x\u00d7]/gi, ""));
    if (TEXT_SPEED_MULTIPLIERS.indexOf(preferences.textSpeed) === -1) preferences.textSpeed = 1;
    preferences.instantText = preferences.instantText === true;
    preferences.screenShake = preferences.screenShake !== false;
    setup.__preferences = preferences;
    return preferences;
  };

  setup.savePreferences = function (changes) {
    var preferences = Object.assign({}, setup.getPreferences(), changes || {});
    setup.__preferences = preferences;
    try {
      if (State && State.metadata && typeof State.metadata.set === "function") {
        State.metadata.set("atfbPreferences", clone(preferences));
      }
    } catch (error) {
      console.warn("Could not persist settings metadata.", error);
    }
    setup.updateSettingsPanel();
    return preferences;
  };

  setup.updateSettingsPanel = function () {
    var preferences = setup.getPreferences();
    Array.from(document.querySelectorAll("[data-text-speed-cycle]")).forEach(function (button) {
      var nextIndex = (TEXT_SPEED_MULTIPLIERS.indexOf(preferences.textSpeed) + 1) % TEXT_SPEED_MULTIPLIERS.length;
      button.textContent = preferences.textSpeed + "\u00d7";
      button.setAttribute("aria-label", "Text speed " + preferences.textSpeed + " times. Activate for " + TEXT_SPEED_MULTIPLIERS[nextIndex] + " times.");
      button.title = "Text speed: " + preferences.textSpeed + "\u00d7";
    });
    Array.from(document.querySelectorAll("[data-instant-text-toggle]")).forEach(function (button) {
      button.textContent = "instant";
      button.classList.toggle("active", preferences.instantText);
      button.setAttribute("aria-pressed", preferences.instantText ? "true" : "false");
      button.setAttribute("aria-label", "Instant text " + (preferences.instantText ? "on" : "off"));
    });
    Array.from(document.querySelectorAll("[data-screen-shake]")).forEach(function (button) {
      button.classList.toggle(
        "active",
        (button.getAttribute("data-screen-shake") === "on") === preferences.screenShake
      );
    });
  };

  setup.cycleTextSpeed = function () {
    var preferences = setup.getPreferences();
    var index = TEXT_SPEED_MULTIPLIERS.indexOf(preferences.textSpeed);
    var nextSpeed = TEXT_SPEED_MULTIPLIERS[(index + 1) % TEXT_SPEED_MULTIPLIERS.length];
    setup.savePreferences({ textSpeed: nextSpeed });
    return nextSpeed;
  };

  setup.toggleInstantText = function () {
    var instant = !setup.getPreferences().instantText;
    setup.savePreferences({ instantText: instant });
    if (instant) cancelTextTyper(true);
    return instant;
  };

  setup.closeSettings = function () {
    var backdrop = document.querySelector("#settings-backdrop");
    if (backdrop) {
      backdrop.classList.remove("open");
      backdrop.setAttribute("aria-hidden", "true");
    }
  };

  setup.toggleSettings = function () {
    createInterface();
    setup.closeInventory();
    var backdrop = document.querySelector("#settings-backdrop");
    if (!backdrop) return;
    var opening = !backdrop.classList.contains("open");
    backdrop.classList.toggle("open", opening);
    backdrop.setAttribute("aria-hidden", opening ? "false" : "true");
    if (opening) setup.updateSettingsPanel();
  };

  function createInterface() {
    if (!document.querySelector("#inventory-toggle")) {
      var controls = document.createElement("div");
      controls.id = "bottom-controls";

      var saveButton = document.createElement("button");
      saveButton.id = "save-toggle";
      saveButton.type = "button";
      saveButton.textContent = "save";

      var journalButton = document.createElement("button");
      journalButton.id = "journal-toggle";
      journalButton.type = "button";
      journalButton.textContent = "journal";

      var button = document.createElement("button");
      button.id = "inventory-toggle";
      button.type = "button";
      button.textContent = "inventory";
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-controls", "inventory-backdrop");

      var settingsButton = document.createElement("button");
      settingsButton.id = "settings-toggle";
      settingsButton.type = "button";
      settingsButton.textContent = "settings";

      var backdrop = document.createElement("div");
      backdrop.id = "inventory-backdrop";
      backdrop.setAttribute("aria-hidden", "true");
      backdrop.innerHTML = `
        <div id="inventory-panel" role="dialog" aria-modal="true" aria-label="Inventory and equipment">
          <div id="inventory-header">
            <div id="inventory-tabs" role="tablist" aria-label="Character items">
              <button type="button" id="inventory-tab" class="inventory-tab active" role="tab">Inventory</button>
              <button type="button" id="equipment-tab" class="inventory-tab" role="tab">Equipment</button>
            </div>
            <div id="inventory-resources"></div>
          </div>
          <div id="inventory-view" class="inventory-view active" role="tabpanel">
            <div id="inventory-body">
              <div id="inventory-list" aria-label="Inventory items"></div>
              <div id="inventory-detail">
                <div id="inventory-detail-name">nothing</div>
                <div id="inventory-detail-description">There is nothing here.</div>
                <div id="inventory-detail-stats"></div>
                <div id="inventory-detail-quantity"></div>
                <div id="inventory-detail-actions">
                  <button type="button" id="inventory-use">Use</button>
                </div>
              </div>
            </div>
          </div>
          <div id="equipment-view" class="inventory-view" role="tabpanel">
            <div id="equipment-mobile-pages" aria-label="Equipment pages">
              <button type="button" id="equipment-items-page" class="active">Items</button>
              <button type="button" id="equipment-overview-page">Stats &amp; gear</button>
            </div>
            <div id="equipment-body">
              <div id="equipment-browser">
                <div id="equipment-list" aria-label="Equipment items"></div>
                <div id="equipment-detail">
                  <div id="equipment-detail-name">nothing</div>
                  <div id="equipment-detail-description">Select an item.</div>
                  <div id="equipment-detail-stats"></div>
                  <button type="button" id="equipment-action">Equip</button>
                </div>
              </div>
              <div id="equipment-overview">
                <div id="character-stats" aria-label="Story stats"></div>
                <div id="equipment-slots" aria-label="Equipped items"></div>
              </div>
            </div>
          </div>
          <div id="inventory-footer">
            <button type="button" id="inventory-close">Close</button>
          </div>
        </div>
      `;

      document.body.appendChild(backdrop);
      controls.appendChild(saveButton);
      controls.appendChild(journalButton);
      controls.appendChild(button);
      controls.appendChild(settingsButton);
      document.body.appendChild(controls);

      saveButton.addEventListener("click", function () {
        setup.saveGame();
      });

      journalButton.addEventListener("click", function () {
        if (setup.combat) return;
        var world = ensureWorldState();
        if (State.passage === "Journal") {
          play(world.journalReturn || "World Place");
          return;
        }
        world.journalReturn = State.passage || "World Place";
        play("Journal");
      });

      button.addEventListener("click", function () {
        setup.toggleInventory();
      });

      settingsButton.addEventListener("click", function () {
        setup.toggleSettings();
      });

      document.querySelector("#inventory-tab").addEventListener("click", function () {
        setup.showInventoryTab("inventory");
      });

      document.querySelector("#equipment-tab").addEventListener("click", function () {
        setup.showInventoryTab("equipment");
      });

      document.querySelector("#equipment-items-page").addEventListener("click", function () {
        setup.showEquipmentPage("items");
      });

      document.querySelector("#equipment-overview-page").addEventListener("click", function () {
        setup.showEquipmentPage("overview");
      });

      document.querySelector("#inventory-close").addEventListener("click", function () {
        setup.closeInventory();
      });

      document.querySelector("#inventory-use").addEventListener("click", function () {
        setup.activateInventoryItem(setup.selectedInventoryKey);
      });

      document.querySelector("#equipment-action").addEventListener("click", function () {
        setup.equipInventoryItem(setup.selectedEquipmentKey);
      });

      backdrop.addEventListener("click", function (event) {
        if (event.target === backdrop) setup.closeInventory();
      });
    }

    if (!document.querySelector("#settings-backdrop")) {
      var settingsBackdrop = document.createElement("div");
      settingsBackdrop.id = "settings-backdrop";
      settingsBackdrop.setAttribute("aria-hidden", "true");
      settingsBackdrop.innerHTML = `
        <div id="settings-panel" role="dialog" aria-modal="true" aria-label="Settings">
          <div class="settings-title">Settings</div>
          <div class="settings-row">
            <span>Text Speed</span>
            <div class="settings-control">
              <button type="button" data-text-speed-cycle>1\u00d7</button>
            </div>
          </div>
          <div class="settings-row">
            <span>Instant Text</span>
            <div class="settings-control">
              <button type="button" data-instant-text-toggle aria-pressed="false">instant</button>
            </div>
          </div>
          <div class="settings-row">
            <span>Screen Shake</span>
            <div class="settings-control">
              <button type="button" data-screen-shake="on">On</button>
              <button type="button" data-screen-shake="off">Off</button>
            </div>
          </div>
          <div class="settings-footer"><button type="button" id="settings-close">Close</button></div>
        </div>
      `;
      document.body.appendChild(settingsBackdrop);
      settingsBackdrop.addEventListener("click", function (event) {
        if (event.target === settingsBackdrop) setup.closeSettings();
      });
      document.querySelector("#settings-close").addEventListener("click", setup.closeSettings);
      Array.from(document.querySelectorAll("[data-text-speed-cycle]")).forEach(function (settingsControl) {
        settingsControl.addEventListener("click", setup.cycleTextSpeed);
      });
      Array.from(document.querySelectorAll("[data-instant-text-toggle]")).forEach(function (settingsControl) {
        settingsControl.addEventListener("click", setup.toggleInstantText);
      });
      Array.from(document.querySelectorAll("[data-screen-shake]")).forEach(function (settingsControl) {
        settingsControl.addEventListener("click", function () {
          setup.savePreferences({ screenShake: settingsControl.getAttribute("data-screen-shake") === "on" });
        });
      });
      setup.updateSettingsPanel();
    }

    if (!document.querySelector("#text-speed-controls")) {
      var speedControls = document.createElement("div");
      speedControls.id = "text-speed-controls";
      speedControls.setAttribute("aria-label", "Text display controls");
      speedControls.innerHTML = '<button type="button" id="text-speed-cycle" data-text-speed-cycle>1\u00d7</button>' +
        '<button type="button" id="text-instant-toggle" data-instant-text-toggle aria-pressed="false">instant</button>';
      document.body.appendChild(speedControls);
      document.querySelector("#text-speed-cycle").addEventListener("click", setup.cycleTextSpeed);
      document.querySelector("#text-instant-toggle").addEventListener("click", setup.toggleInstantText);
      setup.updateSettingsPanel();
    }

    if (!document.querySelector("#notification-log")) {
      var log = document.createElement("div");
      log.id = "notification-log";
      document.body.appendChild(log);
    }
  }

  setup.resourceCatalog = {
    gold: {
      name: "gold",
      description: "Gold coins. The world ended, but prices did not."
    },
    food: {
      name: "food",
      description: "Enough food to keep walking. It does not need to do more."
    },
    water: {
      name: "water",
      description: "It tastes pretty bad. At least it is not purple."
    },
    scrapIron: {
      name: "scrap iron",
      description: "Rusted pieces of metal that might still be usable. Most things do not get a second chance."
    },
    moonCharms: {
      name: "Moon charms",
      description: "Cracked silver charms stamped with a round, faceless Moon. The holes for their cords are worn smooth."
    }
  };

  setup.inventoryCatalog = {
    medicine: {
      name: "medicine",
      kind: "medicine",
      description: "Bandages and bitter powder, clean enough to trust when the alternative is bleeding.",
      action: "use",
      stats: "Restores up to 10 Health."
    },
    staleBread: {
      name: "stale bread",
      kind: "supply",
      resource: "food",
      value: 2,
      action: "use",
      description: "Hard enough to hurt someone with, though eating it is probably the better use. Provides 2 Food when eaten."
    },
    sealedFoodTin: {
      name: "sealed food tin",
      kind: "supply",
      resource: "food",
      value: 4,
      action: "use",
      description: "The label is gone, but the seal held. Whatever is inside has been waiting longer than you have. Provides 4 Food when eaten."
    },
    winterRoot: {
      name: "winter root",
      kind: "supply",
      resource: "food",
      value: 1,
      action: "use",
      description: "A pale, bitter root stubborn enough to grow beneath frozen earth. Provides 1 Food when eaten."
    },
    settlementBread: {
      name: "settlement bread",
      kind: "supply",
      resource: "food",
      value: 3,
      action: "use",
      description: "Fresh by current standards. Nobody asks too many questions about those standards. Provides 3 Food when eaten."
    },
    waterskin: {
      name: "old waterskin",
      kind: "supply",
      resource: "water",
      value: 5,
      action: "use",
      description: "The leather is cracked, and the water tastes like it. Water is water. Provides 5 Water when drunk."
    },
    snowmeltFlask: {
      name: "snowmelt flask",
      kind: "supply",
      resource: "water",
      value: 3,
      action: "use",
      description: "Melted snow in a stoppered flask, cold enough to make your teeth hurt. Provides 3 Water when drunk."
    },
    riverJar: {
      name: "river jar",
      kind: "supply",
      resource: "water",
      value: 4,
      action: "use",
      description: "Cloudy river water in a chipped jar. Whatever is floating in it could be worse. Provides 4 Water when drunk."
    },
    scrapIronPieces: {
      name: "scrap iron piece",
      kind: "supply",
      resource: "scrapIron",
      value: 1,
      action: "use",
      description: "A rusted piece of metal with one useful shape left in it. Adds 1 Scrap Iron when sorted."
    },
    bentArrowheads: {
      name: "bent arrowheads",
      kind: "supply",
      resource: "scrapIron",
      value: 1,
      action: "use",
      description: "Bent beyond shooting straight, but still metal and still sharp in the wrong places. Adds 1 Scrap Iron when sorted."
    },
    tulip: {
      name: "tulip",
      kind: "special",
      description: "A red tulip wrapped with the soil around its roots. The petals are soft. The soil stays warm inside the cloth."
    },
    silentBell: {
      name: "silent bell",
      kind: "special",
      description: "The bell still has its clapper. Verdigris covers every surface except the place a thumb would rest."
    },
    whiteAntler: {
      name: "white antler",
      kind: "special",
      description: "Cold bone from something that should have stayed deeper in the forest."
    },
    frostBearClaw: {
      name: "frost bear claw",
      kind: "special",
      description: "Heavy, pale, and sharp enough to remember what it was attached to."
    },
    goblinChiefSpear: {
      name: "Goblin Chief's Spear",
      kind: "weapon",
      action: "equip",
      description: "A crude spear made from stolen steel and wood worn smooth by years of use. Proof that you reached the chief and left with something he wanted to keep.",
      stats: "Weapon. Quest proof."
    },
    northernFieldWrap: {
      name: "northern field wrap",
      kind: "armor",
      slot: "body",
      resistance: 1,
      action: "equip",
      description: "Layers of wool and hide sewn by someone who understood the cold. It will not stop much, but it might stop enough.",
      stats: "Body. Resistance 1."
    },
    watchmanCoat: {
      name: "watchman's coat",
      kind: "armor",
      slot: "body",
      resistance: 2,
      action: "equip",
      description: "A heavy coat with old city colors beneath the dirt. One elbow has been patched three times with three different fabrics.",
      stats: "Body. Resistance 2."
    },
    oldMail: {
      name: "old mail shirt",
      kind: "armor",
      slot: "body",
      resistance: 3,
      action: "equip",
      description: "Iron rings darkened by rust and old blood. It is heavy, loud, and harder to bite through than skin.",
      stats: "Body. Resistance 3."
    },
    hunterKnife: {
      name: "hunter's knife",
      kind: "weapon",
      action: "equip",
      description: "A short, broad knife made for skinning animals. It works on monsters too, if you push hard enough.",
      stats: "Weapon. Cannot replace the Old Sword."
    },
    gateSword: {
      name: "academy practice blade",
      kind: "weapon",
      action: "equip",
      description: "A dull training sword from the Northern Academy of Heroes. Initials cover the grip beneath several layers of replacement leather.",
      stats: "Weapon. Cannot replace the Old Sword."
    },
    oldSword: {
      name: "old sword",
      kind: "weapon",
      action: "equip",
      description: "Rust crawls along the blade, and the leather around the handle is almost gone. It has survived longer than most people, which does not make it good.",
      stats: "Locked weapon. Base damage 3."
    }
  };

  function inventoryEntries() {
    ensureState();

    var v = State.variables;
    var entries = [];

    Object.keys(setup.resourceCatalog).forEach(function (key) {
      var def = setup.resourceCatalog[key];
      entries.push({
        key: key,
        name: def.name,
        description: def.description,
        count: v.inventory[key] || 0,
        action: null,
        stats: ""
      });
    });

    Object.keys(setup.inventoryCatalog).forEach(function (key) {
      var def = setup.inventoryCatalog[key];
      var count = v.inventory[key] || 0;
      if (count > 0) {
        entries.push({
          key: key,
          name: def.name,
          description: def.description,
          count: count,
          action: def.action || null,
          stats: def.stats || ""
        });
      }
    });

    return entries;
  }

  function equipmentEntries() {
    return inventoryEntries().filter(function (entry) {
      var def = setup.inventoryCatalog[entry.key];
      return def && (def.kind === "armor" || def.kind === "weapon");
    });
  }

  function selectedInventoryEntry(entries) {
    for (var i = 0; i < entries.length; i += 1) {
      if (entries[i].key === setup.selectedInventoryKey) return entries[i];
    }
    return entries[0] || null;
  }

  setup.closeInventory = function () {
    var backdrop = document.querySelector("#inventory-backdrop");
    var toggle = document.querySelector("#inventory-toggle");
    if (backdrop) {
      backdrop.classList.remove("open");
      backdrop.setAttribute("aria-hidden", "true");
    }
    if (toggle) toggle.setAttribute("aria-expanded", "false");
  };

  setup.showInventoryTab = function (tabName) {
    setup.inventoryTab = tabName === "equipment" ? "equipment" : "inventory";
    var inventoryTab = document.querySelector("#inventory-tab");
    var equipmentTab = document.querySelector("#equipment-tab");
    var inventoryView = document.querySelector("#inventory-view");
    var equipmentView = document.querySelector("#equipment-view");
    if (inventoryTab) inventoryTab.classList.toggle("active", setup.inventoryTab === "inventory");
    if (equipmentTab) equipmentTab.classList.toggle("active", setup.inventoryTab === "equipment");
    if (inventoryView) inventoryView.classList.toggle("active", setup.inventoryTab === "inventory");
    if (equipmentView) equipmentView.classList.toggle("active", setup.inventoryTab === "equipment");
    if (setup.inventoryTab === "equipment") setup.showEquipmentPage(setup.equipmentPage || "items");
    setup.updateInventory();
  };

  setup.showEquipmentPage = function (pageName) {
    setup.equipmentPage = pageName === "overview" ? "overview" : "items";
    var body = document.querySelector("#equipment-body");
    var items = document.querySelector("#equipment-items-page");
    var overview = document.querySelector("#equipment-overview-page");
    if (body) body.classList.toggle("mobile-overview", setup.equipmentPage === "overview");
    if (items) items.classList.toggle("active", setup.equipmentPage === "items");
    if (overview) overview.classList.toggle("active", setup.equipmentPage === "overview");
    return setup.equipmentPage;
  };

  setup.toggleInventory = function () {
    createInterface();
    var backdrop = document.querySelector("#inventory-backdrop");
    var toggle = document.querySelector("#inventory-toggle");
    if (!backdrop) return;

    var opening = !backdrop.classList.contains("open");
    if (opening) {
      backdrop.classList.add("open");
      backdrop.setAttribute("aria-hidden", "false");
      if (toggle) toggle.setAttribute("aria-expanded", "true");
      setup.showInventoryTab(setup.inventoryTab || "inventory");
      setup.updateInventory();
    } else {
      setup.closeInventory();
    }
  };

  setup.selectInventoryItem = function (key) {
    setup.selectedInventoryKey = key;
    setup.updateInventory();
  };

  setup.selectEquipmentItem = function (key) {
    setup.selectedEquipmentKey = key;
    setup.updateInventory();
  };

  setup.consumeSupply = function (key, options) {
    ensureState();
    options = options || {};
    var v = State.variables;
    var def = setup.inventoryCatalog[key];
    if (!def || def.kind !== "supply" || v.inventory[key] <= 0) return false;

    v.inventory[key] -= 1;
    v.inventory[def.resource] += def.value;
    v.resourceWarnings[def.resource + "AcknowledgedAt"] = null;
    notify(
      "consumed " + def.name + ". " + def.value + " " + def.resource.replace("Iron", " iron") + " gained",
      { duration: ITEM_NOTIFICATION_MS }
    );
    setup.updateInventory();
    if (options.closeModal) {
      var modal = document.querySelector("#resource-warning-modal");
      if (modal) modal.remove();
    }
    return true;
  };

  setup.useInventoryItem = function (key) {
    ensureState();

    var v = State.variables;
    var def = setup.inventoryCatalog[key];
    if (def && def.kind === "supply") return setup.consumeSupply(key);
    if (key !== "medicine" || v.inventory.medicine <= 0) return false;

    if (v.player.hp >= v.player.maxHp) {
      notify("you are already at full health");
      return false;
    }

    var healed = Math.min(10, v.player.maxHp - v.player.hp);
    v.inventory.medicine -= 1;
    v.player.hp += healed;
    notify("medicine used. " + healed + " health restored", { duration: ITEM_NOTIFICATION_MS });
    setup.updateInventory();
    return true;
  };

  setup.activateInventoryItem = function (key) {
    var def = setup.inventoryCatalog[key];
    if (!def) return false;
    if (def.action === "use") return setup.useInventoryItem(key);
    if (def.action === "equip") return setup.equipInventoryItem(key);
    return false;
  };

  setup.syncEquipmentStats = function () {
    if (!State || !State.variables) return;
    var v = State.variables;
    if (!v.equipment) return;
    var body = setup.inventoryCatalog && setup.inventoryCatalog[v.equipment.body];
    v.armor = body
      ? { name: body.name, resistance: body.resistance || body.defense || 0 }
      : { name: "none", resistance: 0 };
    if (v.hasSword || v.equipment.oldSword === "oldSword") {
      v.hasSword = true;
      v.equipment.oldSword = "oldSword";
      v.weapon = { name: "old sword", level: (v.weapon && v.weapon.level) || 0, baseDamage: 3 };
    }
  };

  setup.shakeGame = function () {
    if (!setup.getPreferences().screenShake) return;
    var target = document.querySelector("#story") || document.body;
    target.classList.remove("lore-shake");
    void target.offsetWidth;
    target.classList.add("lore-shake");
    setTimeout(function () {
      target.classList.remove("lore-shake");
    }, 420);
  };

  setup.equipInventoryItem = function (key) {
    ensureState();
    var v = State.variables;
    var def = setup.inventoryCatalog[key];
    if (!def || v.inventory[key] <= 0) return false;

    if (def.kind === "weapon") {
      setup.shakeGame();
      notify(WEAPON_REJECTION, { duration: ITEM_NOTIFICATION_MS });
      return false;
    }

    if (def.kind !== "armor" || !def.slot) return false;
    var oldKey = v.equipment[def.slot];
    if (oldKey === key) return true;
    v.inventory[key] -= 1;
    if (oldKey) v.inventory[oldKey] = (v.inventory[oldKey] || 0) + 1;
    v.equipment[def.slot] = key;
    setup.syncEquipmentStats();
    notify(def.name + " equipped");
    setup.updateInventory();
    return true;
  };

  setup.updateInventory = function () {
    ensureState();
    createInterface();

    var list = document.querySelector("#inventory-list");
    if (!list) return;

    var entries = inventoryEntries();
    var selected = selectedInventoryEntry(entries);
    setup.selectedInventoryKey = selected ? selected.key : null;
    list.innerHTML = "";

    entries.forEach(function (entry) {
      var button = document.createElement("button");
      button.type = "button";
      button.className = "inventory-item";
      if (selected && entry.key === selected.key) button.classList.add("selected");
      button.textContent = entry.name + (entry.count === null ? "" : "  " + entry.count);
      button.addEventListener("click", function () {
        setup.selectInventoryItem(entry.key);
      });
      list.appendChild(button);
    });

    var resources = document.querySelector("#inventory-resources");
    var name = document.querySelector("#inventory-detail-name");
    var description = document.querySelector("#inventory-detail-description");
    var stats = document.querySelector("#inventory-detail-stats");
    var quantity = document.querySelector("#inventory-detail-quantity");
    var useButton = document.querySelector("#inventory-use");

    if (resources) {
      resources.textContent =
        "gold: " + State.variables.inventory.gold +
        " | food: " + State.variables.inventory.food +
        " | water: " + State.variables.inventory.water;
    }

    setup.renderCharacterStats();

    if (!selected) {
      if (name) name.textContent = "nothing";
      if (description) description.textContent = "There is nothing here.";
      if (stats) stats.textContent = "";
      if (quantity) quantity.textContent = "";
      if (useButton) useButton.style.display = "none";
      return;
    }

    if (name) name.textContent = selected.name;
    if (description) description.textContent = selected.description;
    if (stats) stats.textContent = selected.stats || "";
    if (quantity) {
      quantity.textContent = selected.count === null ? "" : "quantity: " + selected.count;
    }
    if (useButton) {
      useButton.style.display = selected.action ? "inline-flex" : "none";
      useButton.textContent = selected.action === "equip" ? "Equip" : "Use";
    }

    var equipList = document.querySelector("#equipment-list");
    if (equipList) {
      var equipEntries = equipmentEntries();
      var equipSelected = selectedInventoryEntry.call(null, equipEntries);
      if (
        !setup.selectedEquipmentKey ||
        !equipEntries.some(function (entry) { return entry.key === setup.selectedEquipmentKey; })
      ) {
        setup.selectedEquipmentKey = equipEntries.length ? equipEntries[0].key : null;
      }
      equipSelected = equipEntries.find(function (entry) {
        return entry.key === setup.selectedEquipmentKey;
      }) || null;
      equipList.innerHTML = "";
      equipEntries.forEach(function (entry) {
        var equipButton = document.createElement("button");
        equipButton.type = "button";
        equipButton.className = "inventory-item";
        if (equipSelected && equipSelected.key === entry.key) equipButton.classList.add("selected");
        equipButton.textContent = entry.name + "  " + entry.count;
        equipButton.addEventListener("click", function () {
          setup.selectEquipmentItem(entry.key);
        });
        equipList.appendChild(equipButton);
      });

      var equipName = document.querySelector("#equipment-detail-name");
      var equipDescription = document.querySelector("#equipment-detail-description");
      var equipStats = document.querySelector("#equipment-detail-stats");
      var equipAction = document.querySelector("#equipment-action");
      if (equipName) equipName.textContent = equipSelected ? equipSelected.name : "nothing";
      if (equipDescription) {
        equipDescription.textContent = equipSelected ? equipSelected.description : "No equipment items carried.";
      }
      if (equipStats) equipStats.textContent = equipSelected ? equipSelected.stats : "";
      if (equipAction) {
        equipAction.style.display = equipSelected ? "inline-flex" : "none";
        equipAction.textContent = "Equip";
      }
    }

    setup.renderEquipmentSlots();
  };

  setup.renderEquipmentSlots = function () {
    var root = document.querySelector("#equipment-slots");
    if (!root) return;
    var v = State.variables;
    var slots = [
      ["head", "Head"],
      ["body", "Body"],
      ["feet", "Feet"],
      ["ring", "Ring"],
      ["oldSword", "Old Sword"]
    ];
    root.innerHTML = "";
    slots.forEach(function (pair) {
      var key = v.equipment[pair[0]];
      var def = key ? setup.inventoryCatalog[key] : null;
      var row = document.createElement("div");
      row.className = "equipment-slot";
      if (pair[0] === "oldSword") row.classList.add("locked");
      row.innerHTML =
        '<span class="equipment-slot-label">' + pair[1] + '</span>' +
        '<span class="equipment-slot-value">' +
        escapeHtml(def ? def.name : "Empty") +
        (pair[0] === "oldSword" ? " · Locked" : "") +
        "</span>";
      root.appendChild(row);
    });
  };

  setup.renderCharacterStats = function () {
    var root = document.querySelector("#character-stats");
    if (!root) return;
    ensureState();
    var v = State.variables;
    var definitions = [
      { key: "strength", label: "Strength", effect: function () {
        return "+" + Math.max(0, v.stats.strength.level - 1) + " attack damage | " +
          (attackCooldownMs() / 1000).toFixed(2) + "s Attack";
      } },
      { key: "agility", label: "Agility", effect: function () {
        return (dodgeCooldownMs() / 1000).toFixed(2) + "s Dodge";
      } },
      { key: "defense", label: "Defense", effect: function () {
        return (parryCooldownMs() / 1000).toFixed(2) + "s Parry";
      } },
      { key: "resistance", label: "Resistance", effect: function () {
        var reduction = Math.floor(Math.max(0, v.stats.resistance.level - 1) / 3);
        return reduction ? "-" + reduction + " incoming damage" : "0 damage reduction";
      } }
    ];
    root.innerHTML = definitions.map(function (definition) {
      var stat = v.stats[definition.key];
      var progress = stat.level >= STAT_LEVEL_CAP
        ? "MAX"
        : stat.exp + " / " + stat.next + " story EXP";
      return '<div class="character-stat">' +
        '<div class="character-stat-name"><span>' + definition.label + '</span><span>Lv ' + stat.level + '</span></div>' +
        '<div class="character-stat-progress">' + progress + '</div>' +
        '<div class="character-stat-effect">' + definition.effect() + '</div>' +
        '</div>';
    }).join("");
  };

  setup.updateInterfaceAvailability = function () {
    var controls = document.querySelector("#bottom-controls");
    var speedControls = document.querySelector("#text-speed-controls");
    var saveButton = document.querySelector("#save-toggle");
    var journalButton = document.querySelector("#journal-toggle");
    var onWelcome = State.passage === "Welcome";
    if (controls) controls.style.display = onWelcome ? "none" : "flex";
    if (speedControls) speedControls.style.display = onWelcome || Boolean(setup.combat) ? "none" : "flex";
    if (saveButton) saveButton.disabled = !setup.canSave();
    if (journalButton) journalButton.disabled = Boolean(setup.combat);
    document.body.classList.toggle("welcome-screen", onWelcome);
  };

  setup.items = {
    staleBread: { name: "stale bread", catalogKey: "staleBread" },
    sealedFoodTin: { name: "sealed food tin", catalogKey: "sealedFoodTin" },
    winterRoot: { name: "winter root", catalogKey: "winterRoot" },
    settlementBread: { name: "settlement bread", catalogKey: "settlementBread" },
    waterskin: { name: "old waterskin", catalogKey: "waterskin" },
    snowmeltFlask: { name: "snowmelt flask", catalogKey: "snowmeltFlask" },
    riverJar: { name: "river jar", catalogKey: "riverJar" },
    scrapIron: { name: "scrap iron piece", catalogKey: "scrapIronPieces" },
    bentArrowheads: { name: "bent arrowheads", catalogKey: "bentArrowheads" },
    crackedMoonCharm: { name: "cracked Moon charm", resource: "moonCharms", value: 1 },
    charm: { name: "cracked Moon charm", resource: "moonCharms", value: 1 },
    moonCharm: { name: "cracked Moon charm", resource: "moonCharms", value: 1 },
    medicinePouch: { name: "medicine pouch", catalogKey: "medicine" },
    tulip: { name: "tulip", catalogKey: "tulip" },
    silentBell: { name: "silent bell", catalogKey: "silentBell" },
    whiteAntler: { name: "white antler", catalogKey: "whiteAntler" },
    frostBearClaw: { name: "frost bear claw", catalogKey: "frostBearClaw" },
    goblinChiefSpear: { name: "Goblin Chief's Spear", catalogKey: "goblinChiefSpear" },
    northernFieldWrap: { name: "northern field wrap", catalogKey: "northernFieldWrap" },
    watchmanCoat: { name: "watchman's coat", catalogKey: "watchmanCoat" },
    oldMail: { name: "old mail shirt", catalogKey: "oldMail" },
    hunterKnife: { name: "hunter's knife", catalogKey: "hunterKnife" },
    gateSword: { name: "academy practice blade", catalogKey: "gateSword" }
  };

  function applyItem(itemKey) {
    ensureState();

    var v = State.variables;
    var item = setup.items[itemKey];
    if (!item) return false;

    if (item.resource) {
      v.inventory[item.resource] += item.value || 1;
    } else {
      var field = item.catalogKey || itemKey;
      if (typeof v.inventory[field] !== "number") v.inventory[field] = 0;
      v.inventory[field] += item.value || 1;
    }

    return true;
  }

  setup.takeItem = function (itemKey, options) {
    ensureState();

    if (typeof options === "string") {
      options = { flag: options };
    }

    options = options || {};
    var flag = options.flag || null;
    var item = setup.items[itemKey];

    if (!item) {
      notify("missing item: " + itemKey);
      return false;
    }

    if (flag && State.variables.taken[flag]) {
      if (options.returnPassage) play(options.returnPassage);
      return false;
    }

    applyItem(itemKey);
    if (flag) State.variables.taken[flag] = true;

    setup.updateInventory();
    if (options.message !== false) {
      notify(options.message || item.name + " taken", { duration: ITEM_NOTIFICATION_MS });
    }
    if (options.returnPassage) play(options.returnPassage);

    return true;
  };

  setup.take = setup.takeItem;
  setup.takeInventoryItem = setup.takeItem;

  setup.receiveLoot = function (loot, options) {
    ensureState();

    options = options || {};
    if (!loot) return false;

    if (typeof loot === "string") {
      setup.takeItem(loot, { message: options.message });
      return true;
    }

    if (Array.isArray(loot)) {
      loot.forEach(function (entry) {
        setup.receiveLoot(entry, { message: false });
      });
      setup.updateInventory();
      if (options.message !== false) {
        notify(options.message || "loot taken", { duration: ITEM_NOTIFICATION_MS });
      }
      return true;
    }

    Object.keys(loot).forEach(function (key) {
      if (setup.items[key]) {
        var amount = loot[key];
        for (var i = 0; i < amount; i++) applyItem(key);
      } else {
        if (typeof State.variables.inventory[key] !== "number") State.variables.inventory[key] = 0;
        State.variables.inventory[key] += loot[key];
      }
    });

    setup.updateInventory();
    if (options.message !== false) {
      notify(options.message || "loot taken", { duration: ITEM_NOTIFICATION_MS });
    }
    return true;
  };

  function normalizedLoot(loot) {
    var totals = {};
    if (!loot) return [];
    if (typeof loot === "string") {
      totals[loot] = 1;
    } else if (Array.isArray(loot)) {
      loot.forEach(function (entry) {
        normalizedLoot(entry).forEach(function (part) {
          totals[part.key] = (totals[part.key] || 0) + part.amount;
        });
      });
    } else {
      Object.keys(loot).forEach(function (key) {
        totals[key] = (totals[key] || 0) + Math.max(0, Number(loot[key]) || 0);
      });
    }
    return Object.keys(totals).filter(function (key) {
      return totals[key] > 0;
    }).map(function (key) {
      return { key: key, amount: totals[key] };
    });
  }

  function lootDefinition(key) {
    if (setup.resourceCatalog[key]) return setup.resourceCatalog[key];
    if (setup.inventoryCatalog[key]) return setup.inventoryCatalog[key];
    var item = setup.items[key];
    if (item) {
      if (item.catalogKey && setup.inventoryCatalog[item.catalogKey]) {
        return setup.inventoryCatalog[item.catalogKey];
      }
      if (item.resource && setup.resourceCatalog[item.resource]) {
        return setup.resourceCatalog[item.resource];
      }
      return item;
    }
    return { name: key, description: "You do not know exactly what it is for yet. Useful will have to be enough." };
  }

  function lootRowsHtml(loot) {
    return normalizedLoot(loot).map(function (entry, index) {
      var def = lootDefinition(entry.key);
      return '<button type="button" class="reward-loot-row" data-loot-index="' + index + '">' +
        '<span>' + escapeHtml(def.name || entry.key) + '</span><span>×' + entry.amount + "</span></button>";
    }).join("");
  }

  function wireLootDetails(root, loot, detailSelector) {
    var entries = normalizedLoot(loot);
    var detail = root.querySelector(detailSelector);
    Array.from(root.querySelectorAll(".reward-loot-row")).forEach(function (row) {
      var show = function () {
        var entry = entries[Number(row.getAttribute("data-loot-index")) || 0];
        var def = lootDefinition(entry.key);
        if (detail) {
          detail.textContent = (def.description || "") + (def.stats ? " " + def.stats : "");
        }
      };
      row.addEventListener("mouseenter", show);
      row.addEventListener("focus", show);
      row.addEventListener("click", show);
    });
  }

  setup.openLootPopup = function (options) {
    ensureState();
    options = options || {};
    var loot = options.loot || {};
    State.variables.pendingReward = {
      kind: "loot",
      title: options.title || "Found",
      flavor: options.flavor || "It is still useful, which is enough reason to carry it.",
      loot: clone(loot),
      action: options.action || null
    };
    setup.closeInventory();

    var old = document.querySelector("#reward-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "reward-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box reward-box" role="dialog" aria-modal="true" aria-label="Loot found">
        <div class="modal-title">${escapeHtml(State.variables.pendingReward.title)}</div>
        <div class="modal-text reward-flavor">${escapeHtml(State.variables.pendingReward.flavor)}</div>
        <div class="reward-loot-list">${lootRowsHtml(loot)}</div>
        <div class="reward-detail" aria-live="polite">Hover over or tap an item to inspect it.</div>
        <div class="modal-actions"><button class="modal-button" id="reward-take">Take</button></div>
      </div>
    `;
    document.body.appendChild(backdrop);
    wireLootDetails(backdrop, loot, ".reward-detail");
    document.querySelector("#reward-take").addEventListener("click", function () {
      var pending = State.variables.pendingReward;
      if (!pending || pending.kind !== "loot") return;
      var take = document.querySelector("#reward-take");
      if (take) take.disabled = true;
      setup.receiveLoot(pending.loot, { message: "loot taken" });
      var action = pending.action;
      State.variables.pendingReward = null;
      backdrop.remove();
      if (action && action.type === "dungeonItem") {
        var room = currentDungeonRoom();
        if (room) room.itemTaken = true;
        setup.renderDungeon();
      } else if (action && action.type === "dungeonChest") {
        if (State.variables.dungeon) State.variables.dungeon.chestLooted = true;
        setup.renderDungeon();
      } else if (action && action.type === "search") {
        State.variables.taken[action.flag] = true;
        if (action.returnPassage) play(action.returnPassage);
      } else if (action && action.type === "settlementSearch") {
        State.variables.generatedSettlementVisits[action.flag] = true;
        setup.renderGeneratedSettlement();
      }
    });
    return true;
  };

  setup.searchLoot = function (flag, loot, flavor, returnPassage) {
    ensureState();
    if (State.variables.taken[flag]) {
      notify("nothing else there");
      if (returnPassage) play(returnPassage);
      return false;
    }
    return setup.openLootPopup({
      title: "Found",
      flavor: flavor,
      loot: loot,
      action: { type: "search", flag: flag, returnPassage: returnPassage || State.passage }
    });
  };

  setup.spendGold = function (amount) {
    ensureState();

    amount = Math.max(0, Math.floor(Number(amount) || 0));
    if (State.variables.inventory.gold < amount) {
      notify("not enough gold");
      return false;
    }

    State.variables.inventory.gold -= amount;
    setup.updateInventory();
    return true;
  };

  setup.bribeLordsRestGuard = function () {
    ensureState();

    if (!setup.spendGold(20)) return false;

    State.variables.lordsRest.accessGranted = true;
    State.variables.lordsRest.accessMethod = "bribe";
    play("Lord's Rest - Gate");
    return true;
  };

  setup.pleadWithLordsRestGuard = function () {
    ensureState();
    State.variables.lordsRest.pleaded = true;
    play("Lord's Rest - Guard Plea");
    return true;
  };

  setup.grantLoot = setup.receiveLoot;

  setup.takeSword = function () {
    ensureState();

    var v = State.variables;
    if (v.hasSword || v.taken.oldSword) {
      play("Shelter");
      return false;
    }

    v.hasSword = true;
    v.weapon = { name: "old sword", level: v.weapon.level || 0, baseDamage: 3 };
    v.inventory.oldSword = Math.max(1, v.inventory.oldSword);
    v.equipment.oldSword = "oldSword";
    v.taken.oldSword = true;

    setup.updateInventory();
    notify("old sword taken", { duration: ITEM_NOTIFICATION_MS });
    play("Shelter");
    return true;
  };

  setup.takeStaleBread = function () {
    ensureState();

    var v = State.variables;
    if (v.tookStaleBread || v.taken.staleBreadAndWaterskin) {
      play("Shelter");
      return false;
    }

    v.inventory.staleBread += 1;
    v.inventory.waterskin += 1;
    v.tookStaleBread = true;
    v.taken.staleBreadAndWaterskin = true;

    setup.updateInventory();
    notify("stale bread and old waterskin packed", { duration: ITEM_NOTIFICATION_MS });
    play("Shelter");
    return true;
  };

  setup.takeCharm = function () {
    return setup.takeItem("crackedMoonCharm");
  };

  function replaceTakeLinkWithAction(action) {
    var passage = passageEl();
    if (!passage) return;

    var links = Array.from(passage.querySelectorAll("a"));
    var takeLink = links.find(function (link) {
      return link.textContent.trim().toLowerCase() === "take";
    });

    if (!takeLink) return;

    var cloneLink = takeLink.cloneNode(true);
    cloneLink.href = "javascript:void(0)";
    cloneLink.removeAttribute("data-passage");
    cloneLink.removeAttribute("data-setter");
    cloneLink.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      action();
    });

    takeLink.replaceWith(cloneLink);
  }

  function patchKnownTakeLinks() {
    if (State.passage === "Sword") replaceTakeLinkWithAction(setup.takeSword);
    if (State.passage === "Stale Bread" || State.passage === "StaleBread" || State.passage === "Stale bread") {
      replaceTakeLinkWithAction(setup.takeStaleBread);
    }
  }

  function getDirectChildOfPassage(node, passage) {
    var current = node;
    while (current && current.parentElement !== passage) current = current.parentElement;
    return current || node;
  }

  setup.layoutChoices = function () {
    var passage = passageEl();
    if (!passage || passage.querySelector(".choice-grid:not(.manual)")) return;

    var links = Array.from(passage.querySelectorAll("a.link-internal")).filter(function (link) {
      return !link.classList.contains("no-choice-layout");
    });

    if (links.length === 0) return;

    var grid = document.createElement("div");
    grid.className = "choice-grid";
    grid.classList.add(links.length <= 4 ? "choice-count-" + links.length : "choice-count-many");

    passage.insertBefore(grid, getDirectChildOfPassage(links[0], passage));

    links.forEach(function (link) {
      var oldParent = link.parentElement;
      grid.appendChild(link);
      if (oldParent && oldParent !== passage && oldParent.textContent.trim() === "") oldParent.remove();
    });
  };

  function checkpointState() {
    ensureState();
    var snapshot = clone(State.variables);
    delete snapshot.checkpoints;
    delete snapshot.pendingDefeat;
    return snapshot;
  }

  function restoreCheckpoint(snapshot) {
    if (!snapshot) return false;
    var tutorialSeen = Boolean(State.variables.combatTutorialSeen);
    var permanentStats = clone(State.variables.stats || {});
    var permanentStatEvents = clone(State.variables.storyStatEvents || {});
    Object.keys(State.variables).forEach(function (key) {
      delete State.variables[key];
    });
    var restored = clone(snapshot);
    restored.combatTutorialSeen = tutorialSeen || Boolean(restored.combatTutorialSeen);
    restored.stats = permanentStats;
    restored.storyStatEvents = permanentStatEvents;
    Object.keys(restored).forEach(function (key) {
      State.variables[key] = restored[key];
    });
    ensureState();
    return true;
  }

  setup.beginExpedition = function () {
    ensureState();
    State.variables.checkpoints.expedition = checkpointState();
    State.variables.checkpoints.dungeon = null;
    State.variables.resourceWarnings.foodAcknowledgedAt = null;
    State.variables.resourceWarnings.waterAcknowledgedAt = null;
    State.variables.resourceWarnings.queuedWater = false;
    return true;
  };

  setup.beginDungeonCheckpoint = function () {
    ensureState();
    State.variables.checkpoints.dungeon = checkpointState();
    return true;
  };

  setup.commitTownProgress = function () {
    ensureState();
    State.variables.checkpoints.expedition = null;
    State.variables.checkpoints.dungeon = null;
    State.variables.resourceWarnings.foodAcknowledgedAt = null;
    State.variables.resourceWarnings.waterAcknowledgedAt = null;
    State.variables.resourceWarnings.queuedWater = false;
  };

  setup.closeTransientModals = function () {
    [
      "#resource-warning-modal",
      "#supply-chooser-modal",
      "#defeat-modal",
      "#reward-modal",
      "#map-event-modal",
      "#trader-modal",
      "#settlement-modal"
    ].forEach(function (selector) {
      var modal = document.querySelector(selector);
      if (modal) modal.remove();
    });
    setup.closeSettings();
  };

  setup.requestDefeat = function (checkpointType) {
    ensureState();
    var v = State.variables;
    if (v.pendingDefeat) return false;

    checkpointType = checkpointType === "dungeon" ? "dungeon" : "expedition";
    v.pendingDefeat = { checkpointType: checkpointType };
    setup.closeInventory();
    if (setup.combat) endCombat();

    var old = document.querySelector("#defeat-modal");
    if (old) old.remove();

    var backdrop = document.createElement("div");
    backdrop.id = "defeat-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box defeat-box" role="alertdialog" aria-modal="true" aria-label="Defeated">
        <div class="modal-text">Not looking good..</div>
        <div class="modal-actions">
          <button class="modal-button" id="defeat-run">Run</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);

    var run = document.querySelector("#defeat-run");
    run.addEventListener("click", function () {
      run.disabled = true;
      setup.resolveDefeat();
    });
    return true;
  };

  setup.resolveDefeat = function () {
    ensureState();
    var pending = State.variables.pendingDefeat;
    if (!pending) return false;

    var checkpointType = pending.checkpointType;
    var checkpoint = State.variables.checkpoints[checkpointType];
    if (!checkpoint && checkpointType === "dungeon") {
      checkpoint = State.variables.checkpoints.expedition;
    }
    var hasSavedCheckpoint = Boolean(checkpoint);
    if (!checkpoint) checkpoint = checkpointState();

    restoreCheckpoint(checkpoint);
    var v = State.variables;
    var town = lastTownPlace();
    v.pendingDefeat = null;
    v.dungeon = null;
    v.combatContext = null;
    v.pendingReward = null;
    v.activeMapEvent = null;
    v.checkpoints.expedition = null;
    v.checkpoints.dungeon = null;
    v.currentPlaceKey = town.code;
    v.lastTownKey = town.code;
    v.map.x = town.coord[0];
    v.map.y = town.coord[1];
    if (!hasSavedCheckpoint) {
      v.player.hp = Math.max(1, Math.floor(v.player.maxHp / 2));
    }
    v.pendingTownWakeMessage = DEFEAT_MESSAGE;
    setup.closeTransientModals();
    play(town.respawnPassage || town.passage);
    return true;
  };

  setup.canSave = function () {
    ensureState();
    var browserSlots = typeof Save !== "undefined" && Save.browser && Save.browser.slot;
    var legacySlots = typeof Save !== "undefined" && Save.slots;
    return Boolean(
      (browserSlots || legacySlots) &&
      State.passage !== "Welcome" &&
      !setup.combat &&
      !State.variables.pendingDefeat &&
      !State.variables.pendingReward &&
      !State.variables.activeMapEvent &&
      !document.querySelector("#resource-warning-modal") &&
      !document.querySelector("#supply-chooser-modal") &&
      !document.querySelector("#settings-backdrop.open")
    );
  };

  function liveSaveMetadata() {
    return {
      atfbBuild: setup.__afterFinalBattleBuild,
      atfbPassage: State.passage,
      atfbLiveVariables: JSON.parse(JSON.stringify(State.variables))
    };
  }

  function restoreLiveSave(descriptor) {
    var snapshot = descriptor && descriptor.metadata && descriptor.metadata.atfbLiveVariables;
    if (!snapshot || typeof snapshot !== "object") return false;

    var variables = State.variables;
    Object.keys(variables).forEach(function (key) {
      delete variables[key];
    });
    Object.keys(snapshot).forEach(function (key) {
      variables[key] = snapshot[key];
    });
    ensureState();
    return true;
  }

  setup.saveGame = function () {
    if (!setup.canSave()) {
      notify("cannot save right now");
      return false;
    }

    setup.closeInventory();
    try {
      var metadata = liveSaveMetadata();
      var result = Save.browser && Save.browser.slot
        ? Save.browser.slot.save(0, "After the Final Battle", metadata)
        : Save.slots.save(0, "After the Final Battle", metadata);
      if (result && typeof result.then === "function") {
        result.then(function () {
          notify("game saved");
        }).catch(function () {
          notify("save failed");
        });
      } else {
        notify("game saved");
      }
      return true;
    } catch (error) {
      console.error(error);
      notify("save failed");
      return false;
    }
  };

  setup.hasSave = function () {
    try {
      if (typeof Save === "undefined") return false;
      if (Save.browser && Save.browser.slot) return Boolean(Save.browser.slot.has(0));
      return Boolean(Save.slots && Save.slots.has(0));
    } catch (error) {
      return false;
    }
  };

  setup.continueGame = function () {
    if (!setup.hasSave()) return setup.newGame();
    try {
      var modernSlots = Save.browser && Save.browser.slot;
      var descriptor = modernSlots ? modernSlots.get(0) : Save.slots.get(0);
      var result = modernSlots ? modernSlots.load(0) : Save.slots.load(0);
      var finishLoad = function () {
        restoreLiveSave(descriptor);
        if (typeof Engine !== "undefined" && typeof Engine.show === "function") Engine.show();
      };
      if (result && typeof result.then === "function") {
        result.then(finishLoad).catch(function () {
          setup.newGame();
        });
      } else {
        finishLoad();
      }
      return true;
    } catch (error) {
      console.error(error);
      return setup.newGame();
    }
  };

  setup.newGame = function () {
    if (setup.combat) endCombat();
    setup.closeTransientModals();
    setup.closeInventory();
    setup.initializeNewGame();
    play("Shelter");
    return true;
  };

  function supplyKeys(resource) {
    ensureState();
    return Object.keys(setup.inventoryCatalog).filter(function (key) {
      var def = setup.inventoryCatalog[key];
      return def.kind === "supply" && def.resource === resource && State.variables.inventory[key] > 0;
    });
  }

  setup.openSupplyChooser = function (resource) {
    var oldWarning = document.querySelector("#resource-warning-modal");
    if (oldWarning) oldWarning.remove();
    var oldChooser = document.querySelector("#supply-chooser-modal");
    if (oldChooser) oldChooser.remove();

    var keys = supplyKeys(resource);
    if (keys.length === 0) {
      notify(resource === "food" ? "nothing to eat" : "nothing to drink");
      return false;
    }

    if (keys.length === 1) {
      return setup.consumeSupply(keys[0], { closeModal: true });
    }

    var backdrop = document.createElement("div");
    backdrop.id = "supply-chooser-modal";
    backdrop.className = "modal-backdrop";
    var buttons = keys.map(function (key) {
      var def = setup.inventoryCatalog[key];
      return '<button class="modal-button supply-choice" data-item="' +
        escapeHtml(key) + '">' + escapeHtml(def.name) + " · +" + def.value + "</button>";
    }).join("");
    backdrop.innerHTML = `
      <div class="modal-box" role="dialog" aria-modal="true" aria-label="Choose supplies">
        <div class="modal-title">${resource === "food" ? "Eat what?" : "Drink what?"}</div>
        <div class="modal-actions supply-actions">${buttons}</div>
        <div class="modal-actions">
          <button class="modal-button" id="supply-back">Pass</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);

    Array.from(document.querySelectorAll(".supply-choice")).forEach(function (button) {
      button.addEventListener("click", function () {
        setup.consumeSupply(button.getAttribute("data-item"));
        backdrop.remove();
      });
    });
    document.querySelector("#supply-back").addEventListener("click", function () {
      backdrop.remove();
    });
    return true;
  };

  setup.openResourceWarning = function (resource) {
    ensureState();
    var old = document.querySelector("#resource-warning-modal");
    if (old) old.remove();

    var isFood = resource === "food";
    var backdrop = document.createElement("div");
    backdrop.id = "resource-warning-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box resource-warning-box" role="alertdialog" aria-modal="true">
        <div class="modal-text">${isFood ? "Need to eat." : "Throat is dry."}</div>
        <div class="modal-actions">
          <button class="modal-button" id="resource-consume">${isFood ? "Eat" : "Drink"}</button>
          <button class="modal-button" id="resource-pass">Pass</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);

    document.querySelector("#resource-consume").addEventListener("click", function () {
      setup.openSupplyChooser(resource);
    });
    document.querySelector("#resource-pass").addEventListener("click", function () {
      State.variables.resourceWarnings[resource + "AcknowledgedAt"] = State.variables.inventory[resource];
      backdrop.remove();
    });
    return true;
  };

  setup.checkLowResources = function () {
    ensureState();
    var v = State.variables;
    var warnings = v.resourceWarnings;

    if (v.inventory.food <= 0 || v.inventory.water <= 0) {
      setup.requestDefeat("expedition");
      return "defeat";
    }

    var foodNeedsWarning =
      v.inventory.food < 2 &&
      warnings.foodAcknowledgedAt !== v.inventory.food;
    var waterNeedsWarning =
      v.inventory.water < 2 &&
      warnings.waterAcknowledgedAt !== v.inventory.water;

    if (foodNeedsWarning) {
      if (waterNeedsWarning) warnings.queuedWater = true;
      setup.openResourceWarning("food");
      return "food";
    }

    if (warnings.queuedWater && waterNeedsWarning) {
      warnings.queuedWater = false;
      setup.openResourceWarning("water");
      return "water";
    }

    if (waterNeedsWarning) {
      setup.openResourceWarning("water");
      return "water";
    }

    return null;
  };

  setup.completeLordsRestCampQuest = function () {
    ensureState();
    var v = State.variables;
    v.lordsRest.accessGranted = true;
    v.lordsRest.accessMethod = "camp";
    v.lordsRest.guardReunionSeen = true;
    v.inventory.goblinChiefSpear = 0;
    setup.updateInventory();
    return true;
  };

  setup.places = {
    A: { code: "A", name: "Stalwart", coord: [5, 3], passage: "Stalwart - Main Square", respawnPassage: "Stalwart - Main Square", modifiers: ["Town"], dungeon: "stalwartAcademy", exitLine: "Stalwart sits behind you. The road has seen people leave before." },
    B: { code: "B", name: "Byron's Estate", coord: [6, 7], passage: "Place - Byron's Estate", dungeon: "byronsEstate", exitLine: "The estate gate hangs open behind you." },
    C: { code: "C", name: "Forest of Silence", coord: [11, 4], passage: "Place - Forest of Silence", dungeon: "forestSilence", exitLine: "The forest's quiet follows you for a while before the wind takes over." },
    D: { code: "D", name: "Respite", coord: [12, 9], passage: "Place - Respite", dungeon: "respite", exitLine: "Respite is behind you. The place did what it could with the name." },
    E: { code: "E", name: "Frontier", coord: [18, 6], passage: "Place - Frontier", dungeon: "frontier", exitLine: "The frontier road breaks under the snow." },
    F: { code: "F", name: "Forest of Whispers", coord: [22, 3], passage: "Place - Forest of Whispers", dungeon: "forestWhispers", exitLine: "The whispers fade when you leave, though one or two follow you to the road." },
    G: { code: "G", name: "Lord's Rest", coord: [22, 9], passage: "Lord's Rest - Main Road", respawnPassage: "Lord's Rest - Main Road", modifiers: ["Town"], dungeon: "lordsRestGoblinCamp", exitLine: "Smoke rises behind the walls of Lord's Rest." },
    H: { code: "H", name: "Safety", coord: [28, 4], passage: "Place - Safety", dungeon: "safety", exitLine: "Safety is behind you. The name has not aged well." },
    I: { code: "I", name: "Crossroads", coord: [29, 8], passage: "Place - Crossroads", dungeon: "crossroads", exitLine: "The roads split again." },
    J: { code: "J", name: "Forest of Screams", coord: [34, 3], passage: "Place - Forest of Screams", dungeon: "forestScreams", exitLine: "The screams fade into the wind. You are willing to count that as an improvement." },
    K: { code: "K", name: "Outpost 1", coord: [8, 15], passage: "Place - Outpost 1", dungeon: "outpost1", exitLine: "The first outpost watches the snow." },
    L: { code: "L", name: "Outpost 2", coord: [25, 13], passage: "Place - Outpost 2", dungeon: "outpost2", exitLine: "The second outpost falls behind you." },
    M: { code: "M", name: "The Confederation (North)", coord: [17, 11], passage: "Place - The Confederation (North)", dungeon: "confederationNorth", exitLine: "Old banners move without wind." },
    O: { code: "O", name: "Outpost 3", coord: [33, 10], passage: "Outpost 3 - Gate", respawnPassage: "Outpost 3 - Square", modifiers: ["Town"], dungeon: "outpost3", exitLine: "Voices carry from the third outpost long after its walls disappear behind you." },
    P: { code: "P", name: "Serenity", coord: [36, 7], passage: "Place - Serenity", dungeon: "serenity", exitLine: "Serenity is quiet, which is not the same thing as peaceful." }
  };

  setup.northernPlaces = setup.places;

  function getPlace(key) {
    ensureState();
    return setup.places[key] || setup.places[State.variables.currentPlaceKey] || setup.places.A;
  }

  function placeHasModifier(place, modifier) {
    return Boolean(
      place &&
      Array.isArray(place.modifiers) &&
      place.modifiers.indexOf(modifier) !== -1
    );
  }

  function lastTownPlace() {
    ensureState();

    var place = setup.places[State.variables.lastTownKey];
    if (!placeHasModifier(place, "Town")) {
      State.variables.lastTownKey = "A";
      place = setup.places.A;
    }
    return place;
  }

  function placeAt(x, y) {
    var keys = Object.keys(setup.places);
    for (var i = 0; i < keys.length; i++) {
      var place = setup.places[keys[i]];
      if (place.coord[0] === x && place.coord[1] === y) return place;
    }
    return null;
  }

  function setThought(text) {
    ensureState();
    State.variables.map.lastThought = text;
  }

  setup.enterMap = function (key) {
    ensureState();

    var place = getPlace(key);
    var map = State.variables.map;

    if (placeHasModifier(place, "Town")) {
      setup.beginExpedition();
    }

    State.variables.currentPlaceKey = place.code;
    map.x = place.coord[0];
    map.y = place.coord[1];
    map.lastPromptTile = place.code;
    map.discovered[place.code] = true;
    map.lastThought = place.exitLine || "The road opens again.";

    play("Northern Map");
  };

  setup.enterPlace = function (key) {
    ensureState();

    var place = setup.places[key];
    if (!place) {
      notify("missing place: " + key);
      return;
    }

    State.variables.currentPlaceKey = place.code;
    if (placeHasModifier(place, "Town")) {
      State.variables.lastTownKey = place.code;
      setup.commitTownProgress();
    }
    play(place.passage);
  };

  setup.enterCurrentPlace = function () {
    ensureState();
    var map = State.variables.map;
    var place = placeAt(map.x, map.y);
    if (place) setup.enterPlace(place.code);
  };

  setup.openPlacePrompt = function (place) {
    var old = document.querySelector(".modal-backdrop");
    if (old) old.remove();

    var backdrop = document.createElement("div");
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">${escapeHtml(place.name)}</div>
        <div class="modal-text">Enter ${escapeHtml(place.name)}?</div>
        <div class="modal-actions">
          <button class="modal-button" id="place-enter">Yes</button>
          <button class="modal-button" id="place-cancel">No</button>
        </div>
      </div>
    `;

    document.body.appendChild(backdrop);

    document.querySelector("#place-enter").addEventListener("click", function () {
      backdrop.remove();
      setup.enterPlace(place.code);
    });

    document.querySelector("#place-cancel").addEventListener("click", function () {
      backdrop.remove();
    });
  };

  setup.regionEvents = {
    north: {
      weights: { ambient: 40, combat: 30, trader: 15, settlement: 15 },
      ambient: ["winterRoot", "snowmelt", "scrap", "strayDog", "wanderer"],
      combat: [
        { type: "single", enemy: "starvingWolf" },
        { type: "single", enemy: "wanderingDemon" },
        { type: "single", enemy: "corruptedWolf" },
        { type: "mini", key: "banditCamp" },
        { type: "mini", key: "goblinCave" },
        { type: "mini", key: "demonHorde" },
        { type: "mini", key: "corruptedSite" }
      ]
    }
  };

  setup.itemPrices = {
    staleBread: 3, sealedFoodTin: 8, winterRoot: 2, settlementBread: 6,
    waterskin: 8, snowmeltFlask: 5, riverJar: 6, medicine: 12,
    scrapIronPieces: 4, bentArrowheads: 4, northernFieldWrap: 18,
    watchmanCoat: 28, oldMail: 42, hunterKnife: 16, gateSword: 22
  };

  function randomFrom(list) {
    return list[Math.floor(Math.random() * list.length)];
  }

  function createTraderStock() {
    var stock = {};
    stock[randomFrom(["staleBread", "winterRoot", "settlementBread"])] = 1 + Math.floor(Math.random() * 4);
    stock[randomFrom(["waterskin", "snowmeltFlask", "riverJar"])] = 1 + Math.floor(Math.random() * 4);
    stock.medicine = 1 + Math.floor(Math.random() * 3);
    stock[randomFrom(["scrapIronPieces", "bentArrowheads"])] = 1 + Math.floor(Math.random() * 4);
    return stock;
  }

  setup.openTraderEvent = function () {
    ensureState();
    var lines = [
      "\"Good day, sir. I do not see many people walking this road on purpose.\"",
      "\"Do not worry about me. People in my profession learn to take care of themselves, or they change professions quickly.\"",
      "\"You again. Good. I found a few things worth selling, and several things I can make sound worth selling.\""
    ];
    State.variables.activeMapEvent = {
      kind: "trader",
      line: randomFrom(lines),
      stock: createTraderStock(),
      tab: "buy"
    };
    var old = document.querySelector("#map-event-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "map-event-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">Wandering Trader</div>
        <div class="modal-text dialogue-text">${escapeHtml(State.variables.activeMapEvent.line)}</div>
        <div class="modal-actions">
          <button class="modal-button" id="trader-open">Trade</button>
          <button class="modal-button" id="trader-leave">Leave</button>
        </div>
      </div>`;
    document.body.appendChild(backdrop);
    setup.typeDynamicNarrative(backdrop.querySelector(".dialogue-text"));
    document.querySelector("#trader-open").addEventListener("click", function () {
      backdrop.remove();
      setup.openTraderWindow(false);
    });
    document.querySelector("#trader-leave").addEventListener("click", function () {
      State.variables.activeMapEvent = null;
      backdrop.remove();
      setup.renderMap();
    });
  };

  function sellableKeys() {
    return Object.keys(setup.itemPrices).filter(function (key) {
      return key !== "oldSword" &&
        key !== "goblinChiefSpear" &&
        (State.variables.inventory[key] || 0) > 0;
    });
  }

  setup.openTraderWindow = function (fromSettlement) {
    ensureState();
    var event = State.variables.activeMapEvent;
    var settlement = event && event.settlement;
    if (!event) return false;
    if (fromSettlement) {
      if (!settlement.stock) settlement.stock = createTraderStock();
      event.stock = settlement.stock;
    }
    var old = document.querySelector("#trader-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "trader-modal";
    backdrop.className = "modal-backdrop";
    document.body.appendChild(backdrop);

    function render() {
      var tab = event.tab === "sell" ? "sell" : "buy";
      var keys = tab === "buy"
        ? Object.keys(event.stock).filter(function (key) { return event.stock[key] > 0; })
        : sellableKeys();
      var rows = keys.map(function (key) {
        var def = lootDefinition(key);
        var price = tab === "buy"
          ? setup.itemPrices[key]
          : Math.max(1, Math.floor(setup.itemPrices[key] / 2));
        var amount = tab === "buy" ? event.stock[key] : State.variables.inventory[key];
        return '<div class="trade-row"><button type="button" class="trade-info" data-trade-info="' +
          escapeHtml(key) + '"><span>' + escapeHtml(def.name) + " ×" + amount + '</span><span>' +
          price + ' gold</span></button><button type="button" class="trade-action" data-trade-key="' +
          escapeHtml(key) + '">' + (tab === "buy" ? "Buy" : "Sell") + "</button></div>";
      }).join("");
      backdrop.innerHTML = `
        <div class="modal-box trade-box" role="dialog" aria-modal="true" aria-label="Trading">
          <div class="modal-title">Trade</div>
          <div class="trade-balance">Gold: ${State.variables.inventory.gold}</div>
          <div class="trade-tabs">
            <button type="button" id="trade-buy" class="${tab === "buy" ? "active" : ""}">Buy</button>
            <button type="button" id="trade-sell" class="${tab === "sell" ? "active" : ""}">Sell</button>
          </div>
          <div class="trade-list">${rows || '<div class="reward-empty">Nothing left on this side of the table.</div>'}</div>
          <div class="reward-detail" id="trade-detail">Hover over or tap an item to inspect it.</div>
          <div class="modal-actions"><button class="modal-button" id="trade-exit">Exit</button></div>
        </div>`;
      document.querySelector("#trade-buy").addEventListener("click", function () { event.tab = "buy"; render(); });
      document.querySelector("#trade-sell").addEventListener("click", function () { event.tab = "sell"; render(); });
      Array.from(backdrop.querySelectorAll(".trade-info")).forEach(function (button) {
        var show = function () {
          var def = lootDefinition(button.getAttribute("data-trade-info"));
          document.querySelector("#trade-detail").textContent = (def.description || "") + (def.stats ? " " + def.stats : "");
        };
        button.addEventListener("mouseenter", show);
        button.addEventListener("focus", show);
        button.addEventListener("click", show);
      });
      Array.from(backdrop.querySelectorAll(".trade-action")).forEach(function (button) {
        button.addEventListener("click", function () {
          var key = button.getAttribute("data-trade-key");
          var price = setup.itemPrices[key];
          if (event.tab === "buy") {
            if (State.variables.inventory.gold < price) {
              notify("not enough gold");
              return;
            }
            State.variables.inventory.gold -= price;
            State.variables.inventory[key] = (State.variables.inventory[key] || 0) + 1;
            event.stock[key] -= 1;
          } else {
            if ((State.variables.inventory[key] || 0) < 1) return;
            State.variables.inventory[key] -= 1;
            State.variables.inventory.gold += Math.max(1, Math.floor(price / 2));
          }
          setup.updateInventory();
          render();
        });
      });
      document.querySelector("#trade-exit").addEventListener("click", function () {
        backdrop.remove();
        if (fromSettlement) setup.renderGeneratedSettlement();
        else {
          State.variables.activeMapEvent = null;
          setup.renderMap();
        }
      });
    }
    render();
    return true;
  };

  setup.generatedSettlementScenes = {
    ruined: {
      townSquare: [
        "A roof collapses while you watch. The crack rolls through the empty streets. For a moment, you wait for the swearing to start.",
        "The square is buried to the knees in snow. A dry fountain points at nothing.",
        "Market stalls lean together like they are sharing the last bad news. There is plenty to go around.",
        "A war memorial stands in the center. Every name has been scratched away. Somebody wanted the stone, but apparently not badly enough."
      ],
      residential: [
        "Ash stains the snow around the outer homes despite all the years that have passed.",
        "New boards once covered the old holes. Now both have rotted through, and the weather has the house to itself.",
        "Doors hang open along the street. You still knock before entering one. No reason to become rude now.",
        "A child's wooden horse is frozen beneath a window. One wheel is missing. So is everyone else."
      ],
      schoolyard: [
        "Small desks have been dragged into the yard for firewood. Most of them never made it into the fire.",
        "A lesson is still written on a slate beneath the snow. The answer was spring.",
        "The school bell lies cracked beside the gate. Class ended years ago, though nobody bothered to take it inside.",
        "Children once wore a path across this yard. Snow has spent years erasing it."
      ],
      marketplace: [
        "Wet canvas sags over empty stalls. Nobody complains about prices. It is worse this way.",
        "Coins lie fused together beneath a burned counter. Riches, assuming you can find a merchant who accepts one large coin-shaped lump.",
        "A scale waits on one stall with nothing on either side. It may be the last honest measure in town.",
        "Old signs promise fresh bread, warm clothes, and honest weights. The paint has held up better than the promises."
      ],
      lordsMansion: [
        "No lord lives here now, and neither does anyone else. The rooms finally belong to the dust.",
        "The front doors were taken for firewood. The gold handles were taken first. Priorities survived.",
        "A dining table fills the hall. The chairs are gone, but the place settings remain. Dinner is late.",
        "Portraits have been cut from their frames. Whatever the family looked like, the wall has moved on."
      ],
      graveyard: [
        "Half the markers are gone. The graves remain better organized than the town.",
        "Snow fills the names faster than you can brush it away. You stop trying after the third.",
        "The gate squeals whenever the wind moves it. The dead have heard worse.",
        "Someone left a wooden cup beside a grave. It has caught years of snow and not much else."
      ],
      park: [
        "Trees have split the old paths apart. Nature came back with a grudge and plenty of time.",
        "A bench faces a frozen pond. The view is terrible. You sit for a moment anyway.",
        "A statue has fallen face-first into the snow. The plaque still calls him unconquered.",
        "Dead vines cover the play frame. The wind gives it a turn."
      ],
      church: [
        "A bell tower rises above the snow. The bell is gone. The rope still moves when the wind catches it. Close enough.",
        "Moonlight falls through the missing roof. The pews have nowhere else to be.",
        "Every charm has been stripped from the altar except one carved into the stone. Harder to loot faith when it is part of the wall.",
        "The doors stand open. Whoever left last did not expect to come back."
      ],
      gardens: [
        "The beds are all weeds and frozen stalks. Nature's come to take back what is hers. You just got to it first.",
        "Glass from the greenhouse shines beneath the snow. It looks almost pretty until you get close enough to bleed.",
        "A rusted spade is still planted in the soil. The gardener must have planned to return after lunch.",
        "Something green pushes through beneath a broken wall. You leave it alone. It has enough problems."
      ],
      lake: [
        "The lake froze around a rowboat still tied to the dock. Nobody stole it because nobody wanted to row through ice.",
        "Reeds scratch at the shore. Beneath them, the water is dark and patient.",
        "A fishing line disappears into a hole that froze shut years ago. Whoever left it expected to come back before dark.",
        "The dock ends three steps early. The water below is deep enough to make that everyone else's problem."
      ],
      tradingPost: [
        "The counter has been pried apart board by board. Someone left the sign. It says OPEN.",
        "Ledgers rot inside a locked cabinet. The lock protected them from everyone except the damp.",
        "Empty hooks cover the walls. Whatever hung here was useful enough to take.",
        "A coin is nailed above the door for luck. It did not work, but it is still a coin."
      ],
      adventurersGuild: [
        "Quest notices have melted into the board. All of them are overdue.",
        "The trophy wall is empty except for labels. Someone took the valuable parts and left the heroic names.",
        "A map covers one table. Half the roads lead to places that no longer exist.",
        "Someone carved NOT WORTH IT into the guild counter. The warning came too late for them and just in time for you."
      ]
    },
    budding: {
      townSquare: [
        "A roof collapses while you watch. Three people swear. Five more start fixing it. Now eight people are swearing.",
        "A cookpot steams beside the well. It is mostly turnip. Nobody pretends otherwise.",
        "Children drag a broken shield through the square as a sled. The old owner probably used it less effectively.",
        "A notice board lists missing tools, offered work, and one stolen chicken. The chicken has the longest description."
      ],
      residential: [
        "Children have worn a path through the snow. Adults built the houses. The children decided where the roads go.",
        "New boards cover old holes. Laundry freezes stiff between the homes. Not sure if that counts as dry.",
        "Smoke crawls from chimneys patched with clay. Every house leans a little, but they lean together.",
        "Two families argue over a fence while repairing it together. It is a normal problem, and that sounds almost luxurious."
      ],
      schoolyard: [
        "A teacher writes letters on scavenged roof tiles. The children correct his spelling without mercy.",
        "Class meets beneath an army tent. The students have turned old ration crates into desks.",
        "A wooden sword hangs above the school door. The lesson underneath says THINK FIRST.",
        "Children have built a snow demon in the yard. Someone gave it the mayor's hat."
      ],
      marketplace: [
        "Wet boots crowd the entrance. Coins change hands. Someone complains about prices. Glad to know that despite everything, some things remain.",
        "Three stalls sell roots. All three merchants insist theirs are less bitter.",
        "A tailor measures cloth beside a forge. Sparks keep landing on the sleeves. Business is tense.",
        "A woman trades two nails for an egg and looks pleased with herself. The chicken was not consulted."
      ],
      lordsMansion: [
        "No lord lives here now. Several families do. It's a better use of the space.",
        "The ballroom has become a sleeping hall. Someone drew room numbers over the old family crest.",
        "Soup cooks in the grand fireplace beneath a portrait turned toward the wall.",
        "The estate office now stores blankets and seed. The old tax ledgers help start the fire."
      ],
      graveyard: [
        "Fresh markers stand beside old stones. Someone brushes the snow from every name.",
        "A groundskeeper repairs the wall one stone at a time. He says the dead deserve one thing kept properly.",
        "Winter flowers made from cloth sit on the newest graves. Real flowers can wait for spring.",
        "Two children leave a biscuit beside a marker. A crow waits with professional patience."
      ],
      park: [
        "A bench has been rebuilt from three different benches. Four people sit on it and disagree about the fourth kind of wood.",
        "Children race around trees blackened by the war. None of them care what the trees remember.",
        "Someone cleared a skating circle on the pond. Children fall, get up, and call it an afternoon well spent.",
        "A musician plays beneath a patched awning. The instrument has five strings. The song only needs four."
      ],
      church: [
        "The bell is gone, so a boy strikes a cooking pot at dusk. Everyone complains and comes inside.",
        "Moon charms share the altar with bread, bandages, and a jar of nails. Faith has become practical.",
        "The roof leaks over the front pew. Worshippers sit in the back and call it tradition.",
        "A priest mends coats between services. Souls can wait until the sleeves are attached."
      ],
      gardens: [
        "Canvas shelters bend over rows of winter crops. Nothing grows well. Food is food.",
        "The gardener speaks to each seedling. None answer, but most are still alive, which is answer enough.",
        "Warm stones line the beds beneath patched glass. Every leaf has earned its place.",
        "Three cabbages survived the frost. They are guarded better than the gate."
      ],
      lake: [
        "A family cuts clean ice from the lake and stacks it beside the smokehouse. Winter finally pays rent.",
        "Fishing lines vanish through holes in the ice. Nobody catches much. They still argue over bait.",
        "Children slide along the shore while adults shout useful advice far too late.",
        "A repaired pump draws lake water through sand and charcoal. It still tastes bad. At least it is not purple."
      ],
      tradingPost: [
        "A trader sleeps behind the counter with one hand on the coin box. The walls were repaired before trust was.",
        "Crates fill every wall. Half are empty. The labels make the place look successful.",
        "A chalkboard lists arrivals from towns you thought were gone. A few names have been crossed out. Not all.",
        "Someone rings a cracked handbell for each sale. The sound is awful. Business is good."
      ],
      adventurersGuild: [
        "The guild has six members, four chairs, and enough work for twenty. Nobody argues over the chairs.",
        "A map is pinned beneath mugs and knife points. The safe roads change every morning.",
        "New notices cover the old heroic portraits. Most ask for escorts, medicine, or somebody who can fix a roof.",
        "A young adventurer practices introductions near the door. She sounds confident enough that nobody interrupts."
      ]
    }
  };

  setup.generatedSettlementEntries = {
    ruined: [
      "Rooflines break through the snow ahead. Nothing moves between them. You check anyway.",
      "A road leads into a settlement the war forgot to finish burying.",
      "Smoke once blackened these walls. Snow has been trying to clean them ever since.",
      "The gate is open. That stopped being welcoming a long time ago."
    ],
    budding: [
      "Smoke rises from patched chimneys. For once, that means dinner.",
      "Hammering carries over the snow. Someone is building instead of breaking.",
      "Lanterns burn behind repaired walls. The road has not managed to take this place yet.",
      "A child waves from the gate before an adult pulls them back. The adult is sensible. You wave anyway."
    ]
  };

  var generatedAreaLabels = {
    townSquare: "Town Square", residential: "Residential Area", schoolyard: "Schoolyard",
    marketplace: "Marketplace", lordsMansion: "Lord's Mansion", graveyard: "Graveyard",
    park: "Park", church: "Church", gardens: "Gardens", lake: "Lake",
    tradingPost: "Trading Post", adventurersGuild: "Adventurers Guild"
  };
  var optionalGeneratedAreas = [
    "schoolyard", "marketplace", "lordsMansion", "graveyard", "park",
    "church", "gardens", "lake", "tradingPost", "adventurersGuild"
  ];
  var ruinedAreaLoot = {
    townSquare: { scrapIronPieces: 1 }, residential: { staleBread: 1 },
    schoolyard: { bentArrowheads: 1 }, marketplace: { gold: 3 },
    lordsMansion: { gold: 5, medicine: 1 }, graveyard: { moonCharms: 1 },
    park: { winterRoot: 1 }, church: { moonCharms: 1 }, gardens: { winterRoot: 2 },
    lake: { riverJar: 1 }, tradingPost: { gold: 4, scrapIronPieces: 1 },
    adventurersGuild: { medicine: 1, bentArrowheads: 1 }
  };

  function generatedSearchFlavor(area) {
    if (area === "gardens") return "Nature's come to take back what is hers. You just got to it first.";
    if (area === "lake") return "Slightly wet. Could still be useful.";
    return "Dust and snow covered it. Patience did the rest.";
  }

  function createGeneratedSettlement() {
    var type = Math.random() < 0.55 ? "ruined" : "budding";
    var shuffled = optionalGeneratedAreas.slice().sort(function () { return Math.random() - 0.5; });
    var areas = ["townSquare", "residential"].concat(shuffled.slice(0, 2 + Math.floor(Math.random() * 3)));
    var scenes = {};
    areas.forEach(function (area) {
      scenes[area] = randomFrom(setup.generatedSettlementScenes[type][area]);
    });
    return {
      id: "north-" + State.variables.map.moves + "-" + Math.floor(Math.random() * 1000000),
      region: "north",
      type: type,
      name: type === "ruined" ? "Ruined Northern Settlement" : "Budding Northern Settlement",
      entry: randomFrom(setup.generatedSettlementEntries[type]),
      areas: areas,
      scenes: scenes,
      currentArea: "townSquare",
      rested: false,
      stock: null
    };
  }

  setup.openGeneratedSettlement = function () {
    ensureState();
    var settlement = createGeneratedSettlement();
    State.variables.activeMapEvent = { kind: "settlement", settlement: settlement, stock: null, tab: "buy" };
    var old = document.querySelector("#map-event-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "map-event-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">${escapeHtml(settlement.name)}</div>
        <div class="modal-text">${escapeHtml(settlement.entry)}</div>
        <div class="modal-actions">
          <button class="modal-button" id="settlement-enter">Enter</button>
          <button class="modal-button" id="settlement-leave">Leave</button>
        </div>
      </div>`;
    document.body.appendChild(backdrop);
    document.querySelector("#settlement-enter").addEventListener("click", function () {
      backdrop.remove();
      setup.renderGeneratedSettlement();
    });
    document.querySelector("#settlement-leave").addEventListener("click", function () {
      State.variables.activeMapEvent = null;
      backdrop.remove();
      setup.renderMap();
    });
  };

  setup.renderGeneratedSettlement = function () {
    ensureState();
    var event = State.variables.activeMapEvent;
    if (!event || event.kind !== "settlement") return false;
    var settlement = event.settlement;
    var area = settlement.currentArea || settlement.areas[0];
    var old = document.querySelector("#settlement-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "settlement-modal";
    backdrop.className = "modal-backdrop";
    var areaButtons = settlement.areas.map(function (key) {
      return '<button type="button" class="settlement-area-button ' + (key === area ? "active" : "") +
        '" data-area="' + key + '">' + escapeHtml(generatedAreaLabels[key]) + "</button>";
    }).join("");
    var flag = settlement.id + ":" + area;
    var searched = Boolean(State.variables.generatedSettlementVisits[flag]);
    var areaActions = "";
    if (settlement.type === "ruined" && !searched) {
      areaActions = '<button type="button" class="modal-button" id="settlement-search">Search</button>';
    }
    if (settlement.type === "budding") {
      areaActions =
        '<button type="button" class="modal-button" id="settlement-rest" ' + (settlement.rested ? "disabled" : "") + '>Rest</button>' +
        '<button type="button" class="modal-button" id="settlement-trade">Shop</button>';
    }
    backdrop.innerHTML = `
      <div class="modal-box settlement-box" role="dialog" aria-modal="true" aria-label="${escapeHtml(settlement.name)}">
        <div class="modal-title">${escapeHtml(settlement.name)}</div>
        <div class="settlement-layout">
          <div class="settlement-area-list">${areaButtons}</div>
          <div class="settlement-scene">
            <div class="settlement-area-title">${escapeHtml(generatedAreaLabels[area])}</div>
            <div class="modal-text settlement-story-text">${escapeHtml(settlement.scenes[area])}</div>
            <div class="modal-actions">${areaActions}</div>
          </div>
        </div>
        <div class="modal-actions"><button class="modal-button" id="settlement-exit">Leave</button></div>
      </div>`;
    document.body.appendChild(backdrop);
    Array.from(backdrop.querySelectorAll(".settlement-area-button")).forEach(function (button) {
      button.addEventListener("click", function () {
        settlement.currentArea = button.getAttribute("data-area");
        backdrop.remove();
        setup.renderGeneratedSettlement();
      });
    });
    var search = document.querySelector("#settlement-search");
    if (search) search.addEventListener("click", function () {
      backdrop.remove();
      setup.openLootPopup({
        title: "Found",
        flavor: generatedSearchFlavor(area),
        loot: ruinedAreaLoot[area] || { scrapIronPieces: 1 },
        action: { type: "settlementSearch", flag: flag }
      });
    });
    var rest = document.querySelector("#settlement-rest");
    if (rest) rest.addEventListener("click", function () {
      settlement.rested = true;
      State.variables.player.hp = State.variables.player.maxHp;
      notify("health restored");
      setup.renderGeneratedSettlement();
    });
    var trade = document.querySelector("#settlement-trade");
    if (trade) trade.addEventListener("click", function () {
      backdrop.remove();
      setup.openTraderWindow(true);
    });
    document.querySelector("#settlement-exit").addEventListener("click", function () {
      State.variables.activeMapEvent = null;
      backdrop.remove();
      setup.renderMap();
    });
    setup.typeDynamicNarrative(backdrop.querySelector(".settlement-story-text"));
    return true;
  };

  function runAmbientEvent(key) {
    var v = State.variables;
    if (key === "winterRoot") {
      setup.receiveLoot({ winterRoot: 1 }, { message: "winter root taken" });
      setThought("You find winter root beneath the snow. Bitter food is still food.");
    } else if (key === "snowmelt") {
      setup.receiveLoot({ snowmeltFlask: 1 }, { message: "snowmelt flask taken" });
      setThought("Clean ice gathers in a broken basin. You melt what you can.");
    } else if (key === "scrap") {
      setup.receiveLoot({ scrapIronPieces: 1 }, { message: "scrap iron piece taken" });
      setThought("A bent hinge comes loose from an old sign. It no longer holds a door, but the metal can still earn its keep.");
    } else if (key === "strayDog") {
      if (v.inventory.food > 0) v.inventory.food -= 1;
      v.hiddenStats.kindness += 1;
      setup.updateInventory();
      setThought("A stray dog follows at a distance. You leave food, and it waits until you walk away before eating. Trust takes longer than hunger.");
    } else {
      setThought("A wanderer asks if Stalwart still stands. You say yes. The word is doing more work than the walls.");
    }
  }

  function startMapEvent() {
    ensureState();
    var v = State.variables;
    var map = v.map;
    var region = setup.regionEvents[map.region] || setup.regionEvents.north;
    map.eventCooldown = MAP_EVENT_COOLDOWN_TILES;
    var total = Object.keys(region.weights).reduce(function (sum, key) { return sum + region.weights[key]; }, 0);
    var roll = Math.random() * total;
    var family = "ambient";
    Object.keys(region.weights).some(function (key) {
      roll -= region.weights[key];
      if (roll <= 0) {
        family = key;
        return true;
      }
      return false;
    });
    if (family === "ambient") {
      runAmbientEvent(randomFrom(region.ambient));
    } else if (family === "trader") {
      setup.openTraderEvent();
    } else if (family === "settlement") {
      setup.openGeneratedSettlement();
    } else {
      var combatEvent = randomFrom(region.combat);
      v.activeMapEvent = { kind: "combat", event: clone(combatEvent) };
      if (combatEvent.type === "mini") {
        var siteNames = ["Corrupted Cave", "Corrupted Lake", "Corrupted Plains", "Corrupted Forest"];
        setup.openMiniDungeon(
          combatEvent.key,
          combatEvent.key === "corruptedSite" ? randomFrom(siteNames) : null
        );
      } else {
        setThought("Something moves ahead. It has noticed you.");
        v.activeMapEvent = null;
        setup.startCombat(combatEvent.enemy, "Northern Map", { kind: "mapEvent" });
      }
    }
  }

  setup.startMapEvent = startMapEvent;

  setup.rollMapEvent = function () {
    ensureState();

    var map = State.variables.map;

    if (map.eventCooldown > 0) {
      map.eventCooldown -= 1;
      return false;
    }

    if (Math.random() < MAP_EVENT_CHANCE) {
      startMapEvent();
      return true;
    }

    return false;
  };

  setup.moveMap = function (dx, dy) {
    ensureState();

    var v = State.variables;
    var map = v.map;
    if (
      v.pendingDefeat ||
      document.querySelector("#resource-warning-modal") ||
      document.querySelector("#supply-chooser-modal")
    ) {
      return false;
    }

    var nextX = clamp(map.x + dx, MAP_MIN, MAP_MAX);
    var nextY = clamp(map.y + dy, MAP_MIN, MAP_MAX);
    if (nextX === map.x && nextY === map.y) {
      setup.renderMap();
      return false;
    }

    map.x = nextX;
    map.y = nextY;
    map.moves += 1;
    map.tilesSinceWater += 1;
    map.tilesSinceFood += 1;
    map.tilesSinceHealth += 1;

    if (map.tilesSinceWater >= WATER_STEP_COST) {
      map.tilesSinceWater = 0;
      v.inventory.water = Math.max(0, v.inventory.water - 1);
    }

    if (map.tilesSinceFood >= FOOD_STEP_COST) {
      map.tilesSinceFood = 0;
      v.inventory.food = Math.max(0, v.inventory.food - 1);
    }

    if (v.inventory.food <= 0 || v.inventory.water <= 0) {
      setup.renderMap();
      setup.requestDefeat("expedition");
      return false;
    }

    if (map.tilesSinceHealth >= HEALTH_REGEN_STEPS) {
      map.tilesSinceHealth = 0;
      if (v.player.hp < v.player.maxHp) {
        v.player.hp = Math.min(v.player.maxHp, v.player.hp + 1);
      }
    }

    var warning = setup.checkLowResources();
    if (warning) {
      setup.renderMap();
      return true;
    }

    var place = placeAt(map.x, map.y);

    if (place) {
      map.discovered[place.code] = true;
      setThought("You reach " + place.name + ". The entrance is still there, which saves time and raises questions.");
      setup.renderMap();

      if (map.lastPromptTile !== place.code) {
        map.lastPromptTile = place.code;
        setup.openPlacePrompt(place);
      }
      return;
    }

    map.lastPromptTile = null;
    setup.rollMapEvent();
    setup.renderMap();
    return true;
  };

  function renderDirectionalButtons(container) {
    var pad = document.createElement("div");
    pad.className = "map-direction-pad";

    var north = makeButton("North", function () { setup.moveMap(0, -1); });
    var west = makeButton("West", function () { setup.moveMap(-1, 0); });
    var east = makeButton("East", function () { setup.moveMap(1, 0); });
    var south = makeButton("South", function () { setup.moveMap(0, 1); });

    north.style.gridColumn = "2";
    north.style.gridRow = "1";
    west.style.gridColumn = "1";
    west.style.gridRow = "2";
    east.style.gridColumn = "3";
    east.style.gridRow = "2";
    south.style.gridColumn = "2";
    south.style.gridRow = "3";

    [north, west, east, south].forEach(function (button) {
      button.className = "map-button";
      pad.appendChild(button);
    });

    container.appendChild(pad);
  }

  setup.renderMap = function () {
    ensureState();
    setup.updateInventory();

    var root = document.querySelector("#north-map-root");
    if (!root) {
      var passage = passageEl();
      if (!passage) return;
      root = document.createElement("div");
      root.id = "north-map-root";
      passage.appendChild(root);
    }

    var v = State.variables;
    var map = v.map;

    root.innerHTML = "";

    var wrap = document.createElement("div");
    wrap.id = "map-wrap";
    wrap.className = "map-screen";
    wrap.style.textAlign = "center";

    var thought = document.createElement("div");
    thought.className = "map-thought-box";
    thought.innerHTML = '<div class="map-thought-title">thoughts</div><div class="map-thought-text"></div>';
    thought.querySelector(".map-thought-text").textContent = map.lastThought;
    wrap.appendChild(thought);

    var mapText = "";
    for (var y = map.y - VISION_RADIUS; y <= map.y + VISION_RADIUS; y++) {
      var row = "";
      for (var x = map.x - VISION_RADIUS; x <= map.x + VISION_RADIUS; x++) {
        var cell = ".";

        if (x < MAP_MIN || x > MAP_MAX || y < MAP_MIN || y > MAP_MAX) {
          cell = " ";
        } else if (x === map.x && y === map.y) {
          cell = "C*";
        } else {
          var place = placeAt(x, y);
          if (place) cell = place.code;
        }

        if (cell.length === 1) cell = " " + cell;
        row += cell + " ";
      }
      mapText += row + "\n";
    }

    var pre = document.createElement("pre");
    pre.id = "world-map";
    pre.textContent = mapText;
    pre.style.display = "inline-block";
    pre.style.textAlign = "left";
    pre.style.whiteSpace = "pre";
    pre.style.fontFamily = "Courier New, monospace";
    wrap.appendChild(pre);

    renderDirectionalButtons(wrap);

    var currentPlace = placeAt(map.x, map.y);
    if (currentPlace) {
      var enterWrap = document.createElement("div");
      enterWrap.className = "choice-grid manual choice-count-1";
      enterWrap.style.display = "grid";
      enterWrap.style.justifyContent = "center";
      enterWrap.style.margin = "7px auto";
      enterWrap.appendChild(makeButton("Enter " + currentPlace.name, function () {
        setup.enterCurrentPlace();
      }));
      wrap.appendChild(enterWrap);
    }

    var hud = document.createElement("div");
    hud.className = "map-hud";
    hud.textContent = "food: " + v.inventory.food + " | water: " + v.inventory.water + " | position: " + map.x + "," + map.y;
    wrap.appendChild(hud);

    root.appendChild(wrap);
  };

  setup.dungeons = {
    stalwartAcademy: { name: "Northern Academy of Heroes", difficulty: 3, rooms: 10, enemies: ["wraith", "goblinScout", "academyEcho"], boss: "academyEcho", enemyHp: { wraith: 16, goblinScout: 18, academyEcho: 18 }, bossHp: 30, items: ["bentArrowheads", "medicinePouch", "crackedMoonCharm"], chest: ["gateSword", "oldMail"], clearLine: "The academy is quiet again. You cannot repair what happened here, but you can let it rest." },
    byronsEstate: { name: "Byron's Estate Cellars", difficulty: 1, rooms: 7, enemies: ["starvingWolf", "goblinScout"], boss: "orcRaider", items: ["sealedFoodTin", "scrapIron"], chest: ["watchmanCoat", "settlementBread"], clearLine: "The estate finally gives up what its owners left behind. The dead have always been poor at sharing." },
    forestSilence: { name: "Forest of Silence", difficulty: 3, rooms: 12, enemies: ["starvingWolf", "goblinScout", "demonHound"], boss: "frostStag", items: ["winterRoot", "medicinePouch", "silentBell"], chest: ["silentBell", "northernFieldWrap"], clearLine: "The Forest of Silence keeps its name. For once, a sign on the map tells the truth." },
    respite: { name: "Respite Shelters", difficulty: 1, rooms: 6, enemies: ["starvingWolf", "wraith"], boss: "orcRaider", items: ["staleBread", "snowmeltFlask"], chest: ["medicinePouch", "settlementBread"], clearLine: "The shelters at Respite are safer than they were this morning. Small victories still have to count." },
    frontier: { name: "Frontier Barracks", difficulty: 2, rooms: 8, enemies: ["goblinScout", "orcRaider"], boss: "orcRaider", items: ["scrapIron", "bentArrowheads"], chest: ["hunterKnife", "watchmanCoat"], clearLine: "The barracks are empty now. It took years, but the watch is finally over." },
    forestWhispers: { name: "Forest of Whispers", difficulty: 4, rooms: 13, enemies: ["goblinScout", "demonHound", "wraith"], boss: "frostStag", items: ["winterRoot", "whiteAntler"], chest: ["whiteAntler", "oldMail"], clearLine: "The whispers thin until the wind can be heard between them. You decide that is close enough." },
    lordsRestGoblinCamp: { name: "Goblin Camp", difficulty: 3, rooms: 10, enemies: ["goblinArcher", "goblinFighter", "goblinSwordsman"], boss: "goblinChief", items: ["staleBread", "scrapIron", "medicinePouch"], chest: ["watchmanCoat", "sealedFoodTin"], clearLine: "The camp is finished. By tonight, the people behind the gate may hear only the wind." },
    safety: { name: "Safety Watchhouse", difficulty: 2, rooms: 9, enemies: ["starvingWolf", "goblinScout", "orcRaider"], boss: "orcRaider", items: ["scrapIron", "snowmeltFlask"], chest: ["oldMail", "sealedFoodTin"], clearLine: "The watchhouse at Safety is clear. The name is only slightly less ambitious now." },
    crossroads: { name: "Crossroads Tollhouse", difficulty: 2, rooms: 8, enemies: ["goblinScout", "wraith"], boss: "orcRaider", items: ["bentArrowheads", "staleBread"], chest: ["hunterKnife", "snowmeltFlask"], clearLine: "The tollhouse is empty and the roads are open. Nobody remains to charge you for choosing badly." },
    forestScreams: { name: "Forest of Screams", difficulty: 5, rooms: 15, enemies: ["demonHound", "orcRaider", "wraith"], boss: "frostBear", items: ["medicinePouch", "winterRoot", "frostBearClaw"], chest: ["frostBearClaw", "oldMail"], clearLine: "The Forest of Screams is not quiet, but there are fewer voices in it now." },
    outpost1: { name: "Outpost 1", difficulty: 1, rooms: 7, enemies: ["goblinScout", "starvingWolf"], boss: "orcRaider", items: ["scrapIron", "snowmeltFlask"], chest: ["watchmanCoat", "bentArrowheads"], clearLine: "The first outpost is clear. Its watchtower has nobody left to report the news." },
    outpost2: { name: "Outpost 2", difficulty: 2, rooms: 8, enemies: ["goblinScout", "orcRaider"], boss: "orcRaider", items: ["scrapIron", "sealedFoodTin"], chest: ["oldMail", "medicinePouch"], clearLine: "The second outpost is clear. Snow has already started covering the marks you left." },
    confederationNorth: { name: "The Confederation Halls", difficulty: 4, rooms: 11, enemies: ["wraith", "orcRaider", "academyEcho"], boss: "academyEcho", items: ["crackedMoonCharm", "medicinePouch", "scrapIron"], chest: ["gateSword", "oldMail"], clearLine: "The old Confederation halls fall silent. The arguments lasted longer than the country." },
    outpost3: { name: "Outpost 3", difficulty: 2, rooms: 9, enemies: ["goblinScout", "orcRaider"], boss: "orcRaider", items: ["settlementBread", "snowmeltFlask"], chest: ["watchmanCoat", "medicinePouch"], clearLine: "The storehouse is clear. Outpost 3 gets to keep standing for another day." },
    serenity: { name: "Serenity Chapel", difficulty: 3, rooms: 10, enemies: ["wraith", "demonHound"], boss: "frostStag", items: ["crackedMoonCharm", "medicinePouch"], chest: ["northernFieldWrap", "medicinePouch"], clearLine: "The chapel feels less wrong than it did before. Some days, that is enough." }
  };

  setup.miniDungeonTemplates = {
    banditCamp: { name: "Bandit Camp", difficulty: 2, rooms: 3, enemies: ["banditRaider"], boss: "banditCaptain", items: [], chest: [], bossOnlyLoot: true, clearLine: "The campfire keeps burning after the camp falls quiet. Someone should put it out. Apparently, that someone is you." },
    goblinCave: { name: "Goblin Cave", difficulty: 3, rooms: 5, enemies: ["goblinScout", "goblinFighter", "goblinArcher"], boss: "goblinSwordsman", items: [], chest: [], bossOnlyLoot: true, clearLine: "The cave belongs to you now, by the old rules. You leave it to the damp." },
    demonHorde: { name: "Wandering Demon Horde", difficulty: 5, rooms: 7, enemies: ["demonHound", "wanderingDemon"], boss: "demonHerald", items: [], chest: [], bossOnlyLoot: true, clearLine: "After seven fights, an empty stretch of road looks almost welcoming." },
    corruptedSite: { name: "Corrupted Site", difficulty: 4, rooms: 4, enemies: ["corruptedWolf", "demonHound"], boss: "corruptedGuardian", items: [], chest: [], bossOnlyLoot: true, clearLine: "The purple light fades from the ground. The land will need longer to recover." }
  };

  setup.getActiveDungeonDefinition = function (dungeonState) {
    dungeonState = dungeonState || State.variables.dungeon;
    if (!dungeonState) return null;
    return dungeonState.eventDefinition || setup.dungeons[dungeonState.key] || null;
  };

  setup.dungeonChestGold = function (dungeonKey) {
    var active = State.variables.dungeon;
    var def = active && active.key === dungeonKey
      ? setup.getActiveDungeonDefinition(active)
      : setup.dungeons[dungeonKey];
    if (!def) return 0;
    return Math.max(1, Math.floor(def.difficulty || 1)) * 5;
  };

  function dungeonRoomKey(dungeonState) {
    return dungeonState.key + ":" + dungeonState.room;
  }

  function getDungeonRoom(dungeonState) {
    ensureState();

    var key = dungeonRoomKey(dungeonState);
    var rooms = State.variables.dungeonRooms;
    var def = setup.getActiveDungeonDefinition(dungeonState);

    if (!rooms[key]) {
      var isBossRoom = dungeonState.room >= dungeonState.rooms;
      var hasMonster = dungeonState.mini || isBossRoom || Math.random() < 0.25;
      var hasItem = !dungeonState.mini && !isBossRoom && Math.random() < 0.25;

      rooms[key] = {
        monster: hasMonster ? (isBossRoom ? def.boss : def.enemies[Math.floor(Math.random() * def.enemies.length)]) : null,
        monsterDefeated: false,
        item: hasItem ? def.items[Math.floor(Math.random() * def.items.length)] : null,
        itemTaken: false
      };
    }

    return rooms[key];
  }

  setup.openDungeonWarning = function (dungeonKey, returnPassage) {
    var def = setup.dungeons[dungeonKey];
    if (!def) {
      notify("missing dungeon: " + dungeonKey);
      return;
    }

    var old = document.querySelector(".modal-backdrop");
    if (old) old.remove();

    var backdrop = document.createElement("div");
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">Warning!</div>
        <div class="modal-text">
          Approaching ${escapeHtml(def.name)}.<br><br>
          There may be useful supplies inside. There are also signs that you will not be the only one looking for them. If you enter and die, everything gained since entering will be lost.
        </div>
        <div class="modal-actions">
          <button class="modal-button" id="modal-enter">Enter</button>
          <button class="modal-button" id="modal-cancel">Turn Back</button>
        </div>
      </div>
    `;

    document.body.appendChild(backdrop);

    document.querySelector("#modal-enter").addEventListener("click", function () {
      backdrop.remove();
      setup.enterDungeon(dungeonKey, returnPassage || State.passage);
    });

    document.querySelector("#modal-cancel").addEventListener("click", function () {
      backdrop.remove();
    });
  };

  setup.enterDungeon = function (dungeonKey, returnPassage) {
    ensureState();

    var def = setup.dungeons[dungeonKey];
    if (!def) {
      notify("missing dungeon: " + dungeonKey);
      return;
    }

    if (State.variables.clearedDungeons[dungeonKey]) {
      notify("Nothing left in there. Just old air.");
      return;
    }

    setup.beginDungeonCheckpoint();
    State.variables.dungeon = {
      key: dungeonKey,
      name: def.name,
      room: 1,
      rooms: def.rooms,
      returnPassage: returnPassage || State.passage,
      bossDefeated: false,
      chestLooted: false
    };

    play("Dungeon Room");
  };

  setup.openMiniDungeon = function (templateKey, displayName) {
    ensureState();
    var template = setup.miniDungeonTemplates[templateKey];
    if (!template) return false;
    var def = clone(template);
    if (displayName) def.name = displayName;
    var old = document.querySelector("#map-event-modal");
    if (old) old.remove();
    var backdrop = document.createElement("div");
    backdrop.id = "map-event-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box">
        <div class="modal-title">${escapeHtml(def.name)}</div>
        <div class="modal-text">Every way through is occupied. You can clear it out, or decide the road has asked enough of you today.</div>
        <div class="modal-actions">
          <button class="modal-button" id="mini-enter">Enter</button>
          <button class="modal-button" id="mini-leave">Leave</button>
        </div>
      </div>`;
    document.body.appendChild(backdrop);
    document.querySelector("#mini-enter").addEventListener("click", function () {
      setup.beginDungeonCheckpoint();
      State.variables.miniDungeonCounter += 1;
      State.variables.dungeon = {
        key: "mini-" + State.variables.miniDungeonCounter,
        name: def.name,
        room: 1,
        rooms: def.rooms,
        returnPassage: "Northern Map",
        bossDefeated: false,
        chestLooted: false,
        mini: true,
        eventDefinition: def
      };
      State.variables.activeMapEvent = null;
      backdrop.remove();
      play("Dungeon Room");
    });
    document.querySelector("#mini-leave").addEventListener("click", function () {
      State.variables.activeMapEvent = null;
      backdrop.remove();
      setup.renderMap();
    });
    return true;
  };

  setup.renderDungeon = function () {
    ensureState();

    var root = document.querySelector("#dungeon-root");
    if (!root) {
      var passage = passageEl();
      if (!passage) return;
      root = document.createElement("div");
      root.id = "dungeon-root";
      passage.appendChild(root);
    }

    var d = State.variables.dungeon;
    if (!d) {
      root.innerHTML = "<p>No active dungeon.</p>";
      return;
    }

    var def = setup.getActiveDungeonDefinition(d);
    var room = getDungeonRoom(d);
    var isBossRoom = d.room >= d.rooms;

    root.innerHTML = "";

    var panel = document.createElement("div");
    panel.className = "dungeon-panel";

    var title = document.createElement("h2");
    title.textContent = def.name;
    panel.appendChild(title);

    var count = document.createElement("p");
    count.textContent = "room " + d.room + " / " + d.rooms;
    panel.appendChild(count);

    var text = document.createElement("p");
    if (isBossRoom) text.textContent = "This is the last room. Whatever claimed this place is waiting inside.";
    else if (room.monster && !room.monsterDefeated) text.textContent = "Something is moving beyond the next patch of dark.";
    else if (room.item && !room.itemTaken) text.textContent = "You find " + setup.items[room.item].name + ".";
    else text.textContent = "Nothing moves when you enter. You take the good news while it lasts.";
    panel.appendChild(text);

    var actions = document.createElement("div");
    actions.className = "choice-grid manual";
    actions.style.display = "grid";
    actions.style.justifyContent = "center";
    actions.style.gap = "12px";
    actions.style.margin = "24px auto";

    if (room.monster && !room.monsterDefeated) {
      var enemy = setup.enemies[room.monster];
      actions.appendChild(makeButton("Fight " + enemy.name, function () {
        setup.startDungeonFight();
      }));
    } else if (isBossRoom) {
      if (!d.chestLooted) {
        actions.appendChild(makeButton("Loot chest", function () {
          setup.lootDungeonChest();
        }));
      } else {
        actions.appendChild(makeButton("Leave", function () {
          setup.finishDungeon();
        }));
      }
    } else {
      if (room.item && !room.itemTaken) {
        actions.appendChild(makeButton("Take item", function () {
          setup.takeDungeonItem();
        }));
      }

      actions.appendChild(makeButton("Go deeper", function () {
        setup.nextDungeonRoom();
      }));

      actions.appendChild(makeButton("Retreat", function () {
        setup.retreatDungeon();
      }));
    }

    panel.appendChild(actions);
    root.appendChild(panel);
  };

  setup.startDungeonFight = function () {
    ensureState();

    var d = State.variables.dungeon;
    if (!d) {
      notify("no active dungeon");
      return;
    }

    var room = getDungeonRoom(d);
    if (!room.monster) {
      notify("nothing to fight");
      return;
    }

    var definition = setup.getActiveDungeonDefinition(d);
    var isBoss = d.room >= d.rooms;
    var hpOverride = isBoss
      ? definition.bossHp
      : definition.enemyHp && definition.enemyHp[room.monster];

    setup.startCombat(room.monster, "Dungeon Room", {
      kind: "dungeon",
      dungeonKey: d.key,
      room: d.room,
      boss: isBoss,
      suppressLoot: Boolean(d.mini && d.room < d.rooms),
      enemyHp: hpOverride
    });
  };

  setup.takeDungeonItem = function () {
    ensureState();

    var d = State.variables.dungeon;
    if (!d) return;

    var room = getDungeonRoom(d);
    if (!room.item || room.itemTaken) return;

    setup.openLootPopup({
      title: "Found",
      flavor: "Dust found it first. You take what the years missed.",
      loot: room.item,
      action: { type: "dungeonItem" }
    });
  };

  setup.nextDungeonRoom = function () {
    ensureState();

    var d = State.variables.dungeon;
    if (!d) {
      notify("no active dungeon");
      return;
    }

    if (d.room < d.rooms) d.room += 1;
    play("Dungeon Room");
  };

  setup.retreatDungeon = function () {
    ensureState();
    var d = State.variables.dungeon;
    if (!d) return false;
    var returnPassage = d.returnPassage;
    State.variables.dungeon = null;
    State.variables.checkpoints.dungeon = null;
    play(returnPassage);
    return true;
  };

  setup.lootDungeonChest = function () {
    ensureState();

    var d = State.variables.dungeon;
    if (!d || d.chestLooted) return;

    if (!d.bossDefeated) {
      notify("the boss is still standing");
      return;
    }

    var def = setup.getActiveDungeonDefinition(d);
    var chestGold = setup.dungeonChestGold(d.key);
    var chestLoot = normalizedLoot(def.chest).reduce(function (all, entry) {
      all[entry.key] = (all[entry.key] || 0) + entry.amount;
      return all;
    }, { gold: chestGold });
    setup.openLootPopup({
      title: "Chest",
      flavor: "The wood is damp. Another winter and the water might have reached what was inside.",
      loot: chestLoot,
      action: { type: "dungeonChest" }
    });
  };

  setup.finishDungeon = function () {
    ensureState();

    var d = State.variables.dungeon;
    if (!d) return;

    if (!d.bossDefeated || !d.chestLooted) {
      notify("finish the room first");
      return;
    }

    if (!d.mini) State.variables.clearedDungeons[d.key] = true;
    if (!d.mini && d.key === "lordsRestGoblinCamp") {
      State.variables.lordsRest.daughterRescued = true;
    }
    var returnPassage = d.returnPassage;
    State.variables.dungeon = null;
    State.variables.checkpoints.dungeon = null;
    play(returnPassage);
  };

  setup.enemyAttackTypes = {
