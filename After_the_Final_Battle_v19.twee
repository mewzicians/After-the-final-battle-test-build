      chargeRequired: 5,
      damageMultiplier: 0.75,
      weight: 1
    },
    medium: {
      key: "medium",
      name: "medium attack",
      chargeRequired: 10,
      damageMultiplier: 1,
      weight: 1
    },
    heavy: {
      key: "heavy",
      name: "heavy attack",
      chargeRequired: 20,
      damageMultiplier: 2,
      weight: 1
    }
  };

