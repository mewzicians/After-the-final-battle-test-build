    demonHerald:       { light: [1.8, 2.3], medium: [2.6, 3.2], heavy: [3.6, 4.3] }
  };
  Object.keys(enemyTimingRanges).forEach(function (key) {
    if (setup.enemies[key]) setup.enemies[key].attackTimings = enemyTimingRanges[key];
  });

  var enemyProgression = {
    wraith: [12, "The wraith stops reaching for a life that ended years ago."],
    starvingWolf: [8, "The wolf goes still. Hunger had already done most of the work."],
    goblinScout: [10, "The scout dies with one hand still pointing back the way it came."],
    orcRaider: [16, "The road is open again. The raider will not be using it."],
    demonHound: [20, "The dark takes the hound back. You do not wait to see if it stays there."],
    academyEcho: [28, "One more old friend put to rest."],
    frostStag: [34, "The stag folds into the snow. The forest keeps whatever thanks it might have offered."],
    frostBear: [45, "The bear settles into the snow, all that anger leaving nothing but an empty shape."],
    goblinArcher: [11, "The bowstring goes quiet. An arrow remains nocked for a shot that will not come."],
    goblinFighter: [13, "The club lands beside the fighter. Neither moves again."],
    goblinSwordsman: [15, "The chipped sword reaches the ground first. Its owner follows soon after."],
    goblinChief: [36, "The chief falls beside the stolen doors he used for a table. The camp has no one left to follow."],
    wanderingDemon: [24, "The demon burns down to a stain the snow refuses to hide."],
    corruptedWolf: [18, "The light beneath the wolf's skin goes out. Whatever was inside it leaves first."],
    banditRaider: [14, "The bandit dies for whatever could be taken from your pockets. You keep walking with it."],
    banditCaptain: [30, "The captain's people are gone. The title does not mean much without them."],
    demonHerald: [48, "The herald comes apart without delivering its message. You can live with not knowing."],
    corruptedGuardian: [38, "The guardian falls, and the corruption loses another place to stand."]
  };
  Object.keys(enemyProgression).forEach(function (key) {
    if (!setup.enemies[key]) return;
    setup.enemies[key].xp = enemyProgression[key][0];
    setup.enemies[key].victoryText = enemyProgression[key][1];
  });

  setup.hasResolvedStatEvent = function (eventId) {
    ensureState();
    return Boolean(eventId && State.variables.storyStatEvents[eventId]);
  };

  setup.grantStoryStatExp = function (eventId, statName, amount, options) {
    ensureState();
    options = options || {};
    var allowed = ["strength", "defense", "resistance", "agility"];
    eventId = String(eventId || "").trim();
    statName = String(statName || "").toLowerCase();
    amount = Math.max(1, Math.floor(Number(amount) || 1));

    if (!eventId || allowed.indexOf(statName) === -1) {
      return { awarded: false, reason: "invalidEventReward" };
    }
    if (State.variables.storyStatEvents[eventId]) {
      return {
        awarded: false,
        reason: "alreadyResolved",
        resolution: clone(State.variables.storyStatEvents[eventId])
      };
    }

    var stat = State.variables.stats[statName];
    var levels = 0;
    if (stat.level < STAT_LEVEL_CAP) {
      stat.exp += amount;
      while (stat.level < STAT_LEVEL_CAP && stat.next > 0 && stat.exp >= stat.next) {
        stat.exp -= stat.next;
        stat.level += 1;
        levels += 1;
        stat.next = statXpNeeded(stat.level);
      }
      if (stat.level >= STAT_LEVEL_CAP) {
        stat.level = STAT_LEVEL_CAP;
        stat.exp = 0;
        stat.next = 0;
      }
    }

    var resolution = {
      stat: statName,
      amount: amount,
      levels: levels,
      finalLevel: stat.level,
      choice: String(options.choice || "")
    };
    State.variables.storyStatEvents[eventId] = clone(resolution);
    if (options.message !== false) {
      setup.notify(options.message || (statName + " gained " + amount + " EXP"));
    }
    return Object.assign({ awarded: true }, resolution);
  };

  function gainPlayerExp(amount) {
    ensureState();
    var player = State.variables.player;
    var levels = 0;
    player.exp += amount;
    while (player.exp >= player.nextExp) {
      player.exp -= player.nextExp;
      player.level += 1;
      levels += 1;
      player.nextExp = 100 + (player.level - 1) * 50;
      player.maxHp += 5;
      player.hp = Math.min(player.maxHp, player.hp + 5);
    }
    return { gained: amount, levels: levels };
  }

  function scaledCooldownMs(baseMs, statName, reductionPerLevel, maximumReduction) {
    var level = clamp(State.variables.stats[statName].level || 1, 1, STAT_LEVEL_CAP);
    var reduction = Math.min(maximumReduction, Math.max(0, level - 1) * reductionPerLevel);
    return baseMs * (1 - reduction);
  }

  function attackCooldownMs() {
    return scaledCooldownMs(
      BASE_ATTACK_COOLDOWN_MS,
      "strength",
      ATTACK_COOLDOWN_REDUCTION_PER_LEVEL,
      MAX_ATTACK_COOLDOWN_REDUCTION
    );
  }

  function dodgeCooldownMs() {
    return scaledCooldownMs(
      BASE_DODGE_COOLDOWN_MS,
      "agility",
      DODGE_COOLDOWN_REDUCTION_PER_LEVEL,
      MAX_DEFENSIVE_COOLDOWN_REDUCTION
    );
  }

  function parryCooldownMs() {
    return scaledCooldownMs(
      BASE_PARRY_COOLDOWN_MS,
      "defense",
      PARRY_COOLDOWN_REDUCTION_PER_LEVEL,
      MAX_DEFENSIVE_COOLDOWN_REDUCTION
    );
  }

  function counterActionFor(attack) {
    if (!attack) return "";
    if (attack.key === "light") return "dodge";
    if (attack.key === "heavy") return "parry";
    return "attack to clash";
  }

  function combatRatio() {
    if (!setup.combat || !setup.combat.currentEnemyDurationMs) return 0;
    return setup.combat.enemyElapsedMs / setup.combat.currentEnemyDurationMs;
  }

  function logCombat(text, tone) {
    var combat = setup.combat;
    if (!combat || !text) return;
    var entry = { text: String(text), tone: tone || "" };
    combat.log.push(entry);
    if (combat.log.length > 120) combat.log.shift();

    var log = document.querySelector("#combat-log");
    if (!log) return;
    var nearBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 32;
    var line = document.createElement("div");
    line.className = "combat-log-entry" + (entry.tone ? " " + entry.tone : "");
    line.textContent = entry.text;
    log.appendChild(line);
    if (nearBottom) log.scrollTop = log.scrollHeight;
  }

  function clearCombatTutorial() {
    var tutorial = document.querySelector("#combat-tutorial");
    if (tutorial) tutorial.remove();
    Array.from(document.querySelectorAll(".combat-tutorial-focus")).forEach(function (element) {
      element.classList.remove("combat-tutorial-focus");
    });
  }

  function startCombatTimer() {
    if (!setup.combat || setup.combat.timer) return;
    setup.combat.timer = setInterval(combatTick, COMBAT_INTERVAL_MS);
  }

  function showCombatTutorial() {
    if (!setup.combat) return false;
    State.variables.combatTutorialSeen = true;
    setup.__combatTutorialShownThisSession = true;

    var steps = [
      { target: "#combat-log", title: "The fight in real time", text: "Telegraphs, counters, damage, and clashes stay in this scrollable battle log. It follows the newest line, but you can scroll back whenever you need." },
      { target: "#enemy-action-wrap", title: "Read the attack", text: "Every enemy rolls a new attack time from its own range. The bar turns gold for the final 20%—that is the counter window." },
      { target: "#combat-dodge", title: "Light attack → Dodge", text: "Dodge during the gold window of a light attack. A well-timed dodge cancels it completely." },
      { target: "#combat-attack", title: "Medium attack → Clash", text: "Attack whenever it is ready. If you attack during a medium attack's gold window, you clash: your hit lands, their attack is canceled, and all later attacks deal +1 damage for this fight." },
      { target: "#combat-parry", title: "Heavy attack → Parry", text: "Parry during the gold window of a heavy attack. Heavy attacks hurt most, so save the slower defensive action for them." },
      { target: "#combat-actions", title: "Your stats shape your rhythm", text: "Strength shortens Attack, Agility shortens Dodge, and Defense shortens Parry. These stats grow through story-event choices, not by repeating actions in combat." }
    ];
    var index = 0;
    var tutorial = document.createElement("div");
    tutorial.id = "combat-tutorial";
    tutorial.innerHTML = `
      <div class="combat-tutorial-shade" data-shade="top"></div>
      <div class="combat-tutorial-shade" data-shade="right"></div>
      <div class="combat-tutorial-shade" data-shade="bottom"></div>
      <div class="combat-tutorial-shade" data-shade="left"></div>
      <div id="combat-tutorial-card" role="dialog" aria-modal="true" aria-label="Combat tutorial">
        <div id="combat-tutorial-title"></div>
        <div id="combat-tutorial-text"></div>
        <div id="combat-tutorial-progress"></div>
        <div id="combat-tutorial-actions">
          <button type="button" id="combat-tutorial-skip">Skip</button>
          <button type="button" id="combat-tutorial-next">Next</button>
        </div>
      </div>`;
    document.body.appendChild(tutorial);
    var activeTarget = null;

    function placeShade(name, left, top, width, height) {
      var shade = tutorial.querySelector('[data-shade="' + name + '"]');
      shade.style.left = Math.max(0, left) + "px";
      shade.style.top = Math.max(0, top) + "px";
      shade.style.width = Math.max(0, width) + "px";
      shade.style.height = Math.max(0, height) + "px";
    }

    function positionShades() {
      if (!activeTarget) {
        placeShade("top", 0, 0, window.innerWidth, window.innerHeight);
        ["right", "bottom", "left"].forEach(function (name) { placeShade(name, 0, 0, 0, 0); });
        return;
      }
      var pad = 8;
      var rect = activeTarget.getBoundingClientRect();
      var holeLeft = Math.max(0, rect.left - pad);
      var holeTop = Math.max(0, rect.top - pad);
      var holeRight = Math.min(window.innerWidth, rect.right + pad);
      var holeBottom = Math.min(window.innerHeight, rect.bottom + pad);
      placeShade("top", 0, 0, window.innerWidth, holeTop);
      placeShade("bottom", 0, holeBottom, window.innerWidth, window.innerHeight - holeBottom);
      placeShade("left", 0, holeTop, holeLeft, holeBottom - holeTop);
      placeShade("right", holeRight, holeTop, window.innerWidth - holeRight, holeBottom - holeTop);

      var card = document.querySelector("#combat-tutorial-card");
      if (card) {
        if (rect.bottom > window.innerHeight * 0.62) {
          card.style.top = "18px";
          card.style.bottom = "auto";
        } else {
          card.style.top = "auto";
          card.style.bottom = "max(24px, env(safe-area-inset-bottom))";
        }
      }
    }
    window.addEventListener("resize", positionShades);

    function finish() {
      window.removeEventListener("resize", positionShades);
      clearCombatTutorial();
      logCombat("The fight begins.", "counter");
      startCombatTimer();
    }

    function renderStep() {
      Array.from(document.querySelectorAll(".combat-tutorial-focus")).forEach(function (element) {
        element.classList.remove("combat-tutorial-focus");
      });
      var step = steps[index];
      var target = document.querySelector(step.target);
      if (target) target.classList.add("combat-tutorial-focus");
      activeTarget = target;
      document.querySelector("#combat-tutorial-title").textContent = step.title;
      document.querySelector("#combat-tutorial-text").textContent = step.text;
      document.querySelector("#combat-tutorial-progress").textContent = (index + 1) + " / " + steps.length;
      document.querySelector("#combat-tutorial-next").textContent = index === steps.length - 1 ? "Begin" : "Next";
      positionShades();
    }

    document.querySelector("#combat-tutorial-skip").addEventListener("click", finish);
    document.querySelector("#combat-tutorial-next").addEventListener("click", function () {
      if (index >= steps.length - 1) finish();
      else {
        index += 1;
        renderStep();
      }
    });
    renderStep();
    return true;
  }

  function endCombat() {
    if (!setup.combat) return;
    clearInterval(setup.combat.timer);
    clearCombatTutorial();
    setup.combat = null;
    setup.updateInterfaceAvailability();

    var overlay = document.querySelector("#combat-overlay");
    if (overlay) overlay.remove();
  }

  function currentDungeonRoom() {
    var d = State.variables.dungeon;
    if (!d || !State.variables.dungeonRooms) return null;
    return State.variables.dungeonRooms[d.key + ":" + d.room] || null;
  }

  function markDungeonWin(context, spared) {
    if (!context || context.kind !== "dungeon") return;

    var d = State.variables.dungeon;
    var room = currentDungeonRoom();
    if (room) room.monsterDefeated = true;
    if (d && context.boss) {
      d.bossDefeated = true;
      if (d.mini) d.chestLooted = true;
    }

    if (
      spared &&
      context.boss &&
      context.dungeonKey === "lordsRestGoblinCamp" &&
      State.variables.inventory.goblinChiefSpear < 1
    ) {
      setup.takeItem("goblinChiefSpear", { message: "the chief gives up his spear" });
    }
  }

  function winCombat() {
    var combat = setup.combat;
    if (!combat) return;

    var playerProgress = gainPlayerExp(combat.enemy.xp || 10);
    var loot = combat.context && combat.context.suppressLoot ? {} : combat.enemy.loot;
    if (normalizedLoot(loot).length) setup.receiveLoot(loot, { message: false });
    markDungeonWin(combat.context, false);

    var result = {
      enemyName: combat.enemy.name,
      victoryText: combat.enemy.victoryText || "It is over. You are still here.",
      playerProgress: playerProgress,
      performance: {
        attacks: combat.attacksMade,
        clashes: combat.clashesThisFight,
        dodges: combat.successfulDodges,
        parries: combat.parriesThisFight,
        hitsTaken: combat.hitsTaken,
        damageDealt: combat.damageDealt,
        damageTaken: combat.damageTaken,
        finalClashBonus: combat.clashBonus
      },
      loot: clone(loot),
      returnPassage: combat.returnPassage
    };
    endCombat();
    setup.openAfterBattle(result);
  }

  function progressBarHtml(label, level, exp, next, gained, tooltip) {
    var width = next > 0 ? clamp(exp / next * 100, 0, 100) : 0;
    return '<button type="button" class="reward-stat-row" data-stat-detail="' + escapeHtml(tooltip) + '">' +
      '<span class="reward-stat-label">' + escapeHtml(label) + '<small>Lv. ' + level + "</small></span>" +
      '<span class="reward-exp-wrap"><span class="reward-exp-fill" style="width:' + width + '%"></span></span>' +
      '<span class="reward-stat-gain">+' + Math.max(0, gained || 0) + "</span></button>";
  }

  function performanceRowHtml(label, value) {
    return '<div class="combat-summary-row"><span>' + escapeHtml(label) + '</span><strong>' +
      escapeHtml(value) + '</strong></div>';
  }

  setup.wireModalPages = function (backdrop) {
    if (!backdrop) return false;
    var pages = Array.from(backdrop.querySelectorAll(".modal-page"));
    var previous = backdrop.querySelector("[data-modal-previous]");
    var next = backdrop.querySelector("[data-modal-next]");
    var label = backdrop.querySelector(".modal-page-label");
    if (pages.length < 2 || !previous || !next || !label) return false;
    var index = 0;
    function show(pageIndex) {
      index = clamp(Number(pageIndex) || 0, 0, pages.length - 1);
      pages.forEach(function (page, candidateIndex) {
        var active = candidateIndex === index;
        page.classList.toggle("active", active);
        page.setAttribute("aria-hidden", active ? "false" : "true");
      });
      previous.disabled = index === 0;
      next.disabled = index === pages.length - 1;
      label.textContent = "Page " + (index + 1) + " of " + pages.length;
    }
    previous.addEventListener("click", function () { show(index - 1); });
    next.addEventListener("click", function () { show(index + 1); });
    backdrop.__showModalPage = show;
    show(0);
    return true;
  };

  setup.openAfterBattle = function (result) {
    ensureState();
    State.variables.pendingReward = { kind: "afterBattle", result: clone(result) };
    var old = document.querySelector("#reward-modal");
    if (old) old.remove();
    var player = State.variables.player;
    var backdrop = document.createElement("div");
    backdrop.id = "reward-modal";
    backdrop.className = "modal-backdrop";
    backdrop.innerHTML = `
      <div class="modal-box reward-box after-battle-box" role="dialog" aria-modal="true" aria-label="After battle">
        <div class="modal-title">After Battle</div>
        <div class="modal-page-stack">
          <section class="modal-page active" aria-label="Battle progress">
            <div class="reward-flavor">${escapeHtml(result.victoryText)}</div>
            <div class="reward-player-exp">Player EXP gained: +${result.playerProgress.gained}</div>
            <div class="reward-stats">
              ${progressBarHtml("Player", player.level, player.exp, player.nextExp, result.playerProgress.gained, "Victories raise Player Level. Each Player Level grants 5 maximum Health.")}
            </div>
            <div class="reward-detail reward-stat-detail" aria-live="polite">Player Level raises maximum Health. Strength, Agility, Defense, and Resistance grow only through story-event choices.</div>
          </section>
          <section class="modal-page" aria-label="Fight summary">
            <div class="reward-section-title">Fight summary</div>
            <div class="combat-summary-grid">
              ${performanceRowHtml("Damage dealt", result.performance.damageDealt)}
              ${performanceRowHtml("Damage taken", result.performance.damageTaken)}
              ${performanceRowHtml("Attacks", result.performance.attacks)}
              ${performanceRowHtml("Clashes", result.performance.clashes)}
              ${performanceRowHtml("Light attacks dodged", result.performance.dodges)}
              ${performanceRowHtml("Heavy attacks parried", result.performance.parries)}
              ${performanceRowHtml("Enemy hits", result.performance.hitsTaken)}
              ${performanceRowHtml("Final Clash bonus", "+" + result.performance.finalClashBonus)}
            </div>
          </section>
          <section class="modal-page" aria-label="Battle loot">
            <div class="reward-section-title">Loot gained</div>
            <div class="reward-loot-list">${normalizedLoot(result.loot).length ? lootRowsHtml(result.loot) : '<div class="reward-empty">Nothing this time.</div>'}</div>
            <div class="reward-detail reward-loot-detail" aria-live="polite">Hover over or tap loot to inspect it.</div>
            <div class="modal-actions"><button class="modal-button" id="reward-ok">OK</button></div>
          </section>
        </div>
        <div class="modal-page-nav" aria-label="After battle pages">
          <button type="button" data-modal-previous>\u2190 Previous</button>
          <div class="modal-page-label" aria-live="polite"></div>
          <button type="button" data-modal-next>Next \u2192</button>
        </div>
      </div>
    `;
    document.body.appendChild(backdrop);
    setup.wireModalPages(backdrop);
    Array.from(backdrop.querySelectorAll(".reward-stat-row")).forEach(function (row) {
      var show = function () {
        var detail = backdrop.querySelector(".reward-stat-detail");
        if (detail) detail.textContent = row.getAttribute("data-stat-detail");
      };
      row.addEventListener("mouseenter", show);
      row.addEventListener("focus", show);
      row.addEventListener("click", show);
    });
    wireLootDetails(backdrop, result.loot, ".reward-loot-detail");
    document.querySelector("#reward-ok").addEventListener("click", function () {
      var pending = State.variables.pendingReward;
      if (!pending || pending.kind !== "afterBattle") return;
      var returnPassage = pending.result.returnPassage;
      State.variables.pendingReward = null;
      backdrop.remove();
      play(returnPassage);
    });
    return true;
  };

  function canMercy() {
    var combat = setup.combat;
    if (!combat) return false;
    return combat.enemy.hp <= combat.enemy.maxHp * 0.1 || combat.parriesThisFight >= 10;
  }

  function mercyCombat() {
    var combat = setup.combat;
    if (!combat || !canMercy()) return;

    State.variables.hiddenStats.kindness += 1;
    markDungeonWin(combat.context, true);

    var returnPassage = combat.returnPassage;
    endCombat();
    play(returnPassage);
  }

  function loseCombat() {
    var combat = setup.combat;
    if (!combat) return;

    var checkpointType =
      combat.context && combat.context.kind === "dungeon"
        ? "dungeon"
        : "expedition";
    setup.requestDefeat(checkpointType);
  }

  function getDefaultEnemyAttacks() {
    return [
      setup.enemyAttackTypes.light,
      setup.enemyAttackTypes.medium,
      setup.enemyAttackTypes.heavy
    ];
  }

  function getEnemyAttackPool(enemy) {
    var pool = getDefaultEnemyAttacks().slice();

    /*
      Future special abilities may be added to an enemy as:
      specialAbilities: [{
        key: "abilityKey",
        name: "ability name",
        chargeRequired: 12,
        damageMultiplier: 1.25,
        weight: 1,
        telegraph: "custom warning text"
      }]
    */
    if (Array.isArray(enemy.specialAbilities)) {
      enemy.specialAbilities.forEach(function (ability) {
        if (
          ability &&
          typeof ability.chargeRequired === "number" &&
          typeof ability.damageMultiplier === "number"
        ) {
          pool.push(ability);
        }
      });
    }

    return pool;
  }

  function weightedChoice(options) {
    var total = options.reduce(function (sum, option) {
      return sum + Math.max(0, Number(option.weight) || 1);
    }, 0);

    var roll = Math.random() * total;
    for (var i = 0; i < options.length; i += 1) {
      roll -= Math.max(0, Number(options[i].weight) || 1);
      if (roll <= 0) return options[i];
    }

    return options[options.length - 1];
  }

  function rolledAttackDuration(enemy, attack) {
    var fallback = {
      light: [3.0, 3.8],
      medium: [4.0, 5.0],
      heavy: [5.5, 6.5]
    };
    var timings = enemy.attackTimings || fallback;
    var range = timings[attack.key] || timings.medium || fallback.medium;
    var min = Math.max(0.8, Number(range[0]) || fallback.medium[0]);
    var max = Math.max(min, Number(range[1]) || min);
    return Math.round((min + Math.random() * (max - min)) * 1000);
  }

  function prepareEnemyAttack(attack) {
    var combat = setup.combat;
    if (!combat) return;
    combat.currentEnemyAttack = attack;
    combat.currentEnemyDurationMs = rolledAttackDuration(combat.enemy, attack);
    combat.enemyElapsedMs = 0;
    combat.enemyCharge = 0;
    combat.telegraphStage = 0;
    logCombat(
      combat.enemy.name + " begins a " + attack.name + ". " +
      counterActionFor(attack).toUpperCase() + " during the gold window.",
      ""
    );
  }

  function chooseNextEnemyAttack() {
    if (!setup.combat) return;
    prepareEnemyAttack(weightedChoice(getEnemyAttackPool(setup.combat.enemy)));
  }

  function getCurrentEnemyAttack() {
    if (!setup.combat || !setup.combat.currentEnemyAttack) {
      return setup.enemyAttackTypes.medium;
    }
    return setup.combat.currentEnemyAttack;
  }

  function attackTelegraph(enemy, attack, ratio) {
    if (attack.telegraph) return attack.telegraph;

    if (attack.key === "light") {
      if (ratio >= COUNTER_WINDOW_RATIO) return enemy.name + " is about to make a quick attack.";
      if (ratio >= 0.4) return enemy.name + " shifts forward.";
      return enemy.name + " prepares a light attack.";
    }

    if (attack.key === "heavy") {
      if (ratio >= COUNTER_WINDOW_RATIO) return enemy.name + " is about to unleash a heavy attack.";
      if (ratio >= 0.4) return enemy.name + " gathers its strength.";
      return enemy.name + " begins preparing a heavy attack.";
    }

    if (ratio >= COUNTER_WINDOW_RATIO) return enemy.descriptions.high;
    if (ratio >= 0.4) return enemy.descriptions.mid;
    return enemy.descriptions.low;
  }

  function calculateEnemyDamage(enemy, attack) {
    return Math.max(1, Math.round(enemy.attackDamage * attack.damageMultiplier));
  }

  function resolveEnemyAttack() {
    var combat = setup.combat;
    if (!combat) return;

    var enemy = combat.enemy;
    var player = State.variables.player;
    var attack = getCurrentEnemyAttack();

    var resistance =
      (State.variables.armor.resistance || 0) +
      Math.floor(Math.max(0, State.variables.stats.resistance.level - 1) / 3);
    var finalDamage = Math.max(1, calculateEnemyDamage(enemy, attack) - resistance);
    player.hp -= finalDamage;
    combat.hitsTaken += 1;
    combat.damageTaken += finalDamage;

    logCombat(
      enemy.descriptions.hit + " The " + attack.name + " deals " + finalDamage + " damage.",
      "danger"
    );

    chooseNextEnemyAttack();

    if (player.hp <= 0) {
      player.hp = 0;
      renderCombat();
      loseCombat();
      return;
    }

    renderCombat();
  }

  function combatTick() {
    var combat = setup.combat;
    if (!combat) return;

    var attack = getCurrentEnemyAttack();

    combat.enemyElapsedMs += COMBAT_INTERVAL_MS;
    combat.enemyCharge = PLAYER_ACTION_CHARGE * combatRatio();
    combat.cooldowns.attack = Math.min(
      PLAYER_ACTION_CHARGE,
      combat.cooldowns.attack + PLAYER_ACTION_CHARGE * COMBAT_INTERVAL_MS / attackCooldownMs()
    );
    combat.cooldowns.parry = Math.min(
      PLAYER_ACTION_CHARGE,
      combat.cooldowns.parry + PLAYER_ACTION_CHARGE * COMBAT_INTERVAL_MS / parryCooldownMs()
    );
    combat.cooldowns.dodge = Math.min(
      PLAYER_ACTION_CHARGE,
      combat.cooldowns.dodge + PLAYER_ACTION_CHARGE * COMBAT_INTERVAL_MS / dodgeCooldownMs()
    );

    var enemyRatio = combatRatio();
    var stage = enemyRatio >= COUNTER_WINDOW_RATIO ? 2 : (enemyRatio >= 0.4 ? 1 : 0);
    if (stage > combat.telegraphStage) {
      combat.telegraphStage = stage;
      if (stage === 2) {
        logCombat(
          "COUNTER WINDOW: " + attack.name.toUpperCase() + " — " + counterActionFor(attack).toUpperCase() + " NOW.",
          "counter"
        );
      } else {
        logCombat(attackTelegraph(combat.enemy, attack, enemyRatio));
      }
    }

    if (combat.enemyElapsedMs >= combat.currentEnemyDurationMs) {
      logCombat(combat.enemy.name + " uses a " + attack.name + ".", "danger");
      resolveEnemyAttack();
    }

    renderCombat();
  }

  function useAttack() {
    var combat = setup.combat;
    if (!combat || combat.cooldowns.attack < PLAYER_ACTION_CHARGE) return;

    var attack = getCurrentEnemyAttack();
    var clash = attack.key === "medium" && combatRatio() >= COUNTER_WINDOW_RATIO;
    var damage = (State.variables.weapon.baseDamage || 2) +
      State.variables.stats.strength.level - 1 + combat.clashBonus;
    var actualDamage = Math.min(damage, combat.enemy.hp);

    combat.cooldowns.attack = 0;
    combat.enemy.hp -= actualDamage;
    combat.attacksMade += 1;
    combat.damageDealt += actualDamage;
    if (clash) {
      combat.clashBonus += 1;
      combat.clashesThisFight += 1;
      logCombat(
        "CLASH. Your strike deals " + actualDamage + " damage, cancels the medium attack, and raises your damage by 1 for this fight.",
        "clash"
      );
    } else {
      logCombat("You strike with the " + State.variables.weapon.name + " for " + actualDamage + " damage.", "success");
    }

    if (combat.enemy.hp <= 0) {
      combat.enemy.hp = 0;
      renderCombat();
      winCombat();
      return;
    }

    if (clash) chooseNextEnemyAttack();

    renderCombat();
  }

  function useParry() {
    var combat = setup.combat;
    if (!combat || combat.cooldowns.parry < PLAYER_ACTION_CHARGE) return;

    var attack = getCurrentEnemyAttack();
    var enemyRatio = combatRatio();
    combat.cooldowns.parry = 0;

    if (attack.key === "heavy" && enemyRatio >= COUNTER_WINDOW_RATIO) {
      combat.parriesThisFight += 1;
      logCombat(combat.enemy.descriptions.parried + " You stop the heavy attack.", "success");
      chooseNextEnemyAttack();
    } else if (attack.key !== "heavy") {
      logCombat("Parry cannot answer a " + attack.name + ".", "danger");
    } else {
      logCombat("You parry too early. Wait for the gold window.", "danger");
    }

    renderCombat();
  }

  function useDodge() {
    var combat = setup.combat;
    if (!combat || combat.cooldowns.dodge < PLAYER_ACTION_CHARGE) return;

    var attack = getCurrentEnemyAttack();
    var enemyRatio = combatRatio();
    combat.cooldowns.dodge = 0;
    if (attack.key === "light" && enemyRatio >= COUNTER_WINDOW_RATIO) {
      combat.successfulDodges += 1;
      logCombat(combat.enemy.descriptions.dodged + " You avoid the light attack.", "success");
      chooseNextEnemyAttack();
    } else if (attack.key !== "light") {
      logCombat("Dodge cannot answer a " + attack.name + ".", "danger");
    } else {
      logCombat("You dodge too early. Wait for the gold window.", "danger");
    }
    renderCombat();
  }

  function setActionButtonState(selector, currentCharge, cooldownMs) {
    var button = document.querySelector(selector);
    if (!button) return;

    button.disabled = currentCharge < PLAYER_ACTION_CHARGE;
    var small = button.querySelector(".combat-small");
    if (small) {
      var remaining = Math.max(0, (1 - currentCharge / PLAYER_ACTION_CHARGE) * cooldownMs / 1000);
      small.textContent = remaining > 0.05 ? remaining.toFixed(1) + "s" : "ready";
    }
  }

  function renderCombat() {
    var combat = setup.combat;
    if (!combat) return;

    var enemy = combat.enemy;
    var player = State.variables.player;
    var attack = getCurrentEnemyAttack();

    var playerHp = document.querySelector("#combat-player-hp");
    var enemyHp = document.querySelector("#combat-enemy-hp");
    var enemyFill = document.querySelector("#enemy-action-fill");
    var enemyAttackName = document.querySelector("#enemy-attack-name");
    var enemyAttackCharge = document.querySelector("#enemy-attack-charge");

    if (playerHp) playerHp.textContent = player.hp + " / " + player.maxHp;
    if (enemyHp) enemyHp.textContent = enemy.hp + " / " + enemy.maxHp;
    if (enemyAttackName) enemyAttackName.textContent = attack.name;
    if (enemyAttackCharge) {
      var remainingSeconds = Math.max(0, combat.currentEnemyDurationMs - combat.enemyElapsedMs) / 1000;
      enemyAttackCharge.textContent = remainingSeconds.toFixed(1) + "s · " + counterActionFor(attack);
    }
    if (enemyFill) {
      enemyFill.style.width = Math.min(100, combatRatio() * 100) + "%";
    }
    var actionWrap = document.querySelector("#enemy-action-wrap");
    if (actionWrap) actionWrap.classList.toggle("counter-window", combatRatio() >= COUNTER_WINDOW_RATIO);

    setActionButtonState("#combat-attack", combat.cooldowns.attack, attackCooldownMs());
    setActionButtonState("#combat-parry", combat.cooldowns.parry, parryCooldownMs());
    setActionButtonState("#combat-dodge", combat.cooldowns.dodge, dodgeCooldownMs());

    var mercyButton = document.querySelector("#combat-mercy");
    if (mercyButton) mercyButton.style.display = canMercy() ? "block" : "none";
  }

  setup.startCombat = function (enemyKey, returnPassage, context) {
    ensureState();

    var enemyTemplate = setup.enemies[enemyKey];
    if (!enemyTemplate) {
      notify("missing enemy: " + enemyKey);
      return false;
    }

    if (setup.combat) endCombat();

    var enemy = clone(enemyTemplate);
    if (context && Number.isFinite(context.enemyHp) && context.enemyHp > 0) {
      enemy.hp = Math.floor(context.enemyHp);
    }
    enemy.maxHp = enemy.hp;

    setup.combat = {
      enemyKey: enemyKey,
      enemy: enemy,
      returnPassage: returnPassage || State.passage,
      context: context || null,
      /* The first enemy action is always medium; its exact duration is still rolled per enemy. */
      currentEnemyAttack: setup.enemyAttackTypes.medium,
      currentEnemyDurationMs: 0,
      enemyElapsedMs: 0,
      enemyCharge: 0,
      telegraphStage: 0,
      parriesThisFight: 0,
      successfulDodges: 0,
      clashesThisFight: 0,
      clashBonus: 0,
      attacksMade: 0,
      hitsTaken: 0,
      damageDealt: 0,
      damageTaken: 0,
      log: [],
      cooldowns: {
        attack: PLAYER_ACTION_CHARGE,
        parry: PLAYER_ACTION_CHARGE,
        dodge: PLAYER_ACTION_CHARGE
      },
      timer: null
    };
    setup.updateInterfaceAvailability();

    var old = document.querySelector("#combat-overlay");
    if (old) old.remove();

    var overlay = document.createElement("div");
    overlay.id = "combat-overlay";
    overlay.innerHTML = `
      <div id="combat-panel">
        <div id="combat-enemy-name">${escapeHtml(enemy.name)}</div>
        <div id="combat-log" role="log" aria-live="polite" aria-label="Battle text"></div>
        <div id="combat-fighters">
          <div class="combat-fighter">
            <div class="combat-symbol">@</div>
            <div id="combat-player-hp" class="combat-hp"></div>
          </div>
          <div class="combat-fighter">
            <div class="combat-symbol">${escapeHtml(enemy.symbol)}</div>
            <div id="combat-enemy-hp" class="combat-hp"></div>
            <div id="enemy-attack-name"></div>
            <div id="enemy-action-wrap">
              <div id="enemy-action-bar"><div id="enemy-action-fill"></div></div>
              <div id="enemy-attack-charge"></div>
            </div>
          </div>
        </div>
        <div id="combat-actions">
          <button type="button" id="combat-attack" class="combat-action">attack<span class="combat-small"></span></button>
          <button type="button" id="combat-parry" class="combat-action">parry<span class="combat-small"></span></button>
          <button type="button" id="combat-dodge" class="combat-action">dodge<span class="combat-small"></span></button>
          <button type="button" id="combat-mercy" class="combat-action">mercy<span class="combat-small">spare</span></button>
        </div>
      </div>
    `;

    document.body.appendChild(overlay);

    document.querySelector("#combat-attack").addEventListener("click", useAttack);
    document.querySelector("#combat-parry").addEventListener("click", useParry);
    document.querySelector("#combat-dodge").addEventListener("click", useDodge);
    document.querySelector("#combat-mercy").addEventListener("click", mercyCombat);

    logCombat(enemy.descriptions.idle);
    prepareEnemyAttack(setup.enemyAttackTypes.medium);
    renderCombat();
    if (!State.variables.combatTutorialSeen && !setup.__combatTutorialShownThisSession) {
      setTimeout(showCombatTutorial, 0);
    } else {
      startCombatTimer();
    }
    return true;
  };

  setup.verifyFastCombat = function () {
    var attacks = setup.enemyAttackTypes;
    var enemyKeys = Object.keys(setup.enemies || {});
    var enemiesValid = enemyKeys.every(function (key) {
      var enemy = setup.enemies[key];
      var timings = enemy.attackTimings;
      return (
        typeof enemy.attackDamage === "number" &&
        enemy.descriptions &&
        enemy.loot &&
        timings &&
        ["light", "medium", "heavy"].every(function (attackKey) {
          var range = timings[attackKey];
          return Array.isArray(range) && range.length === 2 &&
            Number(range[0]) > 0 && Number(range[1]) >= Number(range[0]);
        })
      );
    });

    return {
      ok: (
        PLAYER_ACTION_CHARGE === 10 &&
        BASE_ATTACK_COOLDOWN_MS === 3000 &&
        BASE_DODGE_COOLDOWN_MS === 3000 &&
        BASE_PARRY_COOLDOWN_MS === 4000 &&
        STAT_LEVEL_CAP === 10 &&
        statXpNeeded(1) === 3 &&
        statXpNeeded(9) === 19 &&
        statXpNeeded(10) === 0 &&
        COUNTER_WINDOW_RATIO === 0.8 &&
        attacks.light.damageMultiplier === 0.75 &&
        attacks.medium.damageMultiplier === 1 &&
        attacks.heavy.damageMultiplier === 2 &&
        enemiesValid
      ),
      playerActionCharge: PLAYER_ACTION_CHARGE,
      baseCooldownsMs: { attack: 3000, dodge: 3000, parry: 4000 },
      cooldownScaling: {
        attack: { stat: "strength", reductionPerLevel: ATTACK_COOLDOWN_REDUCTION_PER_LEVEL, maximumReduction: MAX_ATTACK_COOLDOWN_REDUCTION },
        dodge: { stat: "agility", reductionPerLevel: DODGE_COOLDOWN_REDUCTION_PER_LEVEL, maximumReduction: MAX_DEFENSIVE_COOLDOWN_REDUCTION },
        parry: { stat: "defense", reductionPerLevel: PARRY_COOLDOWN_REDUCTION_PER_LEVEL, maximumReduction: MAX_DEFENSIVE_COOLDOWN_REDUCTION }
      },
      storyStatProgression: { cap: STAT_LEVEL_CAP, xpCurve: [3, 5, 7, 9, 11, 13, 15, 17, 19] },
      counterWindowRatio: COUNTER_WINDOW_RATIO,
      counters: { light: "dodge", medium: "attack/clash", heavy: "parry" },
      firstEnemyAttack: "medium",
      enemyAttacks: clone(attacks),
      enemiesValidated: enemyKeys.length,
      supportsSpecialAbilities: true
    };
  };

  setup.renderPlace = function (key) {
    ensureState();

    var root = document.querySelector("#place-root");
    if (!root) {
      var passage = passageEl();
      if (!passage) return;
      root = document.createElement("div");
      root.id = "place-root";
      passage.appendChild(root);
    }

    var place = getPlace(key);
    State.variables.currentPlaceKey = place.code;

    root.innerHTML = "";

    var panel = document.createElement("div");
    panel.className = "place-panel";

    var title = document.createElement("h2");
    title.textContent = place.name;
    panel.appendChild(title);

    var text = document.createElement("p");
    text.textContent = place.name + " is still marked on the map. You have learned not to mistake that for good news.";
    panel.appendChild(text);

    var actions = document.createElement("div");
    actions.className = "choice-grid manual";
    actions.style.display = "grid";
    actions.style.justifyContent = "center";
    actions.style.gap = "12px";

    if (State.variables.clearedDungeons[place.dungeon]) {
      var cleared = document.createElement("p");
      cleared.textContent = "The danger here is gone. Going back in would only disturb the dust.";
      panel.appendChild(cleared);
    } else {
      actions.appendChild(makeButton("Enter dungeon", function () {
        setup.openDungeonWarning(place.dungeon, place.passage);
      }));
    }

    actions.appendChild(makeButton("Exit to map", function () {
      setup.enterMap(place.code);
    }));

    panel.appendChild(actions);
    root.appendChild(panel);
  };


  setup.verifyBuildOnce = function () {
    var required = [
      "enterMap", "enterPlace", "enterCurrentPlace", "moveMap", "renderMap",
      "startMapEvent", "rollMapEvent", "takeItem", "take", "receiveLoot", "grantLoot",
      "spendGold", "toggleInventory", "closeInventory", "selectInventoryItem", "useInventoryItem",
      "consumeSupply", "equipInventoryItem", "showInventoryTab", "showEquipmentPage", "renderEquipmentSlots", "renderCharacterStats",
      "beginExpedition", "beginDungeonCheckpoint", "requestDefeat", "resolveDefeat",
      "checkLowResources", "saveGame", "continueGame", "newGame",
      "enterDungeon", "renderDungeon", "startDungeonFight", "takeDungeonItem",
      "nextDungeonRoom", "retreatDungeon", "lootDungeonChest", "finishDungeon", "dungeonChestGold",
      "startCombat", "openDungeonWarning", "openMiniDungeon", "notify", "updateInventory",
      "getPreferences", "savePreferences", "cycleTextSpeed", "toggleInstantText", "toggleSettings", "openLootPopup", "openAfterBattle", "wireModalPages",
      "openTraderEvent", "openTraderWindow", "openGeneratedSettlement", "renderGeneratedSettlement",
      "searchLoot", "startPassageTypewriter", "grantStoryStatExp", "hasResolvedStatEvent",
      "fitCurrentPage", "scheduleViewportLayout", "installViewportLayout", "auditInterfaceLayout",
      "verifyFastCombat"
    ];

    var missing = required.filter(function (name) {
      return typeof setup[name] !== "function";
    });

    var missingDungeonData = Object.keys(setup.places).filter(function (code) {
      return !setup.dungeons[setup.places[code].dungeon];
    });

    var invalidDungeonReferences = [];
    Object.keys(setup.dungeons).forEach(function (dungeonKey) {
      var dungeon = setup.dungeons[dungeonKey];
      dungeon.enemies.concat([dungeon.boss]).forEach(function (enemyKey) {
        if (!setup.enemies[enemyKey]) invalidDungeonReferences.push(dungeonKey + " -> enemy:" + enemyKey);
      });
      dungeon.items.concat(dungeon.chest).forEach(function (itemKey) {
        if (!setup.items[itemKey]) invalidDungeonReferences.push(dungeonKey + " -> item:" + itemKey);
      });
    });

    var invalidEnemyGold = Object.keys(setup.enemies).filter(function (enemyKey) {
      return !setup.enemies[enemyKey].loot || setup.enemies[enemyKey].loot.gold < 1;
    });

    var invalidDungeonDifficulty = Object.keys(setup.dungeons).filter(function (dungeonKey) {
      var difficulty = setup.dungeons[dungeonKey].difficulty;
      return !Number.isInteger(difficulty) || difficulty < 1 || difficulty > 5;
    });

    var invalidTowns = ["A", "G", "O"].filter(function (placeKey) {
      var place = setup.places[placeKey];
      return !placeHasModifier(place, "Town") || !place.respawnPassage;
    });

    var combat = setup.verifyFastCombat();

    return {
      ok: (
        missing.length === 0 &&
        missingDungeonData.length === 0 &&
        invalidDungeonReferences.length === 0 &&
        invalidEnemyGold.length === 0 &&
        invalidDungeonDifficulty.length === 0 &&
        invalidTowns.length === 0 &&
        !setup.dungeons.lordsRest &&
        combat.ok
      ),
      missingFunctions: missing,
      missingDungeonData: missingDungeonData,
      invalidDungeonReferences: invalidDungeonReferences,
      invalidEnemyGold: invalidEnemyGold,
      invalidDungeonDifficulty: invalidDungeonDifficulty,
      invalidTowns: invalidTowns,
      placeCount: Object.keys(setup.places).length,
      dungeonCount: Object.keys(setup.dungeons).length,
      enemyCount: Object.keys(setup.enemies).length,
      itemCount: Object.keys(setup.items).length,
      build: setup.__afterFinalBattleBuild,
      combat: combat,
      checklist: {
        canonicalSetupObject: "All public functions are attached directly to SugarCube's setup object.",
        universalCityEnterExit: "setup.enterPlace(key) enters; setup.enterMap(key) exits to the map at that location key.",
        universalItemPickup: "setup.takeItem(itemKey, options)",
        universalLoot: "setup.receiveLoot(loot, options)",
        mapMovement: "setup.moveMap(dx, dy)",
        mapDirections: "North=(0,-1), East=(1,0), South=(0,1), West=(-1,0)",
        dungeonFight: "setup.startDungeonFight() uses the current room's monster from that dungeon's enemy stock.",
        dungeonRules: "Permanent dungeons keep 1/4 monster and item rolls; regional mini dungeons fill every room and award loot only from the boss.",
        dungeonGold: "Every guaranteed chest gives five gold per dungeon difficulty level.",
        monsterGold: "Every defeated enemy gives at least one gold; Mercy gives no loot.",
        towns: "Stalwart, Lord's Rest, and Outpost 3 carry the Town modifier and define a respawn passage.",
        defeat: "Defeat is acknowledged before the relevant checkpoint restores, including its saved Health, and the player returns to the last Town.",
        checkpoints: "Expeditions snapshot on Town exit; dungeons snapshot immediately before initialization.",
        inventory: "Inventory and Equipment tabs scroll, retain supplies and gear, support Use and Equip, and keep the Old Sword locked.",
        supplies: "Food, water, and salvage pickups remain individual items until consumed for their resource value.",
        survival: "Food or water at zero causes expedition failure; Health regenerates once every four overworld steps.",
        saving: "One browser-local manual save slot is available beside Inventory; Welcome offers Continue and New Game; Settings persist separately.",
        mapEvents: "1/4 chance when cooldown is zero; events are region-scoped Combat, Trader, Settlement, or ambient encounters with a five-tile cooldown.",
        miniDungeons: "Bandit Camp 3, Goblin Cave 5, Corrupted Site 4, and Wandering Demon Horde 7 encounters.",
        rewards: "City and dungeon searches use Take; victories use OK with Player EXP, a combat performance summary, unique enemy text, and inspectable loot.",
        progression: "Victories raise Player Level and Health. Strength, Agility, Defense, and Resistance cap at 10 and gain EXP only from one-time story-event choices.",
        statCurve: "Story stat levels cost 3, 5, 7, 9, 11, 13, 15, 17, and 19 EXP.",
        typewriter: "Story and dialogue type at 1x, 2x, or 4x from a 400 WPM base; speed scales sentence pauses, hold doubles the current speed, double-click reveals all, and the persistent Instant toggle bypasses typing. UI remains instant.",
        generatedSettlements: "Northern ruined and budding settlements generate region-locked area scenes and never become checkpoints.",
        resourceDrain: "Water -1 per 20 moved tiles; food -1 per 40 moved tiles.",
        combatKeys: "Attack, Dodge, Parry, Mercy",
        combatTiming: "Strength independently shortens Attack, Agility shortens Dodge, and Defense shortens Parry. Enemy attacks roll per-enemy durations; counters open at 80%.",
        combatCounters: "Light=Dodge; Medium=timed Attack Clash; Heavy=Parry. Each Clash cancels the enemy attack and adds +1 player damage for the current fight.",
        combatTutorial: "The first combat pauses for a six-step spotlight tutorial; combat output persists in a live scrollable log.",
        combatDamage: "Enemy light .75x, medium 1x, heavy 2x base attackDamage."
      }
    };
  };

  setup.verifyBuildThreeTimes = function () {
    return {
      firstCheck: setup.verifyBuildOnce(),
      secondCheck: setup.verifyBuildOnce(),
      thirdCheck: setup.verifyBuildOnce()
    };
  };

  function directChildWithClass(parent, className) {
    return Array.from(parent.children || []).find(function (child) {
      return child.classList && child.classList.contains(className);
    }) || null;
  }

  function resetViewportPagination(passage) {
    var host = passage && passage.querySelector('[data-viewport-page-host="true"]');
    if (!host && passage && passage.getAttribute && passage.getAttribute("data-viewport-page-host") === "true") host = passage;
    if (!host) {
      setup.__viewportPager = null;
      return null;
    }
    var stage = directChildWithClass(host, "viewport-page-stage");
    var nav = directChildWithClass(host, "viewport-page-nav");
    var fragment = document.createDocumentFragment();
    if (stage) {
      Array.from(stage.children).forEach(function (page) {
        while (page.firstChild) fragment.appendChild(page.firstChild);
      });
      stage.remove();
    }
    if (nav) nav.remove();
    host.appendChild(fragment);
    host.classList.remove("viewport-page-host");
    host.removeAttribute("data-viewport-page-host");
    host.style.height = "";
    setup.__viewportPager = null;
    return host;
  }

  setup.showViewportPage = function (index) {
    var pager = setup.__viewportPager;
    if (!pager || !pager.pages.length) return false;
    pager.index = clamp(Number(index) || 0, 0, pager.pages.length - 1);
    pager.pages.forEach(function (page, pageIndex) {
      var active = pageIndex === pager.index;
      page.hidden = !active;
      page.setAttribute("aria-hidden", active ? "false" : "true");
    });
    pager.previous.disabled = pager.index === 0;
    pager.next.disabled = pager.index === pager.pages.length - 1;
    pager.label.textContent = "Page " + (pager.index + 1) + " of " + pager.pages.length;
    return true;
  };

  setup.showViewportPageForElement = function (element) {
    var pager = setup.__viewportPager;
    if (!pager || !element || !element.closest) return false;
    var page = element.closest(".viewport-content-page");
    var index = pager.pages.indexOf(page);
    return index >= 0 ? setup.showViewportPage(index) : false;
  };

  function paginateViewportHost(host, availableHeight) {
    var units = Array.from(host.childNodes).filter(function (node) {
      return node.nodeType !== 3 || Boolean(node.nodeValue.trim());
    });
    if (units.length < 2) return false;

    setup.__viewportIgnoreUntil = Date.now() + 80;
    host.innerHTML = "";
    host.classList.add("viewport-page-host");
    host.setAttribute("data-viewport-page-host", "true");
    host.style.height = Math.max(220, Math.floor(availableHeight)) + "px";

    var stage = document.createElement("div");
    stage.className = "viewport-page-stage";
    var pageHeight = Math.max(170, Math.floor(availableHeight) - 52);
    stage.style.height = pageHeight + "px";
    host.appendChild(stage);

    var pages = [];
    function addPage() {
      var page = document.createElement("section");
      page.className = "viewport-content-page";
      page.style.height = pageHeight + "px";
      page.setAttribute("aria-label", "Story page");
      stage.appendChild(page);
      pages.push(page);
      return page;
    }

    var current = addPage();
    units.forEach(function (unit) {
      current.appendChild(unit);
      if (current.scrollHeight > pageHeight + 1 && current.childNodes.length > 1) {
        current.removeChild(unit);
        current = addPage();
        current.appendChild(unit);
      }
    });

    if (pages.length < 2) {
      var fragment = document.createDocumentFragment();
      while (pages[0].firstChild) fragment.appendChild(pages[0].firstChild);
      stage.remove();
      host.appendChild(fragment);
      host.classList.remove("viewport-page-host");
      host.removeAttribute("data-viewport-page-host");
      host.style.height = "";
      return false;
    }

    var nav = document.createElement("div");
    nav.className = "viewport-page-nav";
    nav.setAttribute("aria-label", "Story page navigation");
    var previous = makeButton("\u2190 Previous", function () { setup.showViewportPage(setup.__viewportPager.index - 1); });
    var label = document.createElement("div");
    label.className = "viewport-page-label";
    var next = makeButton("Next \u2192", function () { setup.showViewportPage(setup.__viewportPager.index + 1); });
    nav.appendChild(previous);
    nav.appendChild(label);
    nav.appendChild(next);
    host.appendChild(nav);
    setup.__viewportPager = { host: host, pages: pages, index: 0, previous: previous, next: next, label: label };
    setup.showViewportPage(0);
    return true;
  }

  function viewportHostForPassage(passage) {
    return passage.querySelector(".world-shell") ||
      passage.querySelector(".place-panel") ||
      passage.querySelector(".dungeon-panel") ||
      passage;
  }

  function viewportOverflows(host, container) {
    return host.scrollHeight > container.clientHeight + 1 || host.scrollWidth > container.clientWidth + 1;
  }

  function layoutRectsOverlap(first, second) {
    if (!first || !second) return false;
    var a = first.getBoundingClientRect();
    var b = second.getBoundingClientRect();
    return a.width > 0 && a.height > 0 && b.width > 0 && b.height > 0 &&
      a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
  }

  setup.auditInterfaceLayout = function () {
    var body = document.body;
    var passages = document.querySelector("#passages");
    var bottom = document.querySelector("#bottom-controls");
    var speed = document.querySelector("#text-speed-controls");
    var notifications = document.querySelector("#notification-log");
    if (!body || !passages) return { ok: true, overlaps: [], pageOverflow: false, paginated: false };

    var wasStacked = body.classList.contains("viewport-stack-controls");
    body.classList.remove("viewport-stack-controls");
    var shouldStack = layoutRectsOverlap(bottom, speed);
    body.classList.toggle("viewport-stack-controls", shouldStack);

    var overlaps = [];
    if (layoutRectsOverlap(bottom, speed)) overlaps.push("bottom-controls/text-speed-controls");
    if (layoutRectsOverlap(passages, bottom)) overlaps.push("page/bottom-controls");
    if (layoutRectsOverlap(passages, speed)) overlaps.push("page/text-speed-controls");
    if (notifications && notifications.children.length && layoutRectsOverlap(passages, notifications)) overlaps.push("page/notifications");

    var passage = passageEl();
    var host = passage ? viewportHostForPassage(passage) : null;
    var pageOverflow = Boolean(host && !passage.querySelector("#map-wrap") && viewportOverflows(host, passages));
    var result = {
      ok: overlaps.length === 0 && !pageOverflow,
      overlaps: overlaps,
      pageOverflow: pageOverflow,
      paginated: Boolean(passage && passage.querySelector('[data-viewport-page-host="true"]')),
      controlsStacked: shouldStack
    };
    body.setAttribute("data-layout-audit", result.ok ? "pass" : "needs-attention");
    body.setAttribute("data-layout-overlaps", overlaps.join(","));
    setup.__lastLayoutAudit = result;
    if (wasStacked !== shouldStack && !setup.__layoutAuditAdjusting) {
      setup.__layoutAuditAdjusting = true;
      setTimeout(function () {
        setup.__layoutAuditAdjusting = false;
        setup.scheduleViewportLayout(0);
      }, 0);
    }
    return result;
  };

  setup.fitCurrentPage = function () {
    var passage = passageEl();
    var passages = document.querySelector("#passages");
    document.body.classList.remove("viewport-compact", "viewport-tight");
    if (!passage || !passages || State.passage === "Welcome" || setup.combat) {
      if (typeof setup.auditInterfaceLayout === "function") setup.auditInterfaceLayout();
      return false;
    }

    resetViewportPagination(passage);
    var host = viewportHostForPassage(passage);
    var availableHeight = passages.clientHeight;
    if (!host || availableHeight < 180) {
      setup.auditInterfaceLayout();
      return false;
    }

    if (!viewportOverflows(host, passages)) {
      setup.auditInterfaceLayout();
      return true;
    }
    document.body.classList.add("viewport-compact");
    if (!viewportOverflows(host, passages)) {
      setup.auditInterfaceLayout();
      return true;
    }
    document.body.classList.add("viewport-tight");
    if (!viewportOverflows(host, passages)) {
      setup.auditInterfaceLayout();
      return true;
    }

    if (passage.querySelector("#map-wrap")) {
      setup.auditInterfaceLayout();
      return false;
    }
    var paginated = paginateViewportHost(host, availableHeight);
    setup.auditInterfaceLayout();
    return paginated;
  };

  setup.scheduleViewportLayout = function (delay) {
    if (setup.__viewportLayoutTimer) clearTimeout(setup.__viewportLayoutTimer);
    setup.__viewportLayoutTimer = setTimeout(function () {
      setup.__viewportLayoutTimer = null;
      setup.fitCurrentPage();
    }, Math.max(0, Number(delay) || 0));
  };

  setup.installViewportLayout = function () {
    if (setup.__viewportLayoutInstalled) return;
    setup.__viewportLayoutInstalled = true;
    var passages = document.querySelector("#passages");
    if (passages && typeof MutationObserver !== "undefined") {
      setup.__viewportObserver = new MutationObserver(function (mutations) {
        if (Date.now() < (setup.__viewportIgnoreUntil || 0)) return;
        var changed = mutations.some(function (mutation) {
          return mutation.type === "childList" && (mutation.addedNodes.length || mutation.removedNodes.length);
        });
        if (changed) setup.scheduleViewportLayout(20);
      });
      setup.__viewportObserver.observe(passages, { childList: true, subtree: true });
    }
    var refit = function () {
      cancelTextTyper(true);
      setup.scheduleViewportLayout(0);
    };
    window.addEventListener("resize", refit);
    if (window.visualViewport) window.visualViewport.addEventListener("resize", refit);
  };

  function reducedMotionRequested() {
    return typeof window !== "undefined" &&
      typeof window.matchMedia === "function" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function cancelTextTyper(finish) {
    var typer = setup.textTyper;
    if (!typer) return;
    if (typer.timer) clearTimeout(typer.timer);
    if (finish && typeof typer.finish === "function") typer.finish();
    setup.textTyper = null;
  }

  function sentenceEndsAt(text, index) {
    var current = text.charAt(index);
    var previous = text.charAt(index - 1);
    var next = text.charAt(index + 1);
    var punctuation = /[.!?]/;
    var closingMark = /["'”’)\]]/;

    if (punctuation.test(current)) {
      if (current === "." && /\d/.test(previous) && /\d/.test(next)) return false;
      if (punctuation.test(next) || closingMark.test(next)) return false;
      return true;
    }

    if (closingMark.test(current) && punctuation.test(previous)) {
      return !closingMark.test(next);
    }

    return false;
  }

  function narrativeTypingDelay(selectedMultiplier, held, text, revealedIndex) {
    var speedMultiplier = selectedMultiplier * (held ? 2 : 1);
    var delay = 60000 / (BASE_TEXT_WPM * 5) / speedMultiplier;
    var revealed = text.charAt(revealedIndex);
    if (sentenceEndsAt(text, revealedIndex)) {
      delay += SENTENCE_PAUSE_MS / speedMultiplier;
    } else if (/[,;:]/.test(revealed)) {
      delay *= 1.5;
    }
    return delay;
  }

  setup.typeDynamicNarrative = function (element) {
    if (!element || !document.createTreeWalker || reducedMotionRequested() || setup.getPreferences().instantText) {
      cancelTextTyper(true);
      return false;
    }
    cancelTextTyper(true);
    var fullText = element.textContent;
    if (!fullText.trim()) return false;
    element.textContent = "";
    var cursor = 0;
    var held = false;
    var finished = false;
    var typer = {
      timer: null,
      finish: function () {
        if (finished) return;
        finished = true;
        element.textContent = fullText;
      }
    };
    setup.textTyper = typer;
    function tick() {
      if (finished || setup.textTyper !== typer) return;
      cursor += 1;
      element.textContent = fullText.slice(0, cursor);
      var speedMultiplier = setup.getPreferences().textSpeed;
      var delay = narrativeTypingDelay(speedMultiplier, held, fullText, cursor - 1);
      if (cursor >= fullText.length) {
        typer.timer = setTimeout(function () {
          typer.finish();
          setup.textTyper = null;
        }, delay);
        return;
      }
      typer.timer = setTimeout(tick, delay);
    }
    element.addEventListener("pointerdown", function (event) {
      if (!event.target.closest("button,a,input,select,textarea")) held = true;
    });
    element.addEventListener("pointerup", function () { held = false; });
    element.addEventListener("pointercancel", function () { held = false; });
    element.addEventListener("dblclick", function () {
      typer.finish();
      setup.textTyper = null;
    });
    tick();
    return true;
  };

  setup.startPassageTypewriter = function () {
    var passage = passageEl();
    if (
      !passage ||
      !document.createTreeWalker ||
      reducedMotionRequested() ||
      setup.getPreferences().instantText ||
      ["Welcome", "Northern Map", "Dungeon Room"].indexOf(State.passage) !== -1
    ) {
      cancelTextTyper(true);
      return false;
    }
    cancelTextTyper(true);
    var choice = passage.querySelector(".choice-grid");
    if (choice) choice.style.visibility = "hidden";
    var walker = document.createTreeWalker(
      passage,
      typeof NodeFilter !== "undefined" ? NodeFilter.SHOW_TEXT : 4,
      {
        acceptNode: function (node) {
          var parent = node.parentElement;
          if (!node.nodeValue.trim()) return typeof NodeFilter !== "undefined" ? NodeFilter.FILTER_REJECT : 2;
          if (
            parent &&
            parent.closest("a,button,input,select,textarea,script,style,.choice-grid,.viewport-page-nav,#place-root,#map-root,#dungeon-root")
          ) {
            return typeof NodeFilter !== "undefined" ? NodeFilter.FILTER_REJECT : 2;
          }
          return typeof NodeFilter !== "undefined" ? NodeFilter.FILTER_ACCEPT : 1;
        }
      }
    );
    var nodes = [];
    var node;
    while ((node = walker.nextNode())) {
      nodes.push({ node: node, text: node.nodeValue });
    }
    if (!nodes.length) {
      if (choice) choice.style.visibility = "";
      return false;
    }
    nodes.forEach(function (entry) { entry.node.nodeValue = ""; });
    var nodeIndex = 0;
    var charIndex = 0;
    var held = false;
    var finished = false;
    var typer = {
      timer: null,
      finish: function () {
        if (finished) return;
        finished = true;
        nodes.forEach(function (entry) { entry.node.nodeValue = entry.text; });
        if (choice) choice.style.visibility = "";
        if (choice) setup.showViewportPageForElement(choice);
        else if (nodes.length) setup.showViewportPageForElement(nodes[nodes.length - 1].node.parentElement);
      }
    };
    setup.textTyper = typer;
    function tick() {
      if (finished || setup.textTyper !== typer) return;
      var entry = nodes[nodeIndex];
      setup.showViewportPageForElement(entry.node.parentElement);
      charIndex += 1;
      entry.node.nodeValue = entry.text.slice(0, charIndex);
      var revealedIndex = charIndex - 1;
      var speedMultiplier = setup.getPreferences().textSpeed;
      var delay = narrativeTypingDelay(speedMultiplier, held, entry.text, revealedIndex);
      if (charIndex >= entry.text.length) {
        nodeIndex += 1;
        charIndex = 0;
      }
      if (nodeIndex >= nodes.length) {
        typer.timer = setTimeout(function () {
          typer.finish();
          setup.textTyper = null;
        }, delay);
        return;
      }
      typer.timer = setTimeout(tick, delay);
    }
    passage.addEventListener("pointerdown", function (event) {
      if (!event.target.closest("button,a,input,select,textarea")) held = true;
    });
    passage.addEventListener("pointerup", function () { held = false; });
    passage.addEventListener("pointercancel", function () { held = false; });
    passage.addEventListener("dblclick", function (event) {
      if (!event.target.closest("button,a,input,select,textarea")) {
        typer.finish();
        setup.textTyper = null;
      }
    });
    tick();
    return true;
  };

  $(document).on(":storyready", function () {
    ensureState();
    createInterface();
    setup.installViewportLayout();
    setup.updateInventory();
    setup.updateInterfaceAvailability();
    setup.scheduleViewportLayout(0);
  });

  $(document).on(":passagedisplay", function () {
    ensureState();
    createInterface();
    setup.updateInventory();
    setup.updateInterfaceAvailability();
    setup.layoutChoices();
    patchKnownTakeLinks();

    if (State.passage === "Northern Map") {
      setTimeout(function () {
        setup.renderMap();
      }, 0);
    }

    if (State.passage === "Dungeon Room") {
      setTimeout(function () {
        setup.renderDungeon();
      }, 0);
    }

    setTimeout(function () {
      setup.fitCurrentPage();
    }, 4);

    setTimeout(function () {
      setup.startPassageTypewriter();
    }, 10);
  });


  /* Connected world locations, journal, and ending. */
var worldRegionMeta = {
    north: {
      name: "Northern Region",
      question: "If care does not guarantee rescue, was choosing it still worthwhile?",
      words: "plain, practical, intimate",
      enemy: "academyEcho",
      color: "winter"
    },
    central: {
      name: "Central Kingdom",
      question: "When does order protect people, and when does it protect itself?",
      words: "formal, ranked, procedural",
      enemy: "oathboundRemnant",
      color: "iron"
    },
    holy: {
      name: "Holy Forest",
      question: "If the gods are dead, have mortals made their values their own?",
      words: "ritual, image, interpretation",
      enemy: "demonifiedPilgrim",
      color: "green"
    },
    desert: {
      name: "Desert Wastes",
      question: "Who decides that a life, apprenticeship, promise, or journey is complete?",
      words: "motion, craft, bargain, weather",
      enemy: "glassJackal",
      color: "ochre"
    },
    demon: {
      name: "Demon Realm",
      question: "Can a system built for continuity choose correction?",
      words: "measure, probability, function",
      enemy: "continuityDrone",
      color: "violet"
    },
    outer: {
      name: "Outer Final Battle Zone",
      question: "Can a narrow objective be necessary without making every attached cost sacred?",
      words: "orders, formations, names",
      enemy: "battlefieldEcho",
      color: "ash"
    },
    inner: {
      name: "Inner Final Battle Zone",
      question: "What remains of duty when command, certainty, and witnesses fall away?",
      words: "fragments, pressure, private truth",
      enemy: "demandScar",
      color: "black"
    },
    final: {
      name: "Final Battle Site",
      question: "Can the brothers stop mistaking endless battle for love?",
      words: "memory, grief, choice",
      enemy: "stolenEmotion",
      color: "moonless"
    }
  };

  function worldSite(code, name, region, x, y, kind, purpose, ordinary, evidenceTitle, evidenceText, voice, choiceA, choiceB, item) {
    return {
      code: code,
      name: name,
      region: region,
      coord: [x, y],
      kind: kind || "ruin",
      purpose: purpose,
      ordinary: ordinary,
      evidence: {
        title: evidenceTitle,
        text: evidenceText,
        voice: voice,
        boundary: "This maker knew their own work and immediate circumstances, not the whole war."
      },
      choices: [choiceA, choiceB],
      item: item,
      enemy: worldRegionMeta[region].enemy
    };
  }

  function worldChoice(label, stat, result) {
    return { label: label, stat: stat, result: result };
  }

  var worldSiteList = [
    worldSite("A", "Stalwart", "north", 5, 3, "town",
      "A nameless town survived because a frightened child refused every ending except his family's survival. The city grew around that refusal and later built the first Academy of Heroes.",
      "Smoke leaks from patched roofs. Two neighbors argue over an oven door while someone measures the dry corner with a length of string.",
      "Mera Quill's Route Book",
      "The inside cover is signed Mera Quill. Four settlement names are circled. Beneath them: POSSIBLY ALIVE IS NOT THE SAME AS REACHED.",
      "Curious Seeker — clipped courier shorthand, hopeful only in the margins",
      worldChoice("Carry Mera's unfinished route", "resistance", "You accept a task whose success cannot be promised."),
      worldChoice("Copy the routes before committing", "agility", "You turn uncertainty into several roads instead of one command."),
      "Courier's Brass Map Pin"),
    worldSite("B", "Byron's Estate", "north", 6, 7, "ruin",
      "A refugee estate opened its stable yards, grain vaults, kitchens, and family rooms, but sealed one seed vault for a spring that never came.",
      "Children counted horses in the margins of ration sheets. Someone kept correcting a black mare's name from Asset Nine to Pepper.",
      "Seed Vault Division",
      "House Byron released almost every store. The last seed was held back not from greed alone, but because eating it would make tomorrow mathematically impossible.",
      "Practical Caretaker — exact household ledger, tenderness hidden in corrections",
      worldChoice("Divide the seed among living towns", "defense", "You protect several fragile chances at the cost of certainty."),
      worldChoice("Entrust the seed to one proven grower", "resistance", "You accept concentration, accountability, and the possibility of blame."),
      "Byron Spring Seed"),
    worldSite("C", "Forest of Silence", "north", 11, 4, "ruin",
      "A managed woodland went quiet in stages. Animals stopped answering the old Askers before people admitted that magic itself was failing.",
      "Ranger cabins contain carved bird names, boot pegs at child height, and bowls left beneath nesting boxes long after the birds stopped coming.",
      "Listening Post Nine",
      "No response to the third asking. The birds looked at Ilwen as they always had; the world simply did not carry her request to them.",
      "Guarded Watcher — short observations, no claim beyond sight and sound",
      worldChoice("Repair the listening frame without magic", "strength", "Wood, wire, and patience make a smaller answer possible."),
      worldChoice("Leave food at every silent nesting box", "defense", "Care continues even without proof that it will be received."),
      "Silent Ranger Bell"),
    worldSite("D", "Respite", "north", 12, 9, "ruin",
      "An inn town made ordinary travel bearable through beds, baths, scams, shared meals, and stories improved with each telling.",
      "Room Six charged extra for a window facing a brick wall. Three separate guests wrote that the wall was beautiful because it did not move.",
      "The Guest Ledger",
      "Names later carved at the Academy appear first beside complaints about wet boots, snoring, and a missing blue scarf. Legends were inconvenient people before history edited them.",
      "Opportunistic Broker — charming annotations, prices adjusted to the listener",
      worldChoice("Restore the communal stove", "strength", "The old inn offers warmth again without needing to become important."),
      worldChoice("Copy every ordinary name", "resistance", "You refuse to preserve only those who later became famous."),
      "Respite Guest Token"),
    worldSite("E", "Frontier", "north", 18, 6, "ruin",
      "Watch families and road crews lived beside a boundary that moved whenever officials needed danger to remain somebody else's problem.",
      "A chalk height chart climbs one guardhouse wall. The final mark belongs to a child who had already been moved across three different frontiers.",
      "Revised Boundary Order",
      "Move the line west by six miles. Existing households are to be redesignated as temporary personnel. No relocation is required because, on paper, nobody lives there.",
      "Exacting Keeper — official language, precision used to hide a human cost",
      worldChoice("Repair the bridge for travel", "strength", "The route becomes slower to strip and easier to share."),
      worldChoice("Dismantle it for nearby roofs", "agility", "You sacrifice distance for immediate shelter and record that cost honestly."),
      "Frontier Bridge Pin"),
    worldSite("F", "Forest of Whispers", "north", 22, 3, "ruin",
      "The pine wind repeats scraps stolen from travelers. Familiar words lead toward traps; cadence and patient attention reveal the old ranger waymarks.",
      "One voice sounds like the Hero until it uses the childhood phrase backward. Your brother always said moon before morning, never morning before moon.",
      "Waymarker's Rule",
      "Do not follow a voice because you miss its owner. Count breaths. Count echoes. A true companion changes when you answer; a stolen voice only repeats.",
      "Guarded Watcher — spare survival rule, grief kept outside the sentence",
      worldChoice("Answer the false voice and test it", "resistance", "You face the shape of memory without granting it authority."),
      worldChoice("Follow cadence, not content", "agility", "You let observation correct longing."),
      "Whisper Waymarker"),
    worldSite("G", "Lord's Rest", "north", 22, 9, "town",
      "A living settlement grew among noble crypts, wells, markets, and grave plots. Its walls can preserve a community or slowly turn it into a guarded tomb.",
      "Fresh flour dust lies across an ancestor's epitaph. The miller apologizes to the stone and keeps working.",
      "Gate Council Minutes",
      "We can remain pure, hungry, and buried beside excellent ancestors. Or we can open the south field and learn our new neighbor's name.",
      "Patient Mediator — objections preserved beside every decision",
      worldChoice("Open the farmland to outsiders", "defense", "Lord's Rest chooses risk in order to remain a living place."),
      worldChoice("Reopen trade before settlement", "agility", "The gate opens by degrees, with terms that can be revised."),
      "Lord's Rest Field Key"),
    worldSite("H", "Safety", "north", 28, 4, "ruin",
      "An evacuation ward once held family rooms, schools, stores, an infirmary, and a watchhouse. Older plans saved thousands; the final overcrowded intake exceeded them.",
      "Blankets are labeled by room, not owner, because they were meant to pass to whoever arrived coldest next.",
      "Intake Revision Twelve",
      "Capacity is not a promise. Preparation still matters. Record the missing without converting them into proof that every earlier rescue was meaningless.",
      "Enduring Realist — unsentimental instructions with stubborn regard for people",
      worldChoice("Rebuild the intake shelves", "strength", "Preparation becomes useful again without pretending it guarantees rescue."),
      worldChoice("Mark both saved and missing", "resistance", "You keep failure from erasing what the ward once accomplished."),
      "Safety Intake Tag"),
    worldSite("I", "Crossroads", "north", 29, 8, "ruin",
      "A tollhouse, courier stable, shrines, and repair yard made three roads depend upon one another. Mera's older route marks remain under newer ash.",
      "Couriers scratched jokes into the south stall: every road is shortest when somebody else has to walk it.",
      "Mera's Earlier Mark",
      "NORTH PASSABLE. EAST UNCERTAIN. SOUTH HAS PEOPLE, WHICH IS A KIND OF WEATHER. Bring two axles next time.",
      "Curious Seeker — field shorthand, practical humor, no knowledge beyond traveled roads",
      worldChoice("Repair the road toward Outpost Three", "strength", "A living settlement receives the first material."),
